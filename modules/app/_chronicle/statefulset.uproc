// StatefulSet as params: ordered, stable-identity Pods. The ReplicaSet chain
// with two differences, both gates:
//   up:   create ordinal i only when i-1 exists AND is ready (0 is ungated)
//   down: delete a surplus ordinal only when i+1 is absent — "my successor
//         is gone" is how a per-record decision knows it is the highest, so
//         teardown proceeds highest-first without a budget
// Stage 1 asks about the NEIGHBOUR that gates this ordinal: the predecessor
// when in range, the successor when not.
module nanocloud.statefulset {

  // The context each chain here carries across its effects: ONE nested
  // message in the reserved carry field (254), echoed unchanged by every
  // connector. Never the template: carried here a real one overflowed the
  // decisions' 512 B scratch. The writer SPLICES it from the stored
  // StatefulSet (`src`).
  // carried by: st.NbQ, st.NbA, st.Probe, st.Answer
  message Ctx {
    key: string = 30;
    src: string = 31;     // the StatefulSet's key tail, the splice source
    in: string = 32;
    ns: string = 34;
    name: string = 35;
    gate: string = 38;
    ouid: string = 36;    // the StatefulSet's metadata.uid: its Pods' controller reference
    pod: string = 39;
  }

  message st.Ord {
    seq: int = 1;
    rev: int = 2;
    key: string = 3;      // "<ns>/<name>"
    replicas: string = 4; // spec.replicas as text; empty = not projectable
    uid: string = 5;      // metadata.uid, the Pods' controller reference
    succkey: string = 19; // "<ns>/<name>-<i+1>"
    ord: int = 20;
    ordstr: string = 21;
    want: int = 22;
    prevstr: string = 23; // empty at 0
    selfkey: string = 24; // "<ns>/<name>-<i>"
    prevkey: string = 25; // "<ns>/<name>-<i-1>"
    pod: string = 26;     // "<name>-<i>"
    ns: string = 28;
    name: string = 29;
  }
  message st.NbQ {
    cid: int = 1;
    op: int = 2;
    key: string = 3;
// "1" in range, "" surplus
    ctx: Ctx = 254;
  }
  message st.NbA {
    cid: int = 1;
    status: int = 2;
    value: string = 3;
    ready: string = 40;   // the neighbour's Ready condition: True|False
    ctx: Ctx = 254;
  }
  message st.Probe {
    cid: int = 1;
    op: int = 2;
    key: string = 3;
// "1" when the neighbour permits acting
    ctx: Ctx = 254;
  }
  message st.Answer {
    cid: int = 1;
    status: int = 2;
    value: string = 3;
    ctx: Ctx = 254;
  }
  message st.Act {
    cid: int = 1;
    op: int = 2;
    key: string = 3;
    p1: string = 4;   p2: string = 5;   p3: string = 6;
    p4: string = 7;   p5: string = 8;   p6: string = 9;
    p7: string = 10;  p8: string = 11;  p9: string = 12;
    p10: string = 13; p11: string = 14; p12: string = 15;
    p13: string = 16; p14: string = 80;
    src: string = 70;    // splice source: the StatefulSet's key tail
    splice: string = 71; // what is spliced from it, and where
  }

  enum NOOP = 0;
  enum GET = 1;
  enum PUT = 3;
  enum DELETE = 4;

  // Stage 1: which neighbour gates me? In range: the predecessor (none at
  // 0, so NOOP and let 204 mean "ungated"). Surplus: the successor.
  decision neighbour(o: st.Ord) -> st.NbQ {
    when o.replicas == "" ->
      st.NbQ { cid: o.seq, op: NOOP, key: "", ctx: Ctx { key: "", src: "", in: "", ns: o.ns, name: o.name, pod: o.pod, ouid: o.uid } };
    when o.ord < o.want && o.prevstr == "" ->
      st.NbQ { cid: o.seq, op: NOOP, key: "", ctx: Ctx { key: o.selfkey, src: o.key, in: "1", ns: o.ns, name: o.name, pod: o.pod, ouid: o.uid } };
    when o.ord < o.want ->
      st.NbQ { cid: o.seq, op: GET, key: o.prevkey, ctx: Ctx { key: o.selfkey, src: o.key, in: "1", ns: o.ns, name: o.name, pod: o.pod, ouid: o.uid } };
    default ->
      st.NbQ { cid: o.seq, op: GET, key: o.succkey, ctx: Ctx { key: o.selfkey, src: o.key, in: "", ns: o.ns, name: o.name, pod: o.pod, ouid: o.uid } };
  }

  // Stage 2: the gate. In range: ungated at 0 (204) or predecessor ready.
  // Surplus: successor absent (404). A missing key (the non-projectable
  // Deployment) probes nothing.
  decision probe(a: st.NbA) -> st.Probe {
    when a.ctx.key == "" ->
      st.Probe { cid: a.cid, op: NOOP, key: "", ctx: Ctx { key: "", src: "", in: "", ns: a.ctx.ns, name: a.ctx.name, gate: "", pod: a.ctx.pod, ouid: a.ctx.ouid } };
    when a.ctx.in == "1" && a.status == 204 ->
      st.Probe { cid: a.cid, op: GET, key: a.ctx.key, ctx: Ctx { key: a.ctx.key, src: a.ctx.src, in: "1", ns: a.ctx.ns, name: a.ctx.name, gate: "1", pod: a.ctx.pod, ouid: a.ctx.ouid } };
    when a.ctx.in == "1" && a.status == 200 && a.ready == "True" ->
      st.Probe { cid: a.cid, op: GET, key: a.ctx.key, ctx: Ctx { key: a.ctx.key, src: a.ctx.src, in: "1", ns: a.ctx.ns, name: a.ctx.name, gate: "1", pod: a.ctx.pod, ouid: a.ctx.ouid } };
    when a.ctx.in == "" && a.status == 404 ->
      st.Probe { cid: a.cid, op: GET, key: a.ctx.key, ctx: Ctx { key: a.ctx.key, src: a.ctx.src, in: "", ns: a.ctx.ns, name: a.ctx.name, gate: "1", pod: a.ctx.pod, ouid: a.ctx.ouid } };
    default ->
      st.Probe { cid: a.cid, op: GET, key: a.ctx.key, ctx: Ctx { key: a.ctx.key, src: a.ctx.src, in: a.ctx.in, ns: a.ctx.ns, name: a.ctx.name, gate: "", pod: a.ctx.pod, ouid: a.ctx.ouid } };
  }

  // Stage 3: act, gated.
  // Stage 3: act, gated. A Pod is labelled as its template says, beside
  // its stable name (statefulset.kubernetes.io/pod-name), and carries the
  // template's annotations; labels, annotations and spec are SPLICED from
  // the stored StatefulSet.
  decision converge(a: st.Answer) -> st.Act {
    when a.ctx.in == "1" && a.status == 404 && a.ctx.gate == "1" ->
      st.Act { cid: a.cid, op: PUT, key: a.ctx.key,
               p1: "{\"apiVersion\":\"v1\",\"kind\":\"Pod\",\"metadata\":{\"name\":\"",
               p2: a.ctx.pod,
               p3: "\",\"namespace\":\"",
               p4: a.ctx.ns,
               p5: "\",\"ownerReferences\":[{\"apiVersion\":\"apps/v1\",\"kind\":\"StatefulSet\",\"name\":\"",
               p6: a.ctx.name,
               p7: "\",\"uid\":\"",
               p8: a.ctx.ouid,
               p9: "\",\"controller\":true,\"blockOwnerDeletion\":true}],\"labels\":{\"statefulset.kubernetes.io/pod-name\":\"",
               p10: a.ctx.pod,
               p11: "\"",
               p12: "},\"annotations\":{",
               p13: "}},\"spec\":",
               p14: ",\"status\":{\"phase\":\"Pending\"}}",
               src: a.ctx.src,
               splice: "/statefulsets.apps/|15=,spec.template.metadata.labels.*;16=spec.template.metadata.annotations.*;80=spec.template.spec" };
    when a.ctx.in == "" && a.status == 200 && a.ctx.gate == "1" ->
      st.Act { cid: a.cid, op: DELETE, key: a.ctx.key };
    default ->
      st.Act { cid: a.cid, op: NOOP, key: "" };
  }

  transformation pass_ord(o: st.Ord) -> st.Ord {
    st.Ord { seq: o.seq, rev: o.rev, key: o.key, replicas: o.replicas, uid: o.uid,
             succkey: o.succkey, ord: o.ord, ordstr: o.ordstr, want: o.want,
             prevstr: o.prevstr, selfkey: o.selfkey, prevkey: o.prevkey, pod: o.pod,
             ns: o.ns, name: o.name }
  }
  transformation pass_nb(a: st.NbA) -> st.NbA {
    st.NbA { cid: a.cid, status: a.status, value: a.value, ready: a.ready, ctx: a.ctx }
  }
  transformation pass_ans(a: st.Answer) -> st.Answer {
    st.Answer { cid: a.cid, status: a.status, value: a.value, ctx: a.ctx }
  }
  pipeline nb(o: st.Ord) -> st.NbQ {
    call x = pass_ord(o);
    call y = neighbour(x);
    return y;
  }
  pipeline ask(a: st.NbA) -> st.Probe {
    call x = pass_nb(a);
    call y = probe(x);
    return y;
  }
  pipeline act(a: st.Answer) -> st.Act {
    call x = pass_ans(a);
    call y = converge(x);
    return y;
  }
  entry nb = nb;
  entry ask = ask;
  entry act = act;
  provenance revision "statefulset-neighbour" toolchain "chronicle-authoring";
}
