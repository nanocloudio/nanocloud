// Address allocation as params: pod IPs.
// (The two pools share this design; ipam_svc.uproc and ipam_pod.uproc are
// split only because one module holds at most 16 decisions and 8 entries.)
//
// One shape for both pools. An address is CLAIMED by creating the key
// `/ipam/<pool>/<address as u32>` under the store's ABSENT precondition, so two
// allocators that pick the same candidate cannot both win: the store answers
// the loser 409 at one linearization point. A per-pool cursor
// (`/ipam-cursor/<pool>` = `n=…[;net=…;span=…]`) makes the pick next-fit —
// candidate = net + 1 + (n mod span) — and every attempt, won or lost,
// advances it. There is no "lowest free" search and nothing seeded per
// address: a taken candidate costs one 409 and one bump.
//
//   allocate  the FIRST owner still waiting (count index 0) -> GET cursor ->
//             CREATE claim -> commit the address to the owner -> bump cursor
//   backfill  every address already in use is claimed, and the LAST record of
//             that scan (or the one record `empty` sends for an empty set)
//             creates the cursor. Allocation reads the cursor first, so it
//             cannot start until every existing address holds its claim.
//   release   a claim whose owner is gone, or whose owner now holds a
//             different address, is deleted.
//
// Services commit by PATCHing spec.clusterIP (the Service is its own lease).
// Pods commit by CREATING /ipam-lease/<id> — create-only, so a lease is never
// reassigned, and a request is "waiting" while it has none (`unless`).
module nanocloud.ipam_pod_release {

  // The context each chain here carries across its effects: ONE nested
  // message in the reserved carry field (254), echoed unchanged by every
  // connector. Inner numbers are the old carry-through numbers, so every
  // module that hands a context on agrees on it.
  // carried by: OwnerGet, OwnerReply, ReqCall, ReqReply
  message Ctx {
    claim: string = 30;
    ip: int = 31;
    owner: string = 32;
    lstat: int = 34;
    lip: int = 35;
  }
  // carried by: OrphanCall, OrphanReply
  message Ctx2 {
    key: string = 30;
  }
  // carried by: ReadyReply
  message Ctx3 {
    last: int = 30;
    pool: string = 31;
  }
  enum NOOP = 0;
  enum PUT = 3;
  enum GET = 1;
  enum EXISTS = 2;
  enum DELETE = 4;

  message ClaimRec {       // release: one claim, flat owner=…;ip=…
    seq: int = 1;
    key: string = 3;
    owner: string = 4;
    ip: int = 50;
  }
  message OwnerGet {
    cid: int = 1;
    op: int = 2;
    key: string = 3;
    ctx: Ctx = 254;
  }
  message OwnerReply {     // the owner's address, read back as a number at 50
    cid: int = 1;
    status: int = 2;
    ip: int = 50;
    ctx: Ctx = 254;
  }
  message ReqCall {
    cid: int = 1;
    op: int = 2;
    key: string = 3;
    ctx: Ctx = 254;
  }
  message ReqReply {
    cid: int = 1;
    status: int = 2;
    ctx: Ctx = 254;
  }
  message DelCall {
    cid: int = 1;
    op: int = 2;
    key: string = 3;
  }

  message Orphan {         // a pod request whose sandbox is gone
    seq: int = 1;
    key: string = 3;
  }
  message OrphanCall {
    cid: int = 1;
    op: int = 2;
    key: string = 3;
    ctx: Ctx2 = 254;
  }
  message OrphanReply {
    cid: int = 1;
    status: int = 2;
    ctx: Ctx2 = 254;
  }

  decision pod_owner(r: ClaimRec) -> OwnerGet {
    default -> OwnerGet { cid: r.seq, op: GET, key: r.owner, ctx: Ctx { claim: r.key, ip: r.ip, owner: r.owner } };
  }
  decision pod_req(o: OwnerReply) -> ReqCall {
    default -> ReqCall { cid: o.cid, op: EXISTS, key: o.ctx.owner, ctx: Ctx { claim: o.ctx.claim, ip: o.ctx.ip, lstat: o.status, lip: o.ip } };
  }
  // Free the claim when the owner is gone entirely (no request, no lease), or
  // when its lease holds a different address. A request with no lease yet is
  // mid-allocation and keeps its claim.
  decision pod_free(r: ReqReply) -> DelCall {
    when r.status == 404 && r.ctx.lstat == 404 -> DelCall { cid: r.cid, op: DELETE, key: r.ctx.claim };
    when r.ctx.lstat == 200 && r.ctx.lip != r.ctx.ip -> DelCall { cid: r.cid, op: DELETE, key: r.ctx.claim };
    default -> DelCall { cid: r.cid, op: NOOP, key: "" };
  }

  // A request whose sandbox is gone: its lease and then the request itself go,
  // which is what frees the claim above.
  decision orphan_lease(o: Orphan) -> OrphanCall {
    default -> OrphanCall { cid: o.seq, op: DELETE, key: o.key, ctx: Ctx2 { key: o.key } };
  }
  decision orphan_req(o: OrphanReply) -> OrphanCall {
    default -> OrphanCall { cid: o.cid, op: DELETE, key: o.ctx.key, ctx: Ctx2 { key: o.ctx.key } };
  }
  transformation pr(r: ClaimRec) -> ClaimRec { ClaimRec { seq: r.seq, key: r.key, owner: r.owner, ip: r.ip } }
  transformation po(o: OwnerReply) -> OwnerReply {
    OwnerReply { cid: o.cid, status: o.status, ip: o.ip, ctx: Ctx { claim: o.ctx.claim, ip: o.ctx.ip, owner: o.ctx.owner } }
  }
  transformation pq(r: ReqReply) -> ReqReply {
    ReqReply { cid: r.cid, status: r.status, ctx: Ctx { claim: r.ctx.claim, ip: r.ctx.ip, lstat: r.ctx.lstat, lip: r.ctx.lip } }
  }
  transformation porph(o: Orphan) -> Orphan { Orphan { seq: o.seq, key: o.key } }
  transformation porr(o: OrphanReply) -> OrphanReply { OrphanReply { cid: o.cid, status: o.status, ctx: Ctx2 { key: o.ctx.key } } }
  pipeline pr_owner(r: ClaimRec) -> OwnerGet { call x = pr(r); call y = pod_owner(x); return y; }
  pipeline pr_req(o: OwnerReply) -> ReqCall { call x = po(o); call y = pod_req(x); return y; }
  pipeline pr_free(r: ReqReply) -> DelCall { call x = pq(r); call y = pod_free(x); return y; }
  pipeline po_lease(o: Orphan) -> OrphanCall { call x = porph(o); call y = orphan_lease(x); return y; }
  pipeline po_req(o: OrphanReply) -> OrphanCall { call x = porr(o); call y = orphan_req(x); return y; }
  entry pr_owner = pr_owner;
  entry pr_req = pr_req;
  entry pr_free = pr_free;
  entry po_lease = po_lease;
  entry po_req = po_req;
  // The cursor was just CREATED: allocation may begin. Its source does not
  // watch the cursor (a bump mid-allocation would re-pick the same owner), so
  // the ready stage wakes it through the pool's retry key.
  message ReadyReply {
    cid: int = 1;
    status: int = 2;
    ctx: Ctx3 = 254;
  }
  message WakeCall {
    cid: int = 1;
    op: int = 2;
    key: string = 3;
    key2: string = 17;
    v1: string = 4;
  }
  decision ready_wake(r: ReadyReply) -> WakeCall {
    when r.status == 200 && r.ctx.last == 1 ->
      WakeCall { cid: r.cid, op: PUT, key: "/ipam-retry/", key2: r.ctx.pool, v1: "ready" };
    default -> WakeCall { cid: r.cid, op: NOOP, key: "", key2: "", v1: "" };
  }
  transformation prr(r: ReadyReply) -> ReadyReply {
    ReadyReply { cid: r.cid, status: r.status, ctx: Ctx3 { last: r.ctx.last, pool: r.ctx.pool } }
  }
  pipeline wake(r: ReadyReply) -> WakeCall { call x = prr(r); call y = ready_wake(x); return y; }
  entry wake = wake;
  provenance revision "ipam-claims" toolchain "chronicle-authoring";
}
