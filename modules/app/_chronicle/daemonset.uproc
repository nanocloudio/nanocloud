// DaemonSet as params: one Pod per ready Node. Three chains.
//
//   ready   /nodes/ -> /ready-nodes/<node>   the readiness projection; a
//           fold the scheduler also performs, now a record nothing else
//           has to recompute; a Node deleted outright (its tomb's index)
//           -> its mark deleted
//   place   /daemonsets.apps/ JOIN /ready-nodes/ -> one record per (ds,
//           node) -> EXISTS the pod -> create-if-absent, node-pinned
//   prune   /pods/ owned by a DaemonSet -> GET /ready-nodes/<nodeName> ->
//           404 -> DELETE
//
// The cross product is the SOURCE's (`join`), as the count was for
// ReplicaSet: the cardinality is another prefix's, and every (ds, node) is an
// independent create-if-absent.
module nanocloud.daemonset {

  // The context each chain here carries across its effects: ONE nested
  // message in the reserved carry field (254), echoed unchanged by every
  // connector. Names, digests and verdicts only — never the template: a
  // real one is kilobytes, and carried here it overflowed the decisions'
  // 512 B scratch (and a source's 512 B field before that). The writer
  // SPLICES it from the stored DaemonSet (`src`).
  // carried by: ds.Probe, ds.Answer, ds.Ask, ds.Known
  message Ctx {
    key: string = 30;
    src: string = 31;     // the DaemonSet's key tail, the splice source
    node: string = 32;
    ns: string = 34;
    ds: string = 35;
    ouid: string = 36;    // the DaemonSet's metadata.uid: its Pods' controller reference
    hash: string = 37;    // its template's digest: controller-revision-hash
    pod: string = 39;
  }

  // ---- ready: the readiness projection ----
  message ds.Node {
    seq: int = 1;
    rev: int = 2;
    key: string = 3;    // "<node>" — the tail below /nodes/
    ready: string = 4;  // status.ready, "true" or otherwise
  }
  message ds.Mark {
    cid: int = 1;
    op: int = 2;
    key: string = 3;
    v1: string = 4;
  }
  decision ready(n: ds.Node) -> ds.Mark {
    when n.ready == "true" ->
      ds.Mark { cid: n.seq, op: PUT, key: n.key, v1: "1" };
    default ->
      ds.Mark { cid: n.seq, op: DELETE, key: n.key, v1: "" };
  }

  // ---- gone: a Node deleted outright ----
  // The readiness projection reads /nodes/, and a deleted Node is no record
  // there: its /ready-nodes/ mark stayed, so its DaemonSet Pods were never
  // pruned (and it stayed schedulable). Its tomb's index
  // (/~tomb-at/nodes/<node>) ends the mark — unless a Node of that name is
  // back (`related` /nodes/: its name, empty when there is none), whose
  // mark is the readiness projection's again.
  message ds.Gone {
    seq: int = 1;
    rev: int = 2;
    key: string = 3;    // "<node>" — the tail below /~tomb-at/nodes/
    back: string = 70;  // /nodes/<node> metadata.name, "" when it is gone
  }
  decision unmark(g: ds.Gone) -> ds.Mark {
    when g.back == "" ->
      ds.Mark { cid: g.seq, op: DELETE, key: g.key, v1: "" };
    default ->
      ds.Mark { cid: g.seq, op: NOOP, key: "", v1: "" };
  }

  // ---- place: one Pod per (DaemonSet, ready Node) ----
  message ds.Pair {
    seq: int = 1;
    rev: int = 2;
    key: string = 3;      // "<ns>/<ds>"
    uid: string = 4;      // metadata.uid, the Pods' controller reference
    node: string = 21;    // the joined ready node
    podkey: string = 24;  // "<ns>/<ds>-<node>"
    podname: string = 26; // "<ds>-<node>"
    hash: string = 27;    // the digest of spec.template (`hash`)
    ns: string = 28;
    ds: string = 29;
  }
  message ds.Probe {
    cid: int = 1;
    op: int = 2;
    key: string = 3;
    ctx: Ctx = 254;
  }
  message ds.Answer {
    cid: int = 1;
    status: int = 2;
    value: string = 3;
    ctx: Ctx = 254;
  }
  // The Pod as VALUE PARTS joined in field order (4..16, then 80..), the
  // template's labels, annotations and spec SPLICED in by the writer from
  // the stored DaemonSet (70 its key tail, 71 what goes where).
  message ds.Create {
    cid: int = 1;
    op: int = 2;
    key: string = 3;
    p1: string = 4;   p2: string = 5;   p3: string = 6;
    p4: string = 7;   p5: string = 8;   p6: string = 9;
    p7: string = 10;  p8: string = 11;  p9: string = 12;
    p10: string = 13; p11: string = 14; p12: string = 15;
    p13: string = 16;
    p14: string = 80; p15: string = 81; p16: string = 82;
    src: string = 70;
    splice: string = 71;
  }

  enum NOOP = 0;
  enum GET = 1;
  enum EXISTS = 2;
  enum PUT = 3;
  enum DELETE = 4;

  decision probe(p: ds.Pair) -> ds.Probe {
    default ->
      ds.Probe { cid: p.seq, op: EXISTS, key: p.podkey, ctx: Ctx { key: p.podkey, src: p.key, node: p.node, ns: p.ns, ds: p.ds, ouid: p.uid, hash: p.hash, pod: p.podname } };
  }

  // Create-if-absent, node-pinned, as upstream's DaemonSet controller makes
  // its Pods: the template's labels beside controller-revision-hash (the
  // template's digest), the template's annotations, the template's spec
  // with nodeName first — all three spliced from the stored DaemonSet, so
  // a template of any size arrives whole. An empty label or spec member
  // list splices nothing (and no comma).
  decision create(a: ds.Answer) -> ds.Create {
    when a.status == 404 ->
      ds.Create { cid: a.cid, op: PUT, key: a.ctx.key,
                  p1: "{\"apiVersion\":\"v1\",\"kind\":\"Pod\",\"metadata\":{\"name\":\"",
                  p2: a.ctx.pod,
                  p3: "\",\"namespace\":\"",
                  p4: a.ctx.ns,
                  p5: "\",\"labels\":{\"controller-revision-hash\":\"",
                  p6: a.ctx.hash,
                  p7: "\"",
                  p8: "},\"annotations\":{",
                  p9: "},\"ownerReferences\":[{\"apiVersion\":\"apps/v1\",\"kind\":\"DaemonSet\",\"name\":\"",
                  p10: a.ctx.ds,
                  p11: "\",\"uid\":\"",
                  p12: a.ctx.ouid,
                  p13: "\",\"controller\":true,\"blockOwnerDeletion\":true}]},\"spec\":{\"nodeName\":\"",
                  p14: a.ctx.node,
                  p15: "\"",
                  p16: "},\"status\":{\"phase\":\"Pending\"}}",
                  src: a.ctx.src,
                  splice: "/daemonsets.apps/|11=,spec.template.metadata.labels.*;12=spec.template.metadata.annotations.*;82=,spec.template.spec.*" };
    default ->
      ds.Create { cid: a.cid, op: NOOP, key: "" };
  }

  // ---- prune: a DaemonSet Pod whose Node is no longer ready ----
  message ds.Pod {
    seq: int = 1;
    rev: int = 2;
    key: string = 3;      // "<ns>/<pod>"
    kind: string = 4;     // metadata.ownerReferences.0.kind
    node: string = 5;     // spec.nodeName
  }
  message ds.Ask {
    cid: int = 1;
    op: int = 2;
    key: string = 3;      // the node, under /ready-nodes/
// the pod, to delete
    ctx: Ctx = 254;
  }
  message ds.Known {
    cid: int = 1;
    status: int = 2;
    value: string = 3;
    ctx: Ctx = 254;
  }
  message ds.Act {
    cid: int = 1;
    op: int = 2;
    key: string = 3;
  }
  decision ask(p: ds.Pod) -> ds.Ask {
    when p.kind == "DaemonSet" && p.node != "" ->
      ds.Ask { cid: p.seq, op: EXISTS, key: p.node, ctx: Ctx { key: p.key } };
    default ->
      ds.Ask { cid: p.seq, op: NOOP, key: "", ctx: Ctx { key: p.key } };
  }
  decision prune(k: ds.Known) -> ds.Act {
    when k.status == 404 ->
      ds.Act { cid: k.cid, op: DELETE, key: k.ctx.key };
    default ->
      ds.Act { cid: k.cid, op: NOOP, key: "" };
  }

  transformation pass_node(n: ds.Node) -> ds.Node {
    ds.Node { seq: n.seq, rev: n.rev, key: n.key, ready: n.ready }
  }
  transformation pass_pair(p: ds.Pair) -> ds.Pair {
    ds.Pair { seq: p.seq, rev: p.rev, key: p.key, uid: p.uid, node: p.node,
              podkey: p.podkey, podname: p.podname, hash: p.hash, ns: p.ns, ds: p.ds }
  }
  transformation pass_answer(a: ds.Answer) -> ds.Answer {
    ds.Answer { cid: a.cid, status: a.status, value: a.value, ctx: a.ctx }
  }
  transformation pass_pod(p: ds.Pod) -> ds.Pod {
    ds.Pod { seq: p.seq, rev: p.rev, key: p.key, kind: p.kind, node: p.node }
  }
  transformation pass_known(k: ds.Known) -> ds.Known {
    ds.Known { cid: k.cid, status: k.status, value: k.value, ctx: k.ctx }
  }

  pipeline rdy(n: ds.Node) -> ds.Mark {
    call x = pass_node(n);
    call y = ready(x);
    return y;
  }
  pipeline gone_p(g: ds.Gone) -> ds.Mark {
    call x = unmark(g);
    return x;
  }
  pipeline prb(p: ds.Pair) -> ds.Probe {
    call x = pass_pair(p);
    call y = probe(x);
    return y;
  }
  pipeline mk(a: ds.Answer) -> ds.Create {
    call x = pass_answer(a);
    call y = create(x);
    return y;
  }
  // Named apart from the `ask` decision it calls: a document's declarations
  // share one namespace.
  pipeline ask_p(p: ds.Pod) -> ds.Ask {
    call x = pass_pod(p);
    call y = ask(x);
    return y;
  }
  pipeline prn(k: ds.Known) -> ds.Act {
    call x = pass_known(k);
    call y = prune(x);
    return y;
  }

  entry rdy = rdy;
  entry gone = gone_p;
  entry prb = prb;
  entry mk = mk;
  entry ask = ask_p;
  entry prn = prn;

  provenance revision "daemonset-join" toolchain "chronicle-authoring";
}
