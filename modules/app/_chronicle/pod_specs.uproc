// A scheduled Pod as the node's ask: /pods/ with spec.nodeName -> the flat
// /pod-specs/<uid> record the node's pod-lifecycle chain runs.
//
//   spec    /pods/<ns>/<name> bound to a node, graph-backed
//           (runtimeClassName: fluxor) -> /pod-specs/<uid>
//           node graph image restart grace desired cpu mem eph pod paused;
//           desired=deleted once the Pod carries a deletionTimestamp. A
//           CONTAINER Pod's records — one per container — are pod_resolve's
//           (_shared/podres.rs): its environment, command, user and volumes
//           are functions of other objects, which no decision can compute
//   gone    /~tomb-at/pods/<ns>/<name> (a Pod deleted outright: its tomb's
//           index entry, its identity at the tomb's paths)
//           -> /pod-specs/<uid> desired=deleted, either kind, and the same
//           for every container record of it, <uid>~c<n> and <uid>~i<n>
//           (store_effect PUT_FAMILY: one listing of the uid's prefix), so
//           no sidecar or init container of a deleted Pod keeps running.
//           Its grace is the delete's (the tomb's
//           deletionGracePeriodSeconds: the request's DeleteOptions, 0 for
//           `--force --grace-period=0`), else the Pod's own
//           terminationGracePeriodSeconds, else 30 — what a controller's or
//           the garbage collector's delete gives it. The node signals
//           SIGTERM, waits out the grace, then SIGKILL (pod_lifecycle).
//
// Each record is written into its node's scope, /~node/<node>/pod-specs/
// <uid> (the effect's key_prefix is /~node/): a worker's store keeps
// /pod-specs/ as its own, so its chains read only what is asked of it, by
// the plain name. The record also names its node. It is put-if-changed, so
// a Pod that did not change spends no revision on the node's side.
module nanocloud.podspecs {

  enum NOOP = 0;
  enum PUT = 3;
  enum PUT_FAMILY = 19;

  message ps.Pod {
    seq: int = 1;
    rev: int = 2;
    key: string = 3;       // "<ns>/<name>"
    uid: string = 4;       // metadata.uid
    node: string = 5;      // spec.nodeName ("" until scheduled)
    image: string = 6;     // spec.containers.0.image
    restart: string = 7;   // spec.restartPolicy, lowercased
    deleting: string = 8;  // metadata.deletionTimestamp
    rtc: string = 9;       // spec.runtimeClassName: "fluxor" names a graph-backed Pod
    cpu: string = 10;      // spec.containers.0.resources.limits.cpu!milli
    mem: string = 11;      // …limits.memory!bytes
    eph: string = 12;      // …limits.ephemeral-storage!bytes
    paused: string = 13;   // metadata.annotations!pick=nanocloud.io/paused
  }
  // Value parts are joined into the record (store_effect: 4..16, then
  // 80..99); the node reads it as flat `k=v;` fields, in any order.
  message ps.Spec {
    cid: int = 1;
    op: int = 2;
    key: string = 3;
    p1: string = 4;   p2: string = 5;   p3: string = 6;   p4: string = 7;
    p5: string = 8;   p6: string = 9;   p7: string = 10;  p8: string = 11;
    p9: string = 12;  p10: string = 13; p11: string = 14; p12: string = 15;
    p13: string = 16;
    p14: string = 80; p15: string = 81; p16: string = 82; p17: string = 83;
    p18: string = 84;
  }
  // The defaults upstream's API server applies to a Pod it admits, applied
  // where the spec is read: an unstated restartPolicy is Always. A
  // graph-backed Pod has no SIGTERM window to grant (grace 0), and its image
  // — a Graph's name, or a pulled workload image's reference — is its graph.
  decision spec(p: ps.Pod) -> ps.Spec {
    when p.node == "" || p.uid == "" || p.rtc != "fluxor" ->
      ps.Spec { cid: p.seq, op: NOOP, key: "" };
    when p.deleting != "" && (p.image.indexOf("/") >= 0 || p.image.indexOf(":") >= 0) ->
      ps.Spec { cid: p.seq, op: PUT, key: p.node + "/pod-specs/" + p.uid, p1: "node=",
                 p2: p.node, p3: ";graph=", p4: p.image, p5: ";image=", p6: p.image,
                 p7: ";grace=0;desired=deleted;cmd=;cpu=", p8: p.cpu, p9: ";mem=", p10: p.mem,
                 p11: ";eph=", p12: p.eph, p13: ";pod=", p14: p.key };
    when p.deleting != "" ->
      ps.Spec { cid: p.seq, op: PUT, key: p.node + "/pod-specs/" + p.uid, p1: "node=",
                 p2: p.node, p3: ";graph=", p4: p.image,
                 p5: ";grace=0;desired=deleted;cmd=;cpu=", p6: p.cpu, p7: ";mem=", p8: p.mem,
                 p9: ";eph=", p10: p.eph, p11: ";pod=", p12: p.key };
    when (p.image.indexOf("/") >= 0 || p.image.indexOf(":") >= 0) && p.restart == "" ->
      ps.Spec { cid: p.seq, op: PUT, key: p.node + "/pod-specs/" + p.uid, p1: "node=",
                 p2: p.node, p3: ";graph=", p4: p.image, p5: ";image=", p6: p.image,
                 p7: ";restart=", p8: "always", p9: ";grace=0;desired=running;cmd=;cpu=",
                 p10: p.cpu, p11: ";mem=", p12: p.mem, p13: ";eph=", p14: p.eph, p15: ";pod=",
                 p16: p.key, p17: ";paused=", p18: p.paused };
    when p.image.indexOf("/") >= 0 || p.image.indexOf(":") >= 0 ->
      ps.Spec { cid: p.seq, op: PUT, key: p.node + "/pod-specs/" + p.uid, p1: "node=",
                 p2: p.node, p3: ";graph=", p4: p.image, p5: ";image=", p6: p.image,
                 p7: ";restart=", p8: p.restart, p9: ";grace=0;desired=running;cmd=;cpu=",
                 p10: p.cpu, p11: ";mem=", p12: p.mem, p13: ";eph=", p14: p.eph, p15: ";pod=",
                 p16: p.key, p17: ";paused=", p18: p.paused };
    when p.restart == "" ->
      ps.Spec { cid: p.seq, op: PUT, key: p.node + "/pod-specs/" + p.uid, p1: "node=",
                 p2: p.node, p3: ";graph=", p4: p.image, p5: ";restart=", p6: "always",
                 p7: ";grace=0;desired=running;cmd=;cpu=", p8: p.cpu, p9: ";mem=", p10: p.mem,
                 p11: ";eph=", p12: p.eph, p13: ";pod=", p14: p.key, p15: ";paused=", p16: p.paused };
    default ->
      ps.Spec { cid: p.seq, op: PUT, key: p.node + "/pod-specs/" + p.uid, p1: "node=",
                 p2: p.node, p3: ";graph=", p4: p.image, p5: ";restart=", p6: p.restart,
                 p7: ";grace=0;desired=running;cmd=;cpu=", p8: p.cpu, p9: ";mem=", p10: p.mem,
                 p11: ";eph=", p12: p.eph, p13: ";pod=", p14: p.key, p15: ";paused=", p16: p.paused };
  }

  message ps.Tomb {
    seq: int = 1;
    rev: int = 2;
    key: string = 3;      // "<ns>/<name>"
    uid: string = 4;      // obj.metadata.uid
    node: string = 5;     // obj.spec.nodeName
    rtc: string = 6;      // obj.spec.runtimeClassName
    image: string = 7;    // obj.spec.containers.0.image
    dgrace: string = 8;   // obj.metadata.deletionGracePeriodSeconds (the delete's)
    tgrace: string = 9;   // obj.spec.terminationGracePeriodSeconds (the Pod's)
  }
  // A graph-backed Pod's tombstone keeps naming its graph: the node's
  // lifecycle chain tears a metal sandbox down only for a spec that says
  // which graph it was (its delete arms carry `graph` to the metal effect);
  // it has no SIGTERM window to grant (grace 0).
  decision gone(t: ps.Tomb) -> ps.Spec {
    when t.uid == "" || t.node == "" ->
      ps.Spec { cid: t.seq, op: NOOP, key: "" };
    when t.rtc == "fluxor" ->
      ps.Spec { cid: t.seq, op: PUT_FAMILY, key: t.node + "/pod-specs/" + t.uid,
                p1: "node=", p2: t.node, p3: ";graph=", p4: t.image,
                p5: ";grace=0;desired=deleted;cmd=" };
    when t.dgrace != "" ->
      ps.Spec { cid: t.seq, op: PUT_FAMILY, key: t.node + "/pod-specs/" + t.uid,
                p1: "node=", p2: t.node, p3: ";grace=", p4: t.dgrace,
                p5: ";desired=deleted;cmd=" };
    when t.tgrace != "" ->
      ps.Spec { cid: t.seq, op: PUT_FAMILY, key: t.node + "/pod-specs/" + t.uid,
                p1: "node=", p2: t.node, p3: ";grace=", p4: t.tgrace,
                p5: ";desired=deleted;cmd=" };
    default ->
      ps.Spec { cid: t.seq, op: PUT_FAMILY, key: t.node + "/pod-specs/" + t.uid,
                p1: "node=", p2: t.node, p3: ";grace=30;desired=deleted;cmd=" };
  }

  pipeline spec_p(p: ps.Pod) -> ps.Spec {
    call x = spec(p);
    return x;
  }
  pipeline gone_p(t: ps.Tomb) -> ps.Spec {
    call x = gone(t);
    return x;
  }

  entry spec = spec_p;
  entry gone = gone_p;

  provenance revision "pod-specs" toolchain "chronicle-authoring";
}
