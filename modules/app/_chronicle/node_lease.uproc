// A node registers itself and keeps its lease; the control plane takes a
// node that stops renewing out of service.
//
//   renew   (node)  /nodes/<self> — absent, or due — -> PUT it ready, its
//                   heartbeat the node's monotonic clock now. The record is
//                   the Node the API serves, so it carries its apiVersion
//                   and kind: a client decodes nothing without them. The source's
//                   `label` is the node's name; `empty` emits when there is
//                   no record yet, `due` wakes it to renew.
//   seen    (plane) /nodes/<node> at a revision not yet seen -> /node-seen/
//                   <node> rev=<rev>;at=<the plane's clock>: when the plane
//                   last saw it change. Clocks of two machines are never
//                   compared; each side reads only its own.
//   stale   (plane) /node-seen/<node> unchanged LEASE_MS -> /nodes/<node>
//                   status.ready false, which the readiness projection
//                   (daemonset.uproc `rdy`) carries to /ready-nodes/. A node
//                   that renews again is ready again.
module nanocloud.nodelease {

  enum NOOP = 0;
  enum PUT = 3;
  enum PATCH = 5;

  // ---- renew: the node's own record ----
  message nl.Self {
    seq: int = 1;
    key: string = 3;
    ready: string = 4;    // status.ready
    hb: int = 50;         // status.heartbeat, the node's clock when it wrote
    total: int = 22;      // 0: no record yet (the source's `empty`)
    labels: string = 5;   // metadata.labels, as stored
    label: string = 48;   // the node's name
    facts: string = 49;   // its labels as the render knows them (JSON members)
    addr: string = 47;    // its own address as the render knows it (`address`)
    cap: string = 46;     // its capacity as the render knows it (`capacity`)
    now: int = 58;
  }
  // The value parts, joined in field order: the capacity (c1..c5) sits
  // right after the heartbeat (v6), so every arm states its status from v5.
  // Each capacity part is a VIEW cut to nothing when there is no capacity
  // (no concatenation: the decision's scratch is 512 bytes).
  message nl.Put {
    cid: int = 1;
    op: int = 2;
    key: string = 3;
    v1: string = 4;  v2: string = 5;  v3: string = 6;  v4: string = 7;
    v5: string = 8;  v6: string = 9;
    c1: string = 10; c2: string = 11; c3: string = 12; c4: string = 13; c5: string = 14;
    v7: string = 15; v8: string = 16; v9: string = 80;
  }
  // Renew every 10 s; at once when there is no record, when the plane has
  // taken the node out of service, or when the clock is behind the heartbeat
  // (the node restarted, its clock with it). A node whose render knows its
  // facts (arch, os, the fluxor ABI) carries them as its labels — what a
  // Pod's nodeSelector is matched against — and renews at once when the
  // stored labels are not them (a node upgraded to another ABI).
  //
  // A node whose render knows its address advertises it, as a kubelet does:
  // status.addresses InternalIP (then its Hostname) — the hostIP of every
  // Pod it runs, and so where a Service's endpoints reach a Pod that shares
  // the node's network. A render that did not fill its placeholder in
  // (`__NODE_ADDRESS__`) has no address to give, and none is advertised.
  //
  // A node whose render knows its capacity (cpu, memory, pods) reports it as
  // status.capacity and status.allocatable — what the scheduler fits a Pod's
  // requests within. A placeholder left unfilled (no `"` in it) reports
  // none, and the node is not limited by one.
  decision renew(n: nl.Self) -> nl.Put {
    when n.label == "" ->
      nl.Put { cid: n.seq, op: NOOP, key: "" };
    when has(n.facts) && n.facts != "" && has(n.addr) && n.addr != "" && !n.addr.startsWith("_")
         && (n.total == 0 || n.ready != "true" || n.hb == 0 || n.now < n.hb || n.now >= n.hb + 10000
             || !has(n.labels) || n.labels != "{" + n.facts + "}") ->
      nl.Put { cid: n.seq, op: PUT, key: n.label,
               v1: "{\"apiVersion\":\"v1\",\"kind\":\"Node\",\"metadata\":{\"name\":\"", v2: n.label,
               v3: "\",\"labels\":{", v4: n.facts,
               v5: "}},\"status\":{\"ready\":true,\"heartbeat\":", v6: n.now,
               c1: ",\"capacity\":{".substring(0, 13 * math.least(1, n.cap.indexOf("\"") + 1)),
               c2: n.cap.substring(0, size(n.cap) * math.least(1, n.cap.indexOf("\"") + 1)),
               c3: "},\"allocatable\":{".substring(0, 17 * math.least(1, n.cap.indexOf("\"") + 1)),
               c4: n.cap.substring(0, size(n.cap) * math.least(1, n.cap.indexOf("\"") + 1)),
               c5: "}".substring(0, math.least(1, n.cap.indexOf("\"") + 1)),
               v7: ",\"addresses\":[{\"type\":\"InternalIP\",\"address\":\"" + n.addr + "\"},{\"type\":\"Hostname\",\"address\":\"",
               v8: n.label,
               v9: "\"}],\"conditions\":[{\"type\":\"Ready\",\"status\":\"True\",\"reason\":\"KubeletReady\"}]}}" };
    when has(n.facts) && n.facts != ""
         && (n.total == 0 || n.ready != "true" || n.hb == 0 || n.now < n.hb || n.now >= n.hb + 10000
             || !has(n.labels) || n.labels != "{" + n.facts + "}") ->
      nl.Put { cid: n.seq, op: PUT, key: n.label,
               v1: "{\"apiVersion\":\"v1\",\"kind\":\"Node\",\"metadata\":{\"name\":\"", v2: n.label,
               v3: "\",\"labels\":{", v4: n.facts,
               v5: "}},\"status\":{\"ready\":true,\"heartbeat\":", v6: n.now,
               c1: ",\"capacity\":{".substring(0, 13 * math.least(1, n.cap.indexOf("\"") + 1)),
               c2: n.cap.substring(0, size(n.cap) * math.least(1, n.cap.indexOf("\"") + 1)),
               c3: "},\"allocatable\":{".substring(0, 17 * math.least(1, n.cap.indexOf("\"") + 1)),
               c4: n.cap.substring(0, size(n.cap) * math.least(1, n.cap.indexOf("\"") + 1)),
               c5: "}".substring(0, math.least(1, n.cap.indexOf("\"") + 1)),
               v7: ",\"conditions\":[{\"type\":\"Ready\",\"status\":\"True\",\"reason\":\"KubeletReady\"}]}}" };
    when has(n.facts) && n.facts != "" ->
      nl.Put { cid: n.seq, op: NOOP, key: "" };
    when has(n.addr) && n.addr != "" && !n.addr.startsWith("_")
         && (n.total == 0 || n.ready != "true" || n.hb == 0 || n.now < n.hb || n.now >= n.hb + 10000) ->
      nl.Put { cid: n.seq, op: PUT, key: n.label,
               v1: "{\"apiVersion\":\"v1\",\"kind\":\"Node\",\"metadata\":{\"name\":\"", v2: n.label,
               v5: "\"},\"status\":{\"ready\":true,\"heartbeat\":", v6: n.now,
               c1: ",\"capacity\":{".substring(0, 13 * math.least(1, n.cap.indexOf("\"") + 1)),
               c2: n.cap.substring(0, size(n.cap) * math.least(1, n.cap.indexOf("\"") + 1)),
               c3: "},\"allocatable\":{".substring(0, 17 * math.least(1, n.cap.indexOf("\"") + 1)),
               c4: n.cap.substring(0, size(n.cap) * math.least(1, n.cap.indexOf("\"") + 1)),
               c5: "}".substring(0, math.least(1, n.cap.indexOf("\"") + 1)),
               v7: ",\"addresses\":[{\"type\":\"InternalIP\",\"address\":\"" + n.addr + "\"},{\"type\":\"Hostname\",\"address\":\"",
               v8: n.label,
               v9: "\"}],\"conditions\":[{\"type\":\"Ready\",\"status\":\"True\",\"reason\":\"KubeletReady\"}]}}" };
    when n.total == 0 || n.ready != "true" || n.hb == 0 || n.now < n.hb || n.now >= n.hb + 10000 ->
      nl.Put { cid: n.seq, op: PUT, key: n.label,
               v1: "{\"apiVersion\":\"v1\",\"kind\":\"Node\",\"metadata\":{\"name\":\"", v2: n.label,
               v5: "\"},\"status\":{\"ready\":true,\"heartbeat\":", v6: n.now,
               c1: ",\"capacity\":{".substring(0, 13 * math.least(1, n.cap.indexOf("\"") + 1)),
               c2: n.cap.substring(0, size(n.cap) * math.least(1, n.cap.indexOf("\"") + 1)),
               c3: "},\"allocatable\":{".substring(0, 17 * math.least(1, n.cap.indexOf("\"") + 1)),
               c4: n.cap.substring(0, size(n.cap) * math.least(1, n.cap.indexOf("\"") + 1)),
               c5: "}".substring(0, math.least(1, n.cap.indexOf("\"") + 1)),
               v7: ",\"conditions\":[{\"type\":\"Ready\",\"status\":\"True\",\"reason\":\"KubeletReady\"}]}}" };
    default ->
      nl.Put { cid: n.seq, op: NOOP, key: "" };
  }

  // ---- seen: when the plane last saw each node change ----
  message nl.Node {
    seq: int = 1;
    rev: int = 2;         // the record's revision (`rev = 1`)
    key: string = 3;      // "<node>"
    now: int = 58;
    seen_rev: int = 70;   // /node-seen/<node> rev
    seen_at: int = 71;    // /node-seen/<node> at
  }
  // A plane whose clock is behind its record restarted, its clock with it:
  // what it saw is stamped again, so a lease runs from the restart.
  decision seen(n: nl.Node) -> nl.Put {
    when n.rev != 0 && n.rev == n.seen_rev && n.now >= n.seen_at ->
      nl.Put { cid: n.seq, op: NOOP, key: "" };
    default ->
      nl.Put { cid: n.seq, op: PUT, key: n.key,
               v1: "rev=", v2: n.rev, v3: ";at=", v4: n.now };
  }

  // ---- stale: a node that stopped renewing ----
  message nl.Seen {
    seq: int = 1;
    key: string = 3;      // "<node>"
    at: int = 50;         // the plane's clock when the record last changed
    now: int = 58;
    ready: string = 70;   // /nodes/<node> status.ready
  }
  message nl.Patch {
    cid: int = 1;
    op: int = 2;
    key: string = 3;
    value: string = 4;
    path: string = 19;
  }
  // Three missed renewals. The whole status goes, heartbeat included: a
  // node that comes back sees hb == 0 and renews at once; kubectl sees
  // Ready=False meanwhile. `ready` stays beside `conditions` because the
  // plane's own decisions read it.
  decision stale(n: nl.Seen) -> nl.Patch {
    when n.ready == "true" && n.at > 0 && n.now >= n.at + 30000 ->
      nl.Patch { cid: n.seq, op: PATCH, key: n.key,
                 value: "{\"ready\":false,\"conditions\":[{\"type\":\"Ready\",\"status\":\"False\",\"reason\":\"NodeStatusUnknown\"}]}",
                 path: "status" };
    default ->
      nl.Patch { cid: n.seq, op: NOOP, key: "" };
  }

  pipeline renew_p(n: nl.Self) -> nl.Put {
    call x = renew(n);
    return x;
  }
  pipeline seen_p(n: nl.Node) -> nl.Put {
    call x = seen(n);
    return x;
  }
  pipeline stale_p(n: nl.Seen) -> nl.Patch {
    call x = stale(n);
    return x;
  }

  entry renew = renew_p;
  entry seen = seen_p;
  entry stale = stale_p;

  provenance revision "node-lease" toolchain "chronicle-authoring";
}
