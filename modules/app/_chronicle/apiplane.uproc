// The Kubernetes API request path, compiled to params.
//
// One request walks: decode -> authenticate -> authorize -> probe -> act ->
// reply. Every stage between the connectors is a decision in this file; every
// connector below moves bytes and decides nothing. Nothing about /api/v1, about
// which verb a method means, or about what a refusal answers is in an .fmod.
//
// The chain, and which node each entry drives:
//
//   kube_decode        request envelope -> Request record   (kube.rd, kube.uproc)
//   kube_route         the path's shape -> resource, ns, name, key  (kube.uproc)
//   admit    (here)    -> VerifyCall            credential out, request as carry
//   kagi_verify        <-> kagi token_verify    the signature check
//   ident    (here)    -> AuthzCall             identity + ns + verb + resource
//   rbac               ONE store probe of the grant index rbac_*.uproc maintains
//                      (this file's `authz` entry drives it)
//   gate     (here)    -> AdmitCall             admitted, or the refusal
//   ad_pol/ad_cnt/ad_dec   admission: policy, quota count, verdict (admission.uproc)
//   probe    (here)    -> StoreCall             GET the object, or LIST the collection
//   se_probe           the read
//   act      (here)    -> StoreCall             PUT / DELETE / NOOP, and the answer
//   se_act             the write
//   reply    (here)    -> Reply                 (cid, status, body)
//   encode   (here)    -> reply envelope        (drives enc_http)
//
// CARRY. Everything a later stage needs must ride 30..=39 across each
// connector, because once a record leaves, the fields that produced it are
// gone. The widest point is `admit`, which carries eight: cid, method, key,
// resource, namespace, name, body, and the running verdict. Two spare, so the
// budget holds with room at the chain's widest point.
module nanocloud.apiplane {

  // ---- wire vocabularies, named rather than restated ----

  // the exchange method byte (fluxor's `contracts/exchange.rs`)
  enum M_GET = 1;
  enum M_POST = 3;
  enum M_PUT = 5;
  enum M_PATCH = 6;          // RFC 7386 merge patch
  enum M_PATCH_JSON = 16;    // RFC 6902 JSON Patch   } kube.uproc `mpatch` folds a
  enum M_PATCH_SMP = 26;     // strategic merge        } PATCH's Content-Type into
  enum M_PATCH_APPLY = 36;   // server-side apply      } its method
  enum OP_PATCH_MERGE = 13;
  enum OP_PATCH_JSON = 14;
  enum OP_PATCH_SMP = 15;
  enum OP_APPLY = 16;
  enum M_DELETE = 7;

  // store_effect ops
  enum OP_NOOP = 0;
  enum OP_GET = 1;
  enum OP_PUT = 3;
  enum OP_DELETE = 4;
  enum OP_LIST = 7;
  // Conditional writes, evaluated by the STORE at one linearization point:
  // CREATE refuses a key that exists, REPLACE one that moved since the client
  // read it (the body's metadata.resourceVersion). Both answer 409.
  enum OP_CREATE = 8;
  enum OP_REPLACE = 9;
  enum OP_EXISTS_ANY = 10;

  // kagi auth_wire verify_err
  enum V_OK = 0;
  enum V_MALFORMED = 1;
  enum V_NO_KEY = 2;
  enum V_EXPIRED = 5;

  // Every refusal answers the Kubernetes `Status` envelope, like every success
  // answers its object: a client parses ONE shape whatever happened, and
  // `kubectl` reads `reason` to decide whether to retry. Carrying a bare string
  // here meant a caller had to know which outcomes were JSON and which were
  // prose.
  //
  // A verdict already reached. 0 means "still deciding" — every later stage
  // tests this FIRST and passes a non-zero verdict through untouched, which is
  // how a refusal at stage two reaches the response encoder at stage six
  // without a second path through the graph to maintain.
  enum PENDING = 0;
  /// A verdict of "already authenticated, do not ask kagi" — an mTLS peer.
  /// A distinct value rather than 200, because 200 is an ANSWER and this
  /// request has not been authorised yet: the authz stage must still run.
  enum PEER_OK = 1;

  // ---- records ----

  message Request {
    cid: int = 1;
    method: int = 2;
    resource: string = 3;
    namespace: string = 4;
    name: string = 5;
    body: string = 6;
    key: string = 7;
    credential: string = 8;
    target: string = 9;
    watch: int = 11;
    // The verified mTLS peer, hex, from the request envelope's peer trailer.
    // Empty on a plaintext connection.
    peer: string = 12;
    group: string = 13;    // the API group (kube.uproc route)
  }

  // What authorization needs beyond the ten carried fields, riding the
  // reserved carry field (254) every connector echoes: the request's API group,
  // and — for a non-resource path RBAC guards — that path.
  message ApiCtx {
    group: string = 1;
    nonres: string = 2;
  }

  message VerifyCall {
    credential: string = 8;
    c_cid: int = 30;
    c_method: int = 31;
    c_key: string = 32;
    c_resource: string = 33;
    c_name: string = 34;
    c_body: string = 35;
    c_namespace: string = 36;
    c_verdict: int = 37;
    c_answer: string = 38;
    c_watch: int = 39;
    ctx: ApiCtx = 254;
  }

  message Verified {
    corr: int = 1;
    status: int = 2;
    subject: string = 3;
    c_cid: int = 30;
    c_method: int = 31;
    c_key: string = 32;
    c_resource: string = 33;
    c_name: string = 34;
    c_body: string = 35;
    c_namespace: string = 36;
    c_verdict: int = 37;
    c_answer: string = 38;
    c_watch: int = 39;
    ctx: ApiCtx = 254;
  }

  // `verb` is a LITERAL this file chooses per branch — which verb a method
  // means is precisely the meaning that belongs here rather than in a module.
  // An EXISTS_ANY probe of the RBAC grant index (rbac.uproc):
  //   /rbac-g/<identity>/<ns>|<verb>|<resource>
  // where the namespace, verb and resource may each also be `*` (the node's
  // `wild` param), so a ClusterRoleBinding's grant ("*" scope) and a rule's
  // wildcards match without a probe each.
  message AuthzCall {
    op: int = 2;
    identity: string = 3;
    k1: string = 17;
    ns: string = 18;
    k3: string = 25;
    verb: string = 26;
    k5: string = 27;
    resource: string = 20;     // the API group: the grant key is <id>/<ns>|<verb>|<group>|<res>|<name>
    k7: string = 21;
    res: string = 22;
    k9: string = 23;
    name: string = 24;
    c_cid: int = 30;
    c_method: int = 31;
    c_key: string = 32;
    c_verdict: int = 33;
    c_name: string = 34;
    c_body: string = 35;
    c_reason: string = 36;
    c_verb: string = 37;
    c_resource: string = 38;
    c_namespace: string = 39;
    ctx: ApiCtx = 254;
  }

  // THE FULL CARRY BUDGET. Ten fields is what a connector echoes, and this uses
  // all ten: an authorized request that still has admission, a read and a write
  // ahead of it has nothing left to remember. A fifth filter stage would have
  // to fold two of these together, not add an eleventh.
  message Authzed {
    // The index's answer: 200 = some grant covers the request, 404 = none.
    granted: int = 2;
    c_cid: int = 30;
    c_method: int = 31;
    c_key: string = 32;
    c_verdict: int = 33;
    c_name: string = 34;
    c_body: string = 35;
    c_reason: string = 36;
    c_verb: string = 37;
    c_resource: string = 38;
    c_namespace: string = 39;
    ctx: ApiCtx = 254;
  }

  // What `api_admission` takes on its connector seam. An EMPTY verb means "not
  // a mutating request": there is no object to validate, and a resource whose
  // policy names a required field would otherwise reject every read of it.
  message AdmitCall {
    verb: string = 3;
    resource: string = 4;
    namespace: string = 5;
    object: string = 6;
    c_cid: int = 30;
    c_method: int = 31;
    c_key: string = 32;
    c_verdict: int = 33;
    c_name: string = 34;
    c_reason: string = 36;
    c_verb: string = 37;
  }

  // What it answers: a status, and the object AS ADMITTED — defaults applied.
  // The mutated object is what gets written, which is the whole point of a
  // mutating admission stage.
  // What se_body answers (apiplane_watch `body`): admission's verdict and
  // object, moved clear of the store reply's own fields, and — for a body the
  // HTTP server STAGED — its metadata.name, read from the staged blob (a
  // create names its object in the body, which the router could not read).
  message Admitted {
    name: string = 40;
    // A staged body's `data` and `binaryData` sizes (keys + values, the
    // measure upstream bounds), from se_body; 0 for an inline one.
    dsize: int = 50;
    bsize: int = 51;
    status: int = 60;
    object: string = 61;
    c_cid: int = 30;
    c_method: int = 31;
    c_key: string = 32;
    c_verdict: int = 33;
    c_name: string = 34;
    c_reason: string = 36;
    c_verb: string = 37;
  }

  message StoreCall {
    cid: int = 1;
    op: int = 2;
    key: string = 3;
    value: string = 4;
    c_cid: int = 30;
    c_method: int = 31;
    c_key: string = 32;
    c_verdict: int = 33;
    c_body: string = 35;
    c_reason: string = 36;
    c_verb: string = 37;
  }



  // The act stage's call, and what comes back. `c_status`/`c_answer` are the
  // answer already decided: the write still has to happen, but what to tell
  // the client does not depend on it.
  message ActCall {
    cid: int = 1;
    op: int = 2;
    key: string = 3;
    // A second KEY PART, joined after field 3 by the connector: registering a
    // watcher writes `/watch-reg` + the collection key, and the VM cannot
    // concatenate the two.
    key2: string = 17;
    // A third, as a NUMBER the connector renders: /watch-reg/<cid>.
    kcid: int = 18;
    // VALUE PARTS, joined the same way. A watch registration is
    // `{"cid":` <cid> `,"p":"` <key> `",` + the facts kube_facts.rd built.
    value: string = 4;
    value2: int = 5;
    value3: string = 6;
    value4: string = 7;
    value5: string = 8;
    value6: string = 9;
    c_cid: int = 30;
    c_status: int = 31;
    c_answer: string = 32;
    // 1 when this response is the first slice of a STREAM rather than a
    // complete answer — the reply envelope's MORE flag.
    c_stream: int = 33;
    // The object's key, carried to the step after the write (apiplane_watch
    // `ans`: a staged write answers with the object it stored).
    c_key: string = 34;
    c_verb: string = 37;
  }



  // ---- stages ----

  // Hand the credential to kagi and keep the request. No branch: an absent
  // credential is NOT shortcut to a 401, so that "no credential" and "a
  // credential that did not verify" reach the same refusal by the same path.
  decision d_admit(r: Request) -> VerifyCall {
    // DISCOVERY, answered here and gone. These documents are static and
    // UNAUTHENTICATED — a client has to read them to know how to authenticate
    // at all — so they take a verdict before the credential is looked at, and
    // ride the same single path to the encoder as every other answer.
    //
    // Literals in a decision, which is exactly right: what /api/v1 says it
    // contains is API surface, and API surface is data. `kube_decode` needs
    // `passthrough = 1` for these to arrive at all.
    when r.target == "/version" ->
      VerifyCall { credential: "", c_cid: r.cid, c_method: r.method, c_key: "",
                   c_resource: "", c_name: "", c_body: "", c_namespace: "",
                   c_verdict: 200,
                   c_answer: "{\"major\":\"1\",\"minor\":\"29\",\"gitVersion\":\"v1.29.0-nanocloud\"}", ctx: ApiCtx { group: r.group, nonres: "" } };
    when r.target == "/api" ->
      VerifyCall { credential: "", c_cid: r.cid, c_method: r.method, c_key: "",
                   c_resource: "", c_name: "", c_body: "", c_namespace: "",
                   c_verdict: 200,
                   c_answer: "{\"kind\":\"APIVersions\",\"versions\":[\"v1\"]}", ctx: ApiCtx { group: r.group, nonres: "" } };
    when r.target == "/apis" ->
      VerifyCall { credential: "", c_cid: r.cid, c_method: r.method, c_key: "",
                   c_resource: "", c_name: "", c_body: "", c_namespace: "",
                   c_verdict: 200,
                   c_answer: "{\"kind\":\"APIGroupList\",\"groups\":[{\"name\":\"apps\",\"versions\":[{\"groupVersion\":\"apps/v1\",\"version\":\"v1\"}]}]}", ctx: ApiCtx { group: r.group, nonres: "" } };
    when r.target == "/api/v1" ->
      VerifyCall { credential: "", c_cid: r.cid, c_method: r.method, c_key: "",
                   c_resource: "", c_name: "", c_body: "", c_namespace: "",
                   c_verdict: 200,
                   c_answer: "{\"kind\":\"APIResourceList\",\"groupVersion\":\"v1\",\"resources\":[{\"name\":\"pods\",\"singularName\":\"pod\",\"namespaced\":true,\"shortNames\":[\"po\"],\"categories\":[\"all\"],\"kind\":\"Pod\",\"verbs\":[\"create\",\"delete\",\"get\",\"list\",\"patch\",\"update\",\"watch\"]},{\"name\":\"pods/status\",\"singularName\":\"\",\"namespaced\":true,\"kind\":\"Pod\",\"verbs\":[\"get\",\"patch\",\"update\"]},{\"name\":\"pods/log\",\"singularName\":\"\",\"namespaced\":true,\"kind\":\"Pod\",\"verbs\":[\"get\"]},{\"name\":\"services\",\"singularName\":\"service\",\"namespaced\":true,\"shortNames\":[\"svc\"],\"categories\":[\"all\"],\"kind\":\"Service\",\"verbs\":[\"create\",\"delete\",\"get\",\"list\",\"patch\",\"update\",\"watch\"]},{\"name\":\"configmaps\",\"singularName\":\"configmap\",\"namespaced\":true,\"shortNames\":[\"cm\"],\"kind\":\"ConfigMap\",\"verbs\":[\"create\",\"delete\",\"get\",\"list\",\"patch\",\"update\",\"watch\"]},{\"name\":\"secrets\",\"singularName\":\"secret\",\"namespaced\":true,\"kind\":\"Secret\",\"verbs\":[\"create\",\"delete\",\"get\",\"list\",\"patch\",\"update\",\"watch\"]},{\"name\":\"serviceaccounts\",\"singularName\":\"serviceaccount\",\"namespaced\":true,\"shortNames\":[\"sa\"],\"kind\":\"ServiceAccount\",\"verbs\":[\"create\",\"delete\",\"get\",\"list\",\"patch\",\"update\",\"watch\"]},{\"name\":\"endpoints\",\"singularName\":\"endpoints\",\"namespaced\":true,\"shortNames\":[\"ep\"],\"kind\":\"Endpoints\",\"verbs\":[\"create\",\"delete\",\"get\",\"list\",\"patch\",\"update\",\"watch\"]},{\"name\":\"events\",\"singularName\":\"event\",\"namespaced\":true,\"shortNames\":[\"ev\"],\"kind\":\"Event\",\"verbs\":[\"create\",\"delete\",\"get\",\"list\",\"patch\",\"update\",\"watch\"]},{\"name\":\"persistentvolumeclaims\",\"singularName\":\"persistentvolumeclaim\",\"namespaced\":true,\"shortNames\":[\"pvc\"],\"kind\":\"PersistentVolumeClaim\",\"verbs\":[\"create\",\"delete\",\"get\",\"list\",\"patch\",\"update\",\"watch\"]},{\"name\":\"namespaces\",\"singularName\":\"namespace\",\"namespaced\":false,\"shortNames\":[\"ns\"],\"kind\":\"Namespace\",\"verbs\":[\"create\",\"delete\",\"get\",\"list\",\"patch\",\"update\",\"watch\"]},{\"name\":\"nodes\",\"singularName\":\"node\",\"namespaced\":false,\"shortNames\":[\"no\"],\"kind\":\"Node\",\"verbs\":[\"create\",\"delete\",\"get\",\"list\",\"patch\",\"update\",\"watch\"]},{\"name\":\"nodes/status\",\"singularName\":\"\",\"namespaced\":false,\"kind\":\"Node\",\"verbs\":[\"get\",\"patch\",\"update\"]},{\"name\":\"persistentvolumes\",\"singularName\":\"persistentvolume\",\"namespaced\":false,\"shortNames\":[\"pv\"],\"kind\":\"PersistentVolume\",\"verbs\":[\"create\",\"delete\",\"get\",\"list\",\"patch\",\"update\",\"watch\"]}]}", ctx: ApiCtx { group: r.group, nonres: "" } };
    when r.target == "/apis/apps/v1" ->
      VerifyCall { credential: "", c_cid: r.cid, c_method: r.method, c_key: "",
                   c_resource: "", c_name: "", c_body: "", c_namespace: "",
                   c_verdict: 200,
                   c_answer: "{\"kind\":\"APIResourceList\",\"groupVersion\":\"apps/v1\",\"resources\":[{\"name\":\"deployments\",\"singularName\":\"deployment\",\"namespaced\":true,\"shortNames\":[\"deploy\"],\"categories\":[\"all\"],\"kind\":\"Deployment\",\"verbs\":[\"create\",\"delete\",\"get\",\"list\",\"patch\",\"update\",\"watch\"]},{\"name\":\"deployments/scale\",\"singularName\":\"\",\"namespaced\":true,\"group\":\"autoscaling\",\"version\":\"v1\",\"kind\":\"Scale\",\"verbs\":[\"get\",\"patch\",\"update\"]},{\"name\":\"deployments/status\",\"singularName\":\"\",\"namespaced\":true,\"kind\":\"Deployment\",\"verbs\":[\"get\",\"patch\",\"update\"]},{\"name\":\"replicasets\",\"singularName\":\"replicaset\",\"namespaced\":true,\"shortNames\":[\"rs\"],\"categories\":[\"all\"],\"kind\":\"ReplicaSet\",\"verbs\":[\"create\",\"delete\",\"get\",\"list\",\"patch\",\"update\",\"watch\"]},{\"name\":\"replicasets/scale\",\"singularName\":\"\",\"namespaced\":true,\"group\":\"autoscaling\",\"version\":\"v1\",\"kind\":\"Scale\",\"verbs\":[\"get\",\"patch\",\"update\"]},{\"name\":\"replicasets/status\",\"singularName\":\"\",\"namespaced\":true,\"kind\":\"ReplicaSet\",\"verbs\":[\"get\",\"patch\",\"update\"]},{\"name\":\"statefulsets\",\"singularName\":\"statefulset\",\"namespaced\":true,\"shortNames\":[\"sts\"],\"categories\":[\"all\"],\"kind\":\"StatefulSet\",\"verbs\":[\"create\",\"delete\",\"get\",\"list\",\"patch\",\"update\",\"watch\"]},{\"name\":\"statefulsets/scale\",\"singularName\":\"\",\"namespaced\":true,\"group\":\"autoscaling\",\"version\":\"v1\",\"kind\":\"Scale\",\"verbs\":[\"get\",\"patch\",\"update\"]},{\"name\":\"statefulsets/status\",\"singularName\":\"\",\"namespaced\":true,\"kind\":\"StatefulSet\",\"verbs\":[\"get\",\"patch\",\"update\"]},{\"name\":\"daemonsets\",\"singularName\":\"daemonset\",\"namespaced\":true,\"shortNames\":[\"ds\"],\"categories\":[\"all\"],\"kind\":\"DaemonSet\",\"verbs\":[\"create\",\"delete\",\"get\",\"list\",\"patch\",\"update\",\"watch\"]}]}", ctx: ApiCtx { group: r.group, nonres: "" } };

    // OpenAPI v3: the root and one document per group-version. Each PATCH
    // path names its kind (x-kubernetes-group-version-kind) and takes the
    // `fieldValidation` query parameter — what kubectl checks to hand
    // validation to the server instead of downloading schemas (it sends
    // fieldValidation; this server accepts any known kind's fields). No
    // /openapi/v2: a stub there answered JSON where kubectl asks for
    // protobuf, and failed every validating apply. `/metrics` is a static
    // liveness gauge; richer metrics ride fluxor's own telemetry.
    when r.target == "/openapi/v3" ->
      VerifyCall { credential: "", c_cid: r.cid, c_method: r.method, c_key: "",
                   c_resource: "", c_name: "", c_body: "", c_namespace: "",
                   c_verdict: 200,
                   c_answer: "{\"paths\":{\"api/v1\":{\"serverRelativeURL\":\"/openapi/v3/api/v1\"},\"apis/apps/v1\":{\"serverRelativeURL\":\"/openapi/v3/apis/apps/v1\"}}}",
                   c_watch: 0, ctx: ApiCtx { group: r.group, nonres: "" } };
    when r.target == "/openapi/v3/api/v1" ->
      VerifyCall { credential: "", c_cid: r.cid, c_method: r.method, c_key: "",
                   c_resource: "", c_name: "", c_body: "", c_namespace: "",
                   c_verdict: 200,
                   c_answer: "{\"openapi\":\"3.0.0\",\"info\":{\"title\":\"Kubernetes\",\"version\":\"v1\"},\"paths\":{\"/api/v1/namespaces/{namespace}/pods/{name}\":{\"patch\":{\"x-kubernetes-group-version-kind\":{\"group\":\"\",\"version\":\"v1\",\"kind\":\"Pod\"},\"parameters\":[{\"name\":\"fieldValidation\",\"in\":\"query\",\"schema\":{\"type\":\"string\"}}],\"responses\":{\"200\":{\"description\":\"OK\"}}}},\"/api/v1/namespaces/{namespace}/services/{name}\":{\"patch\":{\"x-kubernetes-group-version-kind\":{\"group\":\"\",\"version\":\"v1\",\"kind\":\"Service\"},\"parameters\":[{\"name\":\"fieldValidation\",\"in\":\"query\",\"schema\":{\"type\":\"string\"}}],\"responses\":{\"200\":{\"description\":\"OK\"}}}},\"/api/v1/namespaces/{namespace}/configmaps/{name}\":{\"patch\":{\"x-kubernetes-group-version-kind\":{\"group\":\"\",\"version\":\"v1\",\"kind\":\"ConfigMap\"},\"parameters\":[{\"name\":\"fieldValidation\",\"in\":\"query\",\"schema\":{\"type\":\"string\"}}],\"responses\":{\"200\":{\"description\":\"OK\"}}}},\"/api/v1/namespaces/{namespace}/secrets/{name}\":{\"patch\":{\"x-kubernetes-group-version-kind\":{\"group\":\"\",\"version\":\"v1\",\"kind\":\"Secret\"},\"parameters\":[{\"name\":\"fieldValidation\",\"in\":\"query\",\"schema\":{\"type\":\"string\"}}],\"responses\":{\"200\":{\"description\":\"OK\"}}}},\"/api/v1/namespaces/{namespace}/serviceaccounts/{name}\":{\"patch\":{\"x-kubernetes-group-version-kind\":{\"group\":\"\",\"version\":\"v1\",\"kind\":\"ServiceAccount\"},\"parameters\":[{\"name\":\"fieldValidation\",\"in\":\"query\",\"schema\":{\"type\":\"string\"}}],\"responses\":{\"200\":{\"description\":\"OK\"}}}},\"/api/v1/namespaces/{namespace}/endpoints/{name}\":{\"patch\":{\"x-kubernetes-group-version-kind\":{\"group\":\"\",\"version\":\"v1\",\"kind\":\"Endpoints\"},\"parameters\":[{\"name\":\"fieldValidation\",\"in\":\"query\",\"schema\":{\"type\":\"string\"}}],\"responses\":{\"200\":{\"description\":\"OK\"}}}},\"/api/v1/namespaces/{namespace}/events/{name}\":{\"patch\":{\"x-kubernetes-group-version-kind\":{\"group\":\"\",\"version\":\"v1\",\"kind\":\"Event\"},\"parameters\":[{\"name\":\"fieldValidation\",\"in\":\"query\",\"schema\":{\"type\":\"string\"}}],\"responses\":{\"200\":{\"description\":\"OK\"}}}},\"/api/v1/namespaces/{namespace}/persistentvolumeclaims/{name}\":{\"patch\":{\"x-kubernetes-group-version-kind\":{\"group\":\"\",\"version\":\"v1\",\"kind\":\"PersistentVolumeClaim\"},\"parameters\":[{\"name\":\"fieldValidation\",\"in\":\"query\",\"schema\":{\"type\":\"string\"}}],\"responses\":{\"200\":{\"description\":\"OK\"}}}},\"/api/v1/namespaces/{name}\":{\"patch\":{\"x-kubernetes-group-version-kind\":{\"group\":\"\",\"version\":\"v1\",\"kind\":\"Namespace\"},\"parameters\":[{\"name\":\"fieldValidation\",\"in\":\"query\",\"schema\":{\"type\":\"string\"}}],\"responses\":{\"200\":{\"description\":\"OK\"}}}},\"/api/v1/nodes/{name}\":{\"patch\":{\"x-kubernetes-group-version-kind\":{\"group\":\"\",\"version\":\"v1\",\"kind\":\"Node\"},\"parameters\":[{\"name\":\"fieldValidation\",\"in\":\"query\",\"schema\":{\"type\":\"string\"}}],\"responses\":{\"200\":{\"description\":\"OK\"}}}},\"/api/v1/persistentvolumes/{name}\":{\"patch\":{\"x-kubernetes-group-version-kind\":{\"group\":\"\",\"version\":\"v1\",\"kind\":\"PersistentVolume\"},\"parameters\":[{\"name\":\"fieldValidation\",\"in\":\"query\",\"schema\":{\"type\":\"string\"}}],\"responses\":{\"200\":{\"description\":\"OK\"}}}}}}",
                   c_watch: 0, ctx: ApiCtx { group: r.group, nonres: "" } };
    when r.target == "/openapi/v3/apis/apps/v1" ->
      VerifyCall { credential: "", c_cid: r.cid, c_method: r.method, c_key: "",
                   c_resource: "", c_name: "", c_body: "", c_namespace: "",
                   c_verdict: 200,
                   c_answer: "{\"openapi\":\"3.0.0\",\"info\":{\"title\":\"Kubernetes\",\"version\":\"v1\"},\"paths\":{\"/apis/apps/v1/namespaces/{namespace}/deployments/{name}\":{\"patch\":{\"x-kubernetes-group-version-kind\":{\"group\":\"apps\",\"version\":\"v1\",\"kind\":\"Deployment\"},\"parameters\":[{\"name\":\"fieldValidation\",\"in\":\"query\",\"schema\":{\"type\":\"string\"}}],\"responses\":{\"200\":{\"description\":\"OK\"}}}},\"/apis/apps/v1/namespaces/{namespace}/replicasets/{name}\":{\"patch\":{\"x-kubernetes-group-version-kind\":{\"group\":\"apps\",\"version\":\"v1\",\"kind\":\"ReplicaSet\"},\"parameters\":[{\"name\":\"fieldValidation\",\"in\":\"query\",\"schema\":{\"type\":\"string\"}}],\"responses\":{\"200\":{\"description\":\"OK\"}}}},\"/apis/apps/v1/namespaces/{namespace}/statefulsets/{name}\":{\"patch\":{\"x-kubernetes-group-version-kind\":{\"group\":\"apps\",\"version\":\"v1\",\"kind\":\"StatefulSet\"},\"parameters\":[{\"name\":\"fieldValidation\",\"in\":\"query\",\"schema\":{\"type\":\"string\"}}],\"responses\":{\"200\":{\"description\":\"OK\"}}}},\"/apis/apps/v1/namespaces/{namespace}/daemonsets/{name}\":{\"patch\":{\"x-kubernetes-group-version-kind\":{\"group\":\"apps\",\"version\":\"v1\",\"kind\":\"DaemonSet\"},\"parameters\":[{\"name\":\"fieldValidation\",\"in\":\"query\",\"schema\":{\"type\":\"string\"}}],\"responses\":{\"200\":{\"description\":\"OK\"}}}}}}",
                   c_watch: 0, ctx: ApiCtx { group: r.group, nonres: "" } };
    // `/metrics` is guarded by RBAC's nonResourceURLs, as upstream: the
    // request is authenticated, then probed as `~|get|~|/metrics|~`, and the
    // document is answered only when that is granted (d_gate).
    when r.target == "/metrics" ->
      VerifyCall { credential: r.credential, c_cid: r.cid, c_method: r.method, c_key: "",
                   c_resource: "", c_name: "", c_body: "", c_namespace: "",
                   c_verdict: PENDING, c_answer: "", c_watch: 0,
                   ctx: ApiCtx { group: "~", nonres: "/metrics" } };
    when r.target == "/healthz" ->
      VerifyCall { credential: "", c_cid: r.cid, c_method: r.method, c_key: "",
                   c_resource: "", c_name: "", c_body: "", c_namespace: "",
                   c_verdict: 200, c_answer: "ok", c_watch: 0, ctx: ApiCtx { group: r.group, nonres: "" } };

    // A path that is neither a resource nor a document this server knows. Under
    // `passthrough` it arrives here with an empty key, and answering 404 is the
    // whole reason passthrough is safe: the frame's empty fields are never read
    // as a resource.
    when r.key == "" ->
      VerifyCall { credential: "", c_cid: r.cid, c_method: r.method, c_key: "",
                   c_resource: "", c_name: "", c_body: "", c_namespace: "",
                   c_verdict: 404, c_answer: "not found", c_watch: 0, ctx: ApiCtx { group: r.group, nonres: "" } };

    // An mTLS PEER is already authenticated: fluxor's `tls` validated the
    // chain and proved key possession, and the envelope carries a peer only
    // when both ran. Re-checking it against kagi would be checking a bearer token that
    // does not exist, so the identity is taken here and the verify stage is
    // skipped with an OK verdict — `PEER_OK` rather than PENDING, so `authz`
    // authorises the peer's name instead of waiting for a token.
    //
    // The identity is `peer:<hex>`, distinct from a ServiceAccount's
    // `system:serviceaccount:…` by construction: two authentication methods
    // must not be able to produce the same subject string, or a binding
    // written for one silently grants the other.
    when r.peer != "" ->
      VerifyCall {
        credential: "", c_cid: r.cid, c_method: r.method, c_key: r.key,
        c_resource: r.resource, c_name: r.name, c_body: r.body,
        c_namespace: r.namespace, c_verdict: PEER_OK, c_answer: r.peer,
        c_watch: r.watch, ctx: ApiCtx { group: r.group, nonres: "" } };

    // The ordinary path: hand the credential to kagi and keep the request. No
    // branch on an absent credential, so that "no credential" and "a credential
    // that did not verify" reach the same refusal by the same path.
    default ->
      VerifyCall {
        credential: r.credential,
        c_cid: r.cid, c_method: r.method, c_key: r.key,
        c_resource: r.resource, c_name: r.name, c_body: r.body,
        c_namespace: r.namespace, c_verdict: PENDING, c_answer: "",
        c_watch: r.watch, ctx: ApiCtx { group: r.group, nonres: "" } };
  }

  // Normalise WHO the caller is, before the verb ladder runs.
  //
  // Two authentication methods reach this point: a bearer token kagi verified
  // (its `subject`), and an mTLS peer the TLS layer authenticated (carried as
  // `c_answer` with the `PEER_OK` verdict). The verb a request wants is a
  // property of the REQUEST — method, name, watch — and has nothing to do with
  // which of the two authenticated it, so selecting the identity HERE keeps one
  // verb ladder instead of one per identity source.
  //
  // That is not only tidier. Duplicating the ladder made the decision silently
  // stop producing records — no author error, no load error, just a request
  // that never came back — so the duplicated form is also the one that does not
  // work (.context/chronicle.md §32).
  decision d_ident(v: Verified) -> Verified {
    when v.c_verdict == PEER_OK ->
      Verified { corr: v.corr, status: V_OK, subject: v.c_answer,
                 c_cid: v.c_cid, c_method: v.c_method, c_key: v.c_key,
                 c_resource: v.c_resource, c_name: v.c_name, c_body: v.c_body,
                 c_namespace: v.c_namespace, c_verdict: PENDING, c_answer: "",
                 c_watch: v.c_watch, ctx: v.ctx };
    default ->
      Verified { corr: v.corr, status: v.status, subject: v.subject,
                 c_cid: v.c_cid, c_method: v.c_method, c_key: v.c_key,
                 c_resource: v.c_resource, c_name: v.c_name, c_body: v.c_body,
                 c_namespace: v.c_namespace, c_verdict: v.c_verdict,
                 c_answer: v.c_answer, c_watch: v.c_watch, ctx: v.ctx };
  }

  // Authentication's verdict, and the verb. The verb is (method, is-collection):
  // a GET with no name is a LIST, and a POST is a create regardless. Deciding
  // that here is the point — it is the REST convention, and a convention is
  // meaning.
  //
  // A refused credential still passes the authorization stage, carrying its
  // verdict with a NOOP probe: a single path through the graph instead of two,
  // which is the trade this chain makes everywhere.
  decision d_authz(v: Verified) -> AuthzCall {
    // Already decided upstream — a discovery document, or a path this server
    // does not serve. It rides through untouched, which is what keeps there
    // being ONE way to the encoder.
    when v.c_verdict != PENDING ->
      AuthzCall { op: OP_NOOP, identity: "", k1: "", ns: "", k3: "", verb: "", k5: "", resource: "",
                  c_cid: v.c_cid, c_method: v.c_method, c_key: v.c_key,
                  c_verdict: v.c_verdict, c_name: v.c_name, c_body: v.c_body,
                  c_reason: v.c_answer, c_verb: "", c_resource: "",
                  c_namespace: "", k7: "", res: "", k9: "", name: "", ctx: v.ctx };
    when v.status == V_NO_KEY ->
      AuthzCall { op: OP_NOOP, identity: "", k1: "", ns: "", k3: "", verb: "", k5: "", resource: "",
                  c_cid: v.c_cid, c_method: v.c_method, c_key: v.c_key,
                  c_verdict: 503, c_name: v.c_name, c_body: v.c_body,
                  c_reason: "{\"kind\":\"Status\",\"apiVersion\":\"v1\",\"metadata\":{},\"status\":\"Failure\",\"reason\":\"ServiceUnavailable\",\"code\":503,\"message\":\"no verification key\"}", c_verb: "", c_resource: "", c_namespace: "", k7: "", res: "", k9: "", name: "", ctx: v.ctx };
    when v.status == V_MALFORMED ->
      AuthzCall { op: OP_NOOP, identity: "", k1: "", ns: "", k3: "", verb: "", k5: "", resource: "",
                  c_cid: v.c_cid, c_method: v.c_method, c_key: v.c_key,
                  c_verdict: 401, c_name: v.c_name, c_body: v.c_body,
                  c_reason: "{\"kind\":\"Status\",\"apiVersion\":\"v1\",\"metadata\":{},\"status\":\"Failure\",\"reason\":\"Unauthorized\",\"code\":401,\"message\":\"no usable credential\"}", c_verb: "", c_resource: "", c_namespace: "", k7: "", res: "", k9: "", name: "", ctx: v.ctx };
    when v.status == V_EXPIRED ->
      AuthzCall { op: OP_NOOP, identity: "", k1: "", ns: "", k3: "", verb: "", k5: "", resource: "",
                  c_cid: v.c_cid, c_method: v.c_method, c_key: v.c_key,
                  c_verdict: 401, c_name: v.c_name, c_body: v.c_body,
                  c_reason: "{\"kind\":\"Status\",\"apiVersion\":\"v1\",\"metadata\":{},\"status\":\"Failure\",\"reason\":\"Unauthorized\",\"code\":401,\"message\":\"credential expired\"}", c_verb: "", c_resource: "", c_namespace: "", k7: "", res: "", k9: "", name: "", ctx: v.ctx };
    when v.status != V_OK ->
      AuthzCall { op: OP_NOOP, identity: "", k1: "", ns: "", k3: "", verb: "", k5: "", resource: "",
                  c_cid: v.c_cid, c_method: v.c_method, c_key: v.c_key,
                  c_verdict: 401, c_name: v.c_name, c_body: v.c_body,
                  c_reason: "{\"kind\":\"Status\",\"apiVersion\":\"v1\",\"metadata\":{},\"status\":\"Failure\",\"reason\":\"Unauthorized\",\"code\":401,\"message\":\"credential rejected\"}", c_verb: "", c_resource: "", c_namespace: "", k7: "", res: "", k9: "", name: "", ctx: v.ctx };
    // A non-resource path RBAC guards (`/metrics`): its grant is
    // `~|get|~|<path>|~`, where `~` is a literal no wildcard widens.
    when v.ctx.nonres != "" ->
      AuthzCall { op: OP_EXISTS_ANY, identity: v.subject, k1: "/", ns: "~", k3: "|", verb: "get", k5: "|", resource: "~", k7: "|", res: v.ctx.nonres, k9: "|", name: "~",
                  c_cid: v.c_cid, c_method: v.c_method, c_key: v.c_key,
                  c_verdict: PENDING, c_name: v.c_name, c_body: v.c_body,
                  c_reason: "", c_verb: "get",
                  c_resource: v.c_resource, c_namespace: v.c_namespace, ctx: v.ctx };
    when v.c_method == M_POST ->
      AuthzCall { op: OP_EXISTS_ANY, identity: v.subject, k1: "/", ns: v.c_namespace, k3: "|", verb: "create", k5: "|", resource: v.ctx.group, k7: "|", res: v.c_resource, k9: "|", name: "*",
                  c_cid: v.c_cid, c_method: v.c_method, c_key: v.c_key,
                  c_verdict: PENDING, c_name: v.c_name, c_body: v.c_body,
                  c_reason: "", c_verb: "create",
                  c_resource: v.c_resource, c_namespace: v.c_namespace, ctx: v.ctx };
    when v.c_method == M_PUT ->
      AuthzCall { op: OP_EXISTS_ANY, identity: v.subject, k1: "/", ns: v.c_namespace, k3: "|", verb: "update", k5: "|", resource: v.ctx.group, k7: "|", res: v.c_resource, k9: "|", name: v.c_name,
                  c_cid: v.c_cid, c_method: v.c_method, c_key: v.c_key,
                  c_verdict: PENDING, c_name: v.c_name, c_body: v.c_body,
                  c_reason: "", c_verb: "update",
                  c_resource: v.c_resource, c_namespace: v.c_namespace, ctx: v.ctx };
    // `patch` is its own RBAC verb upstream; admission still sees an UPDATE.
    when v.c_method == M_PATCH || v.c_method == M_PATCH_JSON || v.c_method == M_PATCH_SMP
         || v.c_method == M_PATCH_APPLY ->
      AuthzCall { op: OP_EXISTS_ANY, identity: v.subject, k1: "/", ns: v.c_namespace, k3: "|", verb: "patch", k5: "|", resource: v.ctx.group, k7: "|", res: v.c_resource, k9: "|", name: v.c_name,
                  c_cid: v.c_cid, c_method: v.c_method, c_key: v.c_key,
                  c_verdict: PENDING, c_name: v.c_name, c_body: v.c_body,
                  c_reason: "", c_verb: "update",
                  c_resource: v.c_resource, c_namespace: v.c_namespace, ctx: v.ctx };
    when v.c_method == M_DELETE ->
      AuthzCall { op: OP_EXISTS_ANY, identity: v.subject, k1: "/", ns: v.c_namespace, k3: "|", verb: "delete", k5: "|", resource: v.ctx.group, k7: "|", res: v.c_resource, k9: "|", name: v.c_name,
                  c_cid: v.c_cid, c_method: v.c_method, c_key: v.c_key,
                  c_verdict: PENDING, c_name: v.c_name, c_body: v.c_body,
                  c_reason: "", c_verb: "delete",
                  c_resource: v.c_resource, c_namespace: v.c_namespace, ctx: v.ctx };
    // `watch` is a distinct Kubernetes RBAC verb, not a flavour of `list`, so
    // a role that grants list does NOT grant watch. Deciding that here is the
    // point: it is API semantics, and API semantics are data.
    when v.c_watch == 1 ->
      AuthzCall { op: OP_EXISTS_ANY, identity: v.subject, k1: "/", ns: v.c_namespace, k3: "|", verb: "watch", k5: "|", resource: v.ctx.group, k7: "|", res: v.c_resource, k9: "|", name: "*",
                  c_cid: v.c_cid, c_method: v.c_method, c_key: v.c_key,
                  c_verdict: PENDING, c_name: v.c_name, c_body: v.c_body,
                  c_reason: "", c_verb: "watch",
                  c_resource: v.c_resource, c_namespace: v.c_namespace, ctx: v.ctx };
    when v.c_name == "" ->
      AuthzCall { op: OP_EXISTS_ANY, identity: v.subject, k1: "/", ns: v.c_namespace, k3: "|", verb: "list", k5: "|", resource: v.ctx.group, k7: "|", res: v.c_resource, k9: "|", name: "*",
                  c_cid: v.c_cid, c_method: v.c_method, c_key: v.c_key,
                  c_verdict: PENDING, c_name: v.c_name, c_body: v.c_body,
                  c_reason: "", c_verb: "list",
                  c_resource: v.c_resource, c_namespace: v.c_namespace, ctx: v.ctx };
    default ->
      AuthzCall { op: OP_EXISTS_ANY, identity: v.subject, k1: "/", ns: v.c_namespace, k3: "|", verb: "get", k5: "|", resource: v.ctx.group, k7: "|", res: v.c_resource, k9: "|", name: v.c_name,
                  c_cid: v.c_cid, c_method: v.c_method, c_key: v.c_key,
                  c_verdict: PENDING, c_name: v.c_name, c_body: v.c_body,
                  c_reason: "", c_verb: "get",
                  c_resource: v.c_resource, c_namespace: v.c_namespace, ctx: v.ctx };
  }

  // Authorization's verdict becomes an admission call. A refusal still passes
  // through — one path, not two — with an empty verb, so admission skips it.
  //
  // Only create and update present an object. A delete has none, a read has
  // none, and handing admission an empty object under a policy with a required
  // field would refuse a request that was never malformed.
  decision d_gate(a: Authzed) -> AdmitCall {
    when a.c_verdict != PENDING ->
      AdmitCall { verb: "", resource: "", namespace: "", object: a.c_body,
                  c_cid: a.c_cid, c_method: a.c_method, c_key: a.c_key,
                  c_verdict: a.c_verdict, c_name: a.c_name, c_reason: a.c_reason,
                  c_verb: a.c_verb };
    when a.granted != 200 ->
      AdmitCall { verb: "", resource: "", namespace: "", object: a.c_body,
                  c_cid: a.c_cid, c_method: a.c_method, c_key: a.c_key,
                  c_verdict: 403, c_name: a.c_name, c_reason: "{\"kind\":\"Status\",\"apiVersion\":\"v1\",\"metadata\":{},\"status\":\"Failure\",\"reason\":\"Forbidden\",\"code\":403,\"message\":\"forbidden\"}",
                  c_verb: a.c_verb };
    // A granted `/metrics` is answered here: a static document, served only
    // to a caller RBAC's nonResourceURLs allows.
    when a.ctx.nonres == "/metrics" ->
      AdmitCall { verb: "", resource: "", namespace: "", object: "",
                  c_cid: a.c_cid, c_method: a.c_method, c_key: a.c_key,
                  c_verdict: 200, c_name: a.c_name,
                  c_reason: "# HELP nanocloud_apiserver_up API server is serving.\n# TYPE nanocloud_apiserver_up gauge\nnanocloud_apiserver_up 1\n",
                  c_verb: a.c_verb };
    when a.c_verb == "create" ->
      AdmitCall { verb: "create", resource: a.c_resource, namespace: a.c_namespace,
                  object: a.c_body,
                  c_cid: a.c_cid, c_method: a.c_method, c_key: a.c_key,
                  c_verdict: PENDING, c_name: a.c_name, c_reason: "",
                  c_verb: a.c_verb };
    when a.c_verb == "update" ->
      AdmitCall { verb: "update", resource: a.c_resource, namespace: a.c_namespace,
                  object: a.c_body,
                  c_cid: a.c_cid, c_method: a.c_method, c_key: a.c_key,
                  c_verdict: PENDING, c_name: a.c_name, c_reason: "",
                  c_verb: a.c_verb };
    default ->
      AdmitCall { verb: "", resource: "", namespace: "", object: a.c_body,
                  c_cid: a.c_cid, c_method: a.c_method, c_key: a.c_key,
                  c_verdict: PENDING, c_name: a.c_name, c_reason: "",
                  c_verb: a.c_verb };
  }

  // The read that every verb needs. A GET reads the object; a collection GET
  // LISTs the prefix; a create/update/delete reads first so the ACT stage knows
  // whether the object was there — which is the whole difference between 201
  // and 409, and between 200 and 404.
  // The WRITE happens here, where the object is in the record: the store
  // decides what upstream decides from state — 409 for a create that exists,
  // 404 for a replace, patch or delete of nothing, 409 for a stale
  // resourceVersion — so nothing is probed first and the request body never
  // rides the carry (`act` answers from the store's reply). A read registers
  // itself with the watch chain, which answers it.
  decision d_probe(a: Admitted) -> ActCall {
    when a.c_verdict != PENDING ->
      ActCall { cid: a.c_cid, op: OP_NOOP, key: "", key2: "", value: "",
                c_cid: a.c_cid, c_status: a.c_verdict, c_answer: a.c_reason, c_stream: 0, c_key: a.c_key, c_verb: a.c_verb };
    // Admission refused. Its `object` is the REASON in that case, which is why
    // it becomes the answer rather than the body of a write.
    when a.status != 200 ->
      ActCall { cid: a.c_cid, op: OP_NOOP, key: "", key2: "", value: "",
                c_cid: a.c_cid, c_status: a.status, c_answer: a.object, c_stream: 0, c_key: a.c_key, c_verb: a.c_verb };
    // A ConfigMap or Secret holds at most 1 MiB of data (upstream's bound, so
    // an object always fits etcd's request limit). Only a staged body can
    // pass it — an inline one is a record at most.
    when (a.c_verb == "create" || a.c_verb == "update")
         && (a.c_key.startsWith("/configmaps/") || a.c_key.startsWith("/secrets/"))
         && a.dsize + a.bsize > 1048576 ->
      ActCall { cid: a.c_cid, op: OP_NOOP, key: "", key2: "", value: "",
                c_cid: a.c_cid, c_status: 422, c_answer: "{\"kind\":\"Status\",\"apiVersion\":\"v1\",\"metadata\":{},\"status\":\"Failure\",\"message\":\"data: Too long: may not be more than 1048576 bytes\",\"reason\":\"Invalid\",\"code\":422}", c_stream: 0, c_key: a.c_key, c_verb: a.c_verb };
    // A WATCH. The response opens empty and stays open; its events come from
    // the watch chain (apiplane_watch.uproc) out of the store's change feed.
    // A streaming list (`sendInitialEvents`) is not served: refuse it, and a
    // client falls back to list-then-watch.
    when a.c_verb == "watch" && a.object.contains("\"sie\":\"true\"") ->
      ActCall { cid: a.c_cid, op: OP_NOOP, key: "", key2: "", value: "",
                c_cid: a.c_cid, c_status: 400, c_answer: "{\"kind\":\"Status\",\"apiVersion\":\"v1\",\"metadata\":{},\"status\":\"Failure\",\"reason\":\"BadRequest\",\"code\":400,\"message\":\"sendInitialEvents is not supported\"}", c_stream: 0, c_key: a.c_key, c_verb: a.c_verb };
    // The registration: this connection, the collection, and the facts
    // kube_facts.rd put in the body slot. `c_stream` holds the response open.
    when a.c_verb == "watch" ->
      ActCall { cid: a.c_cid, op: OP_PUT, key: "/watch-reg/", key2: "", kcid: a.c_cid,
                value: "{\"cid\":", value2: a.c_cid, value3: ",\"p\":\"", value4: a.c_key,
                value5: "\",", value6: a.object.substring(1),
                c_cid: a.c_cid, c_status: 200, c_answer: "", c_stream: 5, c_key: a.c_key, c_verb: a.c_verb };
    // A LIST or a GET: registered the same way and answered by the watch
    // chain, so this chain sends nothing (`c_status: 0`).
    when a.c_verb == "list" || a.c_verb == "get" ->
      ActCall { cid: a.c_cid, op: OP_PUT, key: "/watch-reg/", key2: "", kcid: a.c_cid,
                value: "{\"cid\":", value2: a.c_cid, value3: ",\"p\":\"", value4: a.c_key,
                value5: "\",", value6: a.object.substring(1),
                c_cid: a.c_cid, c_status: 0, c_answer: "", c_stream: 0, c_key: a.c_key, c_verb: a.c_verb };
    // A create: CREATE (the store refuses an existing object: AlreadyExists).
    // A STAGED body's name came from se_body and completes the key (empty for
    // an inline one, which kube_decode addressed already) — before the
    // write's marks after `#`. Answered with the
    // object AS STORED ("@stored"): stamped, with its revision.
    when a.c_method == M_POST ->
      ActCall { cid: a.c_cid, op: OP_CREATE, key: a.c_key.substring(0, (a.c_key.indexOf("#") + (a.c_key.size() + 1) * (1 - math.least(1, a.c_key.indexOf("#") + 1)))) + a.name + a.c_key.substring((a.c_key.indexOf("#") + (a.c_key.size() + 1) * (1 - math.least(1, a.c_key.indexOf("#") + 1)))), key2: "", value: a.object,
                c_cid: a.c_cid, c_status: 201, c_answer: "@stored", c_stream: 0, c_key: a.c_key.substring(0, (a.c_key.indexOf("#") + (a.c_key.size() + 1) * (1 - math.least(1, a.c_key.indexOf("#") + 1)))) + a.name + a.c_key.substring((a.c_key.indexOf("#") + (a.c_key.size() + 1) * (1 - math.least(1, a.c_key.indexOf("#") + 1)))), c_verb: a.c_verb };
    when a.c_method == M_DELETE ->
      ActCall { cid: a.c_cid, op: OP_DELETE, key: a.c_key, key2: "", value: a.object,
                c_cid: a.c_cid, c_status: 200, c_answer: "{\"kind\":\"Status\",\"apiVersion\":\"v1\",\"metadata\":{},\"status\":\"Success\"}", c_stream: 0, c_key: a.c_key, c_verb: a.c_verb };
    // REPLACE: conditional on the resourceVersion the client read, when it
    // sends one (a stale one is 409 Conflict and the client re-reads).
    when a.c_method == M_PUT ->
      ActCall { cid: a.c_cid, op: OP_REPLACE, key: a.c_key, key2: "", value: a.object,
                c_cid: a.c_cid, c_status: 200, c_answer: "@stored", c_stream: 0, c_key: a.c_key, c_verb: a.c_verb };
    // A PATCH is applied where the object is (the store reads, patches and
    // conditionally writes it, retrying a lost race). Server-side apply
    // creates an absent object, merges strategically into a present one.
    when a.c_method == M_PATCH ->
      ActCall { cid: a.c_cid, op: OP_PATCH_MERGE, key: a.c_key, key2: "", value: a.object,
                c_cid: a.c_cid, c_status: 200, c_answer: "@stored", c_stream: 0, c_key: a.c_key, c_verb: a.c_verb };
    when a.c_method == M_PATCH_JSON ->
      ActCall { cid: a.c_cid, op: OP_PATCH_JSON, key: a.c_key, key2: "", value: a.object,
                c_cid: a.c_cid, c_status: 200, c_answer: "@stored", c_stream: 0, c_key: a.c_key, c_verb: a.c_verb };
    when a.c_method == M_PATCH_SMP ->
      ActCall { cid: a.c_cid, op: OP_PATCH_SMP, key: a.c_key, key2: "", value: a.object,
                c_cid: a.c_cid, c_status: 200, c_answer: "@stored", c_stream: 0, c_key: a.c_key, c_verb: a.c_verb };
    when a.c_method == M_PATCH_APPLY ->
      ActCall { cid: a.c_cid, op: OP_APPLY, key: a.c_key, key2: "", value: a.object,
                c_cid: a.c_cid, c_status: 200, c_answer: "@stored", c_stream: 0, c_key: a.c_key, c_verb: a.c_verb };
    default ->
      ActCall { cid: a.c_cid, op: OP_NOOP, key: "", key2: "", value: "",
                c_cid: a.c_cid, c_status: 405, c_answer: "{\"kind\":\"Status\",\"apiVersion\":\"v1\",\"metadata\":{},\"status\":\"Failure\",\"reason\":\"MethodNotAllowed\",\"code\":405}", c_stream: 0, c_key: a.c_key, c_verb: a.c_verb };
  }






  // ---- identity stages (a codec-only node has no program and fails CLOSED) ----

  // EVERY field, including `watch` and `peer`. A pass stage that drops one is
  // not a smaller record — the decision after it reads a field that is not
  // there and produces nothing at all, silently. This copy must grow with the
  // message.
  transformation pass_req(r: Request) -> Request {
    Request { cid: r.cid, method: r.method, resource: r.resource,
              namespace: r.namespace, name: r.name, body: r.body,
              key: r.key, credential: r.credential, target: r.target,
              watch: r.watch, peer: r.peer }
  }
  transformation pass_verified(v: Verified) -> Verified {
    Verified { corr: v.corr, status: v.status, subject: v.subject,
               c_cid: v.c_cid, c_method: v.c_method, c_key: v.c_key,
               c_resource: v.c_resource, c_name: v.c_name, c_body: v.c_body,
               c_namespace: v.c_namespace, c_verdict: v.c_verdict,
               c_answer: v.c_answer, c_watch: v.c_watch, ctx: v.ctx }
  }
  transformation pass_authzed(a: Authzed) -> Authzed {
    Authzed { granted: a.granted, c_cid: a.c_cid, c_method: a.c_method,
              c_key: a.c_key, c_verdict: a.c_verdict, c_name: a.c_name,
              c_body: a.c_body, c_reason: a.c_reason, c_verb: a.c_verb,
              c_resource: a.c_resource, c_namespace: a.c_namespace, ctx: a.ctx }
  }
  transformation pass_admitted(a: Admitted) -> Admitted {
    Admitted { name: a.name, status: a.status, object: a.object, c_cid: a.c_cid,
               c_method: a.c_method, c_key: a.c_key, c_verdict: a.c_verdict,
               c_name: a.c_name, c_reason: a.c_reason, c_verb: a.c_verb }
  }


  pipeline admit(r: Request) -> VerifyCall {
    call x = pass_req(r);
    call y = d_admit(x);
    return y;
  }
  pipeline ident(v: Verified) -> Verified {
    call x = pass_verified(v);
    call y = d_ident(x);
    return y;
  }
  pipeline authz(v: Verified) -> AuthzCall {
    call x = pass_verified(v);
    call y = d_authz(x);
    return y;
  }
  pipeline gate(a: Authzed) -> AdmitCall {
    call x = pass_authzed(a);
    call y = d_gate(x);
    return y;
  }
  pipeline probe(a: Admitted) -> ActCall {
    call x = pass_admitted(a);
    call y = d_probe(x);
    return y;
  }



  entry admit = admit;
  entry ident = ident;
  entry authz = authz;
  entry gate = gate;
  entry probe = probe;

  provenance revision "apiplane-request-path" toolchain "chronicle-authoring";
}
