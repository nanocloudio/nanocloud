// DaemonSet and StatefulSet status as params, counted as the ReplicaSet's
// is (replicaset_status.uproc): a COUNT over the namespace's Pods with a
// predicate — that one's `rs_owned_p` (owned by this uid, not being deleted,
// not terminal) and `rs_ready_p` (and its Ready condition True) — and the
// counts PATCHed into status, put-if-changed. What `kubectl get ds/sts`
// prints and `kubectl rollout status` waits on.
//
//   ds    /daemonsets.apps/<ns>/<name> (and any Pod, any ready Node) ->
//         COUNT /ready-nodes/ (desiredNumberScheduled: the chain places one
//         Pod per ready Node, daemonset.uproc) -> COUNT its Pods (current)
//         -> COUNT the Ready ones -> PATCH status
//   sts   /statefulsets.apps/<ns>/<name> (and any Pod) -> COUNT its Pods ->
//         COUNT the Ready ones -> PATCH status
//
// Neither chain rolls a template change yet (daemonset.uproc and
// statefulset.uproc create what is absent and never replace a Pod), so every
// Pod there is runs the one revision there is: updated is current, and a
// StatefulSet's currentRevision and updateRevision are the same name. An
// observedGeneration is at least 1 — kubectl reads 0 as "not observed yet";
// the API server here does not count generations, so a status written is a
// spec observed. numberAvailable / availableReplicas are the Ready count
// (minReadySeconds 0).
module nanocloud.setstatus {

  enum NOOP = 0;
  enum PATCH = 5;
  enum COUNT = 12;

  // The same numbering as replicaset_status.uproc's, whose predicates run
  // over these COUNTs (they read `ouid` at 32).
  // carried by: ss.Count, ss.Counted
  message Ctx {
    key: string = 30;     // "<ns>/<name>"
    ns: string = 31;
    ouid: string = 32;    // its uid: its Pods' owner
    gen: int = 33;        // metadata.generation
    all: int = 34;        // its active Pods
    want: int = 35;       // desiredNumberScheduled (a DaemonSet)
    name: string = 40;
  }

  message ss.Obj {
    seq: int = 1;
    key: string = 3;      // "<ns>/<name>"
    uid: string = 4;      // metadata.uid
    gen: int = 50;        // metadata.generation (0 when unstated)
    ns: string = 28;
    name: string = 29;
  }
  message ss.Count {
    cid: int = 1;
    op: int = 2;
    key: string = 3;
    ctx: Ctx = 254;
  }
  message ss.Counted {
    cid: int = 1;
    status: int = 2;
    n: int = 45;
    ctx: Ctx = 254;
  }
  message ss.Set {
    cid: int = 1;
    op: int = 2;
    key: string = 3;
    v1: string = 4;  v2: int = 5;  v3: string = 6;  v4: int = 7;
    v5: string = 8;  v6: int = 9;  v7: string = 10; v8: int = 11;
    v9: string = 12; v10: int = 13; v11: string = 14; v12: int = 15;
    v13: string = 16;
    v14: int = 80; v15: string = 81; v16: int = 82; v17: string = 83;
    v18: string = 84; v19: string = 85; v20: string = 86;
    path: string = 19;
  }

  // ---- the DaemonSet ----
  // How many Nodes it wants: every ready one (/ready-nodes/, counted whole:
  // the effect's key_prefix is `/ready-nodes`, the key `/`).
  decision ds_want(o: ss.Obj) -> ss.Count {
    when o.uid != "" && o.ns != "" ->
      ss.Count { cid: o.seq, op: COUNT, key: "/",
                 ctx: Ctx { key: o.key, ns: o.ns, ouid: o.uid, gen: o.gen, name: o.name } };
    default ->
      ss.Count { cid: o.seq, op: NOOP, key: "", ctx: Ctx { key: "", ns: "", ouid: "", gen: 0, name: "" } };
  }
  decision ds_cur(c: ss.Counted) -> ss.Count {
    when c.status == 200 && has(c.n) && c.ctx.key != "" ->
      ss.Count { cid: c.cid, op: COUNT, key: c.ctx.ns + "/",
                 ctx: Ctx { key: c.ctx.key, ns: c.ctx.ns, ouid: c.ctx.ouid, gen: c.ctx.gen, want: c.n, name: c.ctx.name } };
    default ->
      ss.Count { cid: c.cid, op: NOOP, key: "", ctx: Ctx { key: "", ns: "", ouid: "", gen: 0, want: 0, name: "" } };
  }
  decision ds_rdy(c: ss.Counted) -> ss.Count {
    when c.status == 200 && has(c.n) && c.ctx.key != "" ->
      ss.Count { cid: c.cid, op: COUNT, key: c.ctx.ns + "/",
                 ctx: Ctx { key: c.ctx.key, ns: c.ctx.ns, ouid: c.ctx.ouid, gen: c.ctx.gen, want: c.ctx.want, all: c.n, name: c.ctx.name } };
    default ->
      ss.Count { cid: c.cid, op: NOOP, key: "", ctx: Ctx { key: "", ns: "", ouid: "", gen: 0, want: 0, all: 0, name: "" } };
  }
  decision ds_status(c: ss.Counted) -> ss.Set {
    when c.status == 200 && has(c.n) && c.ctx.key != "" ->
      ss.Set { cid: c.cid, op: PATCH, key: c.ctx.key, path: "status",
               v1: "{\"desiredNumberScheduled\":", v2: c.ctx.want, v3: ",\"currentNumberScheduled\":", v4: c.ctx.all,
               v5: ",\"updatedNumberScheduled\":", v6: c.ctx.all, v7: ",\"numberReady\":", v8: c.n,
               v9: ",\"numberAvailable\":", v10: c.n, v11: ",\"numberUnavailable\":", v12: math.greatest(c.ctx.want - c.n, 0),
               v13: ",\"numberMisscheduled\":0,\"observedGeneration\":", v14: math.greatest(c.ctx.gen, 1), v15: "}" };
    default ->
      ss.Set { cid: c.cid, op: NOOP, key: "" };
  }

  // ---- the StatefulSet ----
  decision sts_all(o: ss.Obj) -> ss.Count {
    when o.uid != "" && o.ns != "" ->
      ss.Count { cid: o.seq, op: COUNT, key: o.ns + "/",
                 ctx: Ctx { key: o.key, ns: o.ns, ouid: o.uid, gen: o.gen, name: o.name } };
    default ->
      ss.Count { cid: o.seq, op: NOOP, key: "", ctx: Ctx { key: "", ns: "", ouid: "", gen: 0, name: "" } };
  }
  decision sts_rdy(c: ss.Counted) -> ss.Count {
    when c.status == 200 && has(c.n) && c.ctx.key != "" ->
      ss.Count { cid: c.cid, op: COUNT, key: c.ctx.ns + "/",
                 ctx: Ctx { key: c.ctx.key, ns: c.ctx.ns, ouid: c.ctx.ouid, gen: c.ctx.gen, all: c.n, name: c.ctx.name } };
    default ->
      ss.Count { cid: c.cid, op: NOOP, key: "", ctx: Ctx { key: "", ns: "", ouid: "", gen: 0, all: 0, name: "" } };
  }
  decision sts_status(c: ss.Counted) -> ss.Set {
    when c.status == 200 && has(c.n) && c.ctx.key != "" ->
      ss.Set { cid: c.cid, op: PATCH, key: c.ctx.key, path: "status",
               v1: "{\"replicas\":", v2: c.ctx.all, v3: ",\"currentReplicas\":", v4: c.ctx.all,
               v5: ",\"updatedReplicas\":", v6: c.ctx.all, v7: ",\"readyReplicas\":", v8: c.n,
               v9: ",\"availableReplicas\":", v10: c.n, v11: ",\"observedGeneration\":", v12: math.greatest(c.ctx.gen, 1),
               v13: ",\"currentRevision\":\"", v17: c.ctx.name, v18: "\",\"updateRevision\":\"", v19: c.ctx.name, v20: "\"}" };
    default ->
      ss.Set { cid: c.cid, op: NOOP, key: "" };
  }

  pipeline ds_want_p(o: ss.Obj) -> ss.Count { call x = ds_want(o); return x; }
  pipeline ds_cur_p(c: ss.Counted) -> ss.Count { call x = ds_cur(c); return x; }
  pipeline ds_rdy_p(c: ss.Counted) -> ss.Count { call x = ds_rdy(c); return x; }
  pipeline ds_st_p(c: ss.Counted) -> ss.Set { call x = ds_status(c); return x; }
  pipeline sts_all_p(o: ss.Obj) -> ss.Count { call x = sts_all(o); return x; }
  pipeline sts_rdy_p(c: ss.Counted) -> ss.Count { call x = sts_rdy(c); return x; }
  pipeline sts_st_p(c: ss.Counted) -> ss.Set { call x = sts_status(c); return x; }
  entry ds_want_p = ds_want_p;
  entry ds_cur_p = ds_cur_p;
  entry ds_rdy_p = ds_rdy_p;
  entry ds_st_p = ds_st_p;
  entry sts_all_p = sts_all_p;
  entry sts_rdy_p = sts_rdy_p;
  entry sts_st_p = sts_st_p;
  provenance revision "set-status" toolchain "chronicle-authoring";
}
