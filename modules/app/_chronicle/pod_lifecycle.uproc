// The kubelet's decision half as params: the pod lifecycle state machine.
//
// The whole per-pod situation is a record, not private module state: the kill
// escalation and its deadline, the restart count, the backoff deadline, the
// run clock and its paused span, the terminal latch are all fields on
// /pod-runtime/<uid>. The source stamps the monotonic clock (58), arms a
// kernel timer for whichever deadline comes first (`due`), and looks up the
// same uid under every other plane (`related`), so one record carries the
// whole situation and one decision reads it.
//
//   /pod-runtime/<uid>  kill_phase kill_deadline backoff_until run_started
//                       paused_since restarts was_terminal      (mine)
//   /pod-specs/<uid>    cmd desired restart rootfs graph grace   (the ask;
//                       restart defaulted to always by pod_specs, as the
//                       API server defaults restartPolicy)
//   /sandbox-status/    state code                               (the world)
//   /probe-status/      live                                     (liveness)
//   /sandboxes/         cmd                    (does the artifact exist yet)
//   /pod-init/<pod uid> failed                 (an init container failed
//                                               for good: the Pod Failed)
module nanocloud.podlifecycle {

  // The context each chain here carries across its effects: ONE nested
  // message in the reserved carry field (254), echoed unchanged by every
  // connector. Inner numbers are the old carry-through numbers, so every
  // module that hands a context on agrees on it.
  // carried by: pl.Step
  message Ctx {
    key: string = 30;
    sb: string = 31;
    pod: string = 32;
    kill: string = 33;
    rst: int = 34;
    metal: string = 35;
    podkey: string = 36;   // the Pod's "<ns>/<name>", for its status
  }

  message pl.Rt {
    seq: int = 1;
    rev: int = 2;
    key: string = 3;
    kill_phase: int = 50;
    kill_deadline: int = 51;
    backoff_until: int = 52;
    run_started: int = 53;
    paused_since: int = 54;
    restarts: int = 55;
    was_terminal: int = 56;
    now: int = 58;
    cmd: string = 70;
    desired: string = 71;
    restart: string = 72;
    rootfs: string = 73;
    graph: string = 74;
    grace: int = 75;
    pod: string = 76;      // /pod-specs/ pod: the Pod's "<ns>/<name>"
    state: string = 80;
    code: string = 81;
    live: string = 90;
    sb_cmd: string = 100;
    // /sandbox-boot: the runtime's boot now, and /sandbox-boot-of/<uid>: the
    // boot the sandbox's status was recorded under. A status from another
    // boot describes a workload the restart already ended.
    boot: string = 110;
    sboot: string = 120;
    // /pod-init/<pod uid> failed: an init container of the Pod failed and
    // its restartPolicy (Never) does not run it again.
    ifail: string = 130;
  }

  // The transition, as a MERGE of the fields that changed — never a PUT: this
  // decision owns seven fields of a record and must say nothing about the
  // others, which a whole-document write would have to restate and could
  // therefore get wrong. Integers ride as integers; the connector renders them.
  message pl.Step {
    cid: int = 1;
    op: int = 2;
    key: string = 3;
    v1: string = 4;
    v2: int = 5;
    v3: string = 6;
    v4: int = 7;
// sandbox phase to project: start | delete | ""
// the pod phase to report
// term | kill | clear | ""
// restart count for the status doc
// "1" when the pod is graph-backed
    ctx: Ctx = 254;
  }

  enum NOOP = 0;
  enum PUT = 3;
  enum DELETE = 4;
  enum MERGE = 6;

  // ORDERING PIN: `desired == deleted` is evaluated FIRST, before the
  // restart branch, so a pod being killed can never be relaunched by its
  // restartPolicy.
  decision step(d: pl.Rt) -> pl.Step {
    // An init container failed for good: what waits behind it never runs,
    // and the Pod has Failed, as upstream's does.
    when d.desired != "deleted" && d.graph == "" && d.sb_cmd == "" && has(d.ifail) && d.ifail != "" ->
      pl.Step { cid: d.seq, op: NOOP, key: "", ctx: Ctx { key: d.key, sb: "", pod: "Failed", kill: "", rst: d.restarts, metal: "", podkey: d.pod } };
    // The artifact is not resolved yet (an image still pulling): report
    // Pending and project NO sandbox. What says so is the SANDBOX's argv,
    // not the spec's command: a container's command is only half of what an
    // image Pod runs, and a sandbox started before the pull would run it on
    // the node's own root.
    when d.desired != "deleted" && d.graph == "" && d.sb_cmd == "" ->
      pl.Step { cid: d.seq, op: NOOP, key: "", ctx: Ctx { key: d.key, sb: "", pod: "Pending", kill: "", rst: d.restarts, metal: "", podkey: d.pod } };

    // ── desired = deleted ──────────────────────────────────────────────
    // Immediate (grace=0) or nothing live to signal: the direct delete flow,
    // consuming the kill key if one was in flight. A status recorded under
    // another boot is nothing live: the node restarted and the workload with
    // it, so there is no process to signal and a kill key would never be
    // consumed.
    when d.desired == "deleted" && (d.grace == 0 || d.state == "" || d.state == "exited" || d.state == "failed" || d.state == "killed" || d.state == "destroyed" || (d.state == "running" && d.live == "0") || (has(d.sboot) && has(d.boot) && d.sboot != d.boot)) && d.kill_phase != 0 ->
      pl.Step { cid: d.seq, op: MERGE, key: d.key,
                v1: "kill_phase=0;kill_deadline=0", ctx: Ctx { key: d.key, sb: "delete", pod: "Terminating", kill: "clear", rst: d.restarts, metal: d.graph, podkey: d.pod } };
    when d.desired == "deleted" && (d.grace == 0 || d.state == "" || d.state == "exited" || d.state == "failed" || d.state == "killed" || d.state == "destroyed" || (d.state == "running" && d.live == "0") || (has(d.sboot) && has(d.boot) && d.sboot != d.boot)) ->
      pl.Step { cid: d.seq, op: NOOP, key: "", ctx: Ctx { key: d.key, sb: "delete", pod: "Terminating", kill: "", rst: d.restarts, metal: d.graph, podkey: d.pod } };
    // Phase 1: ask nicely, and record the deadline the timer will wake us on.
    // While the signal is pending the sandbox phase is LEFT ALONE (`sb: ""`):
    // a live sandbox is `start` already, and writing `start` over a `delete`
    // another evaluation wrote — the delete flow racing a status from before
    // a restart — made the sandbox chain create the deleted Pod again, which
    // was killed and created again in a loop.
    when d.desired == "deleted" && d.kill_phase == 0 ->
      pl.Step { cid: d.seq, op: MERGE, key: d.key,
                v1: "kill_phase=1;kill_deadline=", v2: d.now + d.grace * 1000, ctx: Ctx { key: d.key, sb: "", pod: "Terminating", kill: "term", rst: d.restarts, metal: d.graph, podkey: d.pod } };
    // Grace expired: escalate, then let the delete flow DESTROY.
    when d.desired == "deleted" && d.kill_phase == 1 && d.now >= d.kill_deadline ->
      pl.Step { cid: d.seq, op: MERGE, key: d.key,
                v1: "kill_phase=2", ctx: Ctx { key: d.key, sb: "delete", pod: "Terminating", kill: "kill", rst: d.restarts, metal: d.graph, podkey: d.pod } };
    when d.desired == "deleted" && d.kill_phase == 1 ->
      pl.Step { cid: d.seq, op: NOOP, key: "", ctx: Ctx { key: d.key, sb: "", pod: "Terminating", kill: "", rst: d.restarts, metal: d.graph, podkey: d.pod } };
    when d.desired == "deleted" ->
      pl.Step { cid: d.seq, op: NOOP, key: "", ctx: Ctx { key: d.key, sb: "delete", pod: "Terminating", kill: "", rst: d.restarts, metal: d.graph, podkey: d.pod } };

    // ── terminated (a real exit, or liveness past its threshold) ────
    // The backoff bookkeeping happens on the terminal EDGE only: the terminal
    // status persists until the teardown completes, and `was_terminal` is what
    // makes the increment happen once.
    when (d.state == "exited" || d.state == "failed" || d.state == "killed" || (d.state == "running" && d.live == "0")) && (d.restart == "always" || (d.restart == "onfailure" && d.state != "exited")) && d.was_terminal == 0 && d.state == "exited" ->
      pl.Step { cid: d.seq, op: MERGE, key: d.key,
                v1: "was_terminal=1;restarts=0;backoff_until=0;run_started=0;paused_since=0", ctx: Ctx { key: d.key, sb: "delete", pod: "Restarting", kill: "", rst: 0, metal: d.graph, podkey: d.pod } };
    // A run that survived the reset window breaks the streak first.
    when (d.state == "failed" || d.state == "killed" || (d.state == "running" && d.live == "0")) && (d.restart == "always" || d.restart == "onfailure") && d.was_terminal == 0 && d.run_started > 0 && d.now - d.run_started >= 600000 ->
      pl.Step { cid: d.seq, op: MERGE, key: d.key,
                v1: "was_terminal=1;restarts=1;run_started=0;paused_since=0;backoff_until=", v2: d.now + 1000, ctx: Ctx { key: d.key, sb: "delete", pod: "Restarting", kill: "", rst: 1, metal: d.graph, podkey: d.pod } };
    // delay = min(1s x 2^(n-1), 300s). No shift in the VM and no loop —
    // n is bounded by the cap, so the ladder IS the function.
    when (d.state == "failed" || d.state == "killed" || (d.state == "running" && d.live == "0")) && (d.restart == "always" || d.restart == "onfailure") && d.was_terminal == 0 && d.restarts == 0 ->
      pl.Step { cid: d.seq, op: MERGE, key: d.key,
                v1: "was_terminal=1;run_started=0;paused_since=0;restarts=1;backoff_until=", v2: d.now + 1000, ctx: Ctx { key: d.key, sb: "delete", pod: "Restarting", kill: "", rst: 1, metal: d.graph, podkey: d.pod } };
    when (d.state == "failed" || d.state == "killed" || (d.state == "running" && d.live == "0")) && (d.restart == "always" || d.restart == "onfailure") && d.was_terminal == 0 && d.restarts == 1 ->
      pl.Step { cid: d.seq, op: MERGE, key: d.key,
                v1: "was_terminal=1;run_started=0;paused_since=0;restarts=2;backoff_until=", v2: d.now + 2000, ctx: Ctx { key: d.key, sb: "delete", pod: "Restarting", kill: "", rst: 2, metal: d.graph, podkey: d.pod } };
    when (d.state == "failed" || d.state == "killed" || (d.state == "running" && d.live == "0")) && (d.restart == "always" || d.restart == "onfailure") && d.was_terminal == 0 && d.restarts == 2 ->
      pl.Step { cid: d.seq, op: MERGE, key: d.key,
                v1: "was_terminal=1;run_started=0;paused_since=0;restarts=3;backoff_until=", v2: d.now + 4000, ctx: Ctx { key: d.key, sb: "delete", pod: "Restarting", kill: "", rst: 3, metal: d.graph, podkey: d.pod } };
    when (d.state == "failed" || d.state == "killed" || (d.state == "running" && d.live == "0")) && (d.restart == "always" || d.restart == "onfailure") && d.was_terminal == 0 && d.restarts == 3 ->
      pl.Step { cid: d.seq, op: MERGE, key: d.key,
                v1: "was_terminal=1;run_started=0;paused_since=0;restarts=4;backoff_until=", v2: d.now + 8000, ctx: Ctx { key: d.key, sb: "delete", pod: "Restarting", kill: "", rst: 4, metal: d.graph, podkey: d.pod } };
    when (d.state == "failed" || d.state == "killed" || (d.state == "running" && d.live == "0")) && (d.restart == "always" || d.restart == "onfailure") && d.was_terminal == 0 && d.restarts == 4 ->
      pl.Step { cid: d.seq, op: MERGE, key: d.key,
                v1: "was_terminal=1;run_started=0;paused_since=0;restarts=5;backoff_until=", v2: d.now + 16000, ctx: Ctx { key: d.key, sb: "delete", pod: "Restarting", kill: "", rst: 5, metal: d.graph, podkey: d.pod } };
    when (d.state == "failed" || d.state == "killed" || (d.state == "running" && d.live == "0")) && (d.restart == "always" || d.restart == "onfailure") && d.was_terminal == 0 && d.restarts == 5 ->
      pl.Step { cid: d.seq, op: MERGE, key: d.key,
                v1: "was_terminal=1;run_started=0;paused_since=0;restarts=6;backoff_until=", v2: d.now + 32000, ctx: Ctx { key: d.key, sb: "delete", pod: "Restarting", kill: "", rst: 6, metal: d.graph, podkey: d.pod } };
    when (d.state == "failed" || d.state == "killed" || (d.state == "running" && d.live == "0")) && (d.restart == "always" || d.restart == "onfailure") && d.was_terminal == 0 && d.restarts == 6 ->
      pl.Step { cid: d.seq, op: MERGE, key: d.key,
                v1: "was_terminal=1;run_started=0;paused_since=0;restarts=7;backoff_until=", v2: d.now + 64000, ctx: Ctx { key: d.key, sb: "delete", pod: "Restarting", kill: "", rst: 7, metal: d.graph, podkey: d.pod } };
    when (d.state == "failed" || d.state == "killed" || (d.state == "running" && d.live == "0")) && (d.restart == "always" || d.restart == "onfailure") && d.was_terminal == 0 && d.restarts == 7 ->
      pl.Step { cid: d.seq, op: MERGE, key: d.key,
                v1: "was_terminal=1;run_started=0;paused_since=0;restarts=8;backoff_until=", v2: d.now + 128000, ctx: Ctx { key: d.key, sb: "delete", pod: "Restarting", kill: "", rst: 8, metal: d.graph, podkey: d.pod } };
    when (d.state == "failed" || d.state == "killed" || (d.state == "running" && d.live == "0")) && (d.restart == "always" || d.restart == "onfailure") && d.was_terminal == 0 ->
      pl.Step { cid: d.seq, op: MERGE, key: d.key,
                v1: "was_terminal=1;run_started=0;paused_since=0;restarts=", v2: d.restarts + 1, v3: ";backoff_until=", v4: d.now + 300000, ctx: Ctx { key: d.key, sb: "delete", pod: "Restarting", kill: "", rst: d.restarts + 1, metal: d.graph, podkey: d.pod } };
    // Already latched: keep tearing down.
    when (d.state == "exited" || d.state == "failed" || d.state == "killed" || (d.state == "running" && d.live == "0")) && (d.restart == "always" || (d.restart == "onfailure" && d.state != "exited")) ->
      pl.Step { cid: d.seq, op: NOOP, key: "", ctx: Ctx { key: d.key, sb: "delete", pod: "Restarting", kill: "", rst: d.restarts, metal: d.graph, podkey: d.pod } };
    // No restart policy: the sandbox is left as it is and the phase reports.
    when d.state == "exited" && d.code == "0" ->
      pl.Step { cid: d.seq, op: NOOP, key: "", ctx: Ctx { key: d.key, sb: "start", pod: "Succeeded", kill: "", rst: d.restarts, metal: d.graph, podkey: d.pod } };
    when d.state == "exited" || d.state == "failed" || d.state == "killed" || (d.state == "running" && d.live == "0") ->
      pl.Step { cid: d.seq, op: NOOP, key: "", ctx: Ctx { key: d.key, sb: "start", pod: "Failed", kill: "", rst: d.restarts, metal: d.graph, podkey: d.pod } };

    // ── destroyed: the slot is free; relaunch once the backoff has passed ──
    when d.state == "destroyed" && d.backoff_until != 0 && d.now < d.backoff_until ->
      pl.Step { cid: d.seq, op: NOOP, key: "", ctx: Ctx { key: d.key, sb: "delete", pod: "Restarting", kill: "", rst: d.restarts, metal: d.graph, podkey: d.pod } };
    when d.state == "destroyed" ->
      pl.Step { cid: d.seq, op: MERGE, key: d.key,
                v1: "was_terminal=0;backoff_until=0", ctx: Ctx { key: d.key, sb: "start", pod: "Restarting", kill: "", rst: d.restarts, metal: d.graph, podkey: d.pod } };

    // ── a workload the node's restart ended ──
    // A running or paused status recorded under another boot is the last
    // boot's: nothing of it runs now, so the Pod is not Running — Pending,
    // while the sandbox chain creates it again under this boot
    // (sandbox.uproc), never the stale Running a restart would otherwise
    // leave in the API. Its run clock is the last boot's too, and restarts.
    when (d.state == "running" || d.state == "paused") && has(d.sboot) && has(d.boot) && d.sboot != d.boot && (d.run_started != 0 || d.paused_since != 0) ->
      pl.Step { cid: d.seq, op: MERGE, key: d.key,
                v1: "run_started=0;paused_since=0", ctx: Ctx { key: d.key, sb: "start", pod: "Pending", kill: "", rst: d.restarts, metal: d.graph, podkey: d.pod } };
    when (d.state == "running" || d.state == "paused") && has(d.sboot) && has(d.boot) && d.sboot != d.boot ->
      pl.Step { cid: d.seq, op: NOOP, key: "", ctx: Ctx { key: d.key, sb: "start", pod: "Pending", kill: "", rst: d.restarts, metal: d.graph, podkey: d.pod } };

    // ── running / paused: the reset clock, frozen across a pause ──
    when d.state == "running" && d.run_started == 0 ->
      pl.Step { cid: d.seq, op: MERGE, key: d.key,
                v1: "was_terminal=0;paused_since=0;run_started=", v2: d.now, ctx: Ctx { key: d.key, sb: "start", pod: "Running", kill: "", rst: d.restarts, metal: d.graph, podkey: d.pod } };
    when d.state == "running" && d.paused_since > 0 ->
      pl.Step { cid: d.seq, op: MERGE, key: d.key,
                v1: "was_terminal=0;paused_since=0;run_started=", v2: d.run_started + d.now - d.paused_since, ctx: Ctx { key: d.key, sb: "start", pod: "Running", kill: "", rst: d.restarts, metal: d.graph, podkey: d.pod } };
    when d.state == "running" && d.was_terminal != 0 ->
      pl.Step { cid: d.seq, op: MERGE, key: d.key,
                v1: "was_terminal=0", ctx: Ctx { key: d.key, sb: "start", pod: "Running", kill: "", rst: d.restarts, metal: d.graph, podkey: d.pod } };
    when d.state == "running" ->
      pl.Step { cid: d.seq, op: NOOP, key: "", ctx: Ctx { key: d.key, sb: "start", pod: "Running", kill: "", rst: d.restarts, metal: d.graph, podkey: d.pod } };
    when d.state == "paused" && d.run_started != 0 && d.paused_since == 0 ->
      pl.Step { cid: d.seq, op: MERGE, key: d.key,
                v1: "paused_since=", v2: d.now, ctx: Ctx { key: d.key, sb: "start", pod: "Paused", kill: "", rst: d.restarts, metal: d.graph, podkey: d.pod } };
    when d.state == "paused" ->
      pl.Step { cid: d.seq, op: NOOP, key: "", ctx: Ctx { key: d.key, sb: "start", pod: "Paused", kill: "", rst: d.restarts, metal: d.graph, podkey: d.pod } };
    default ->
      pl.Step { cid: d.seq, op: NOOP, key: "", ctx: Ctx { key: d.key, sb: "start", pod: "Pending", kill: "", rst: d.restarts, metal: d.graph, podkey: d.pod } };
  }

  transformation pass_rt(d: pl.Rt) -> pl.Rt {
    pl.Rt { seq: d.seq, rev: d.rev, key: d.key, kill_phase: d.kill_phase,
            kill_deadline: d.kill_deadline, backoff_until: d.backoff_until,
            run_started: d.run_started, paused_since: d.paused_since,
            restarts: d.restarts, was_terminal: d.was_terminal, now: d.now,
            cmd: d.cmd, desired: d.desired, restart: d.restart, rootfs: d.rootfs,
            graph: d.graph, grace: d.grace, state: d.state, code: d.code,
            live: d.live, sb_cmd: d.sb_cmd, ifail: d.ifail }
  }
  pipeline st(d: pl.Rt) -> pl.Step {
    call x = pass_rt(d);
    call y = step(x);
    return y;
  }
  entry st = st;
  provenance revision "podlifecycle-store-state" toolchain "chronicle-authoring";
}
