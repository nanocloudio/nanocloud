// Wormhole's ingress-cell capacity, as params (rfc_lb_vip §11.7, Phase 5):
// Wormhole says how many ingress hosts a cell needs and on which profile,
// and nanocloud runs that many, through the workload path it already has —
// a Deployment, its ReplicaSet, its Pods, the scheduler. Chains (wc_):
//   demand  /wh-demand/<cell> = hosts=<n>;profile=<pi5|server>;image=<ref>
//           (Wormhole's to write: what the cell needs) ->
//             /namespaces/wormhole-system            created once
//             /deployments.apps/wormhole-system/<cell>
//           a Deployment of `hosts` replicas of the cell's ingress image,
//           one per node (required podAntiAffinity on
//           kubernetes.io/hostname: the scheduler places no two on one
//           host), on the host's network (an ingress host terminates the
//           service addresses), its requests sized by the profile (pi5:
//           1 CPU, 512Mi; server: 4 CPU, 4Gi), labelled
//           app.kubernetes.io/managed-by=nanocloud-wh-cell. Created whole
//           once (CREATE: an existing one is left alone), then held to the
//           demand field by field — `spec.replicas`, `spec.template` — so a
//           change of size scales it and a change of image or profile rolls
//           it, and nothing the Deployment controller writes (its status)
//           is overwritten. A demand of 0 hosts, an unknown profile or no
//           image provisions nothing.
//   prune   a Deployment of this chain's (its managed-by label) whose demand
//           is gone, or is 0 hosts, is deleted, conditional on the revision
//           judged; its ReplicaSet and Pods go with it (gc.plan, by owner).
//           Another Deployment in the namespace is not touched.
// The cell name is the Deployment's name: Wormhole names cells as DNS
// labels.
plan nanocloud.wh_cell {
  enum NOOP = 0;
  enum DELETE = 4;
  enum PATCH = 5;
  enum CREATE = 8;

  message Ctx {
    cell: string = 30;
    hosts: int = 31;
    profile: string = 32;
    image: string = 33;
    go: string = 34;       // "1": provision
  }
  message wc.Demand {
    seq: int = 1;
    key: string = 3;       // <cell>
    profile: string = 4;
    image: string = 5;
    hosts: int = 50;       // ints: hosts
  }
  message wc.Write {
    cid: int = 1;
    op: int = 2;
    key: string = 3;
    sep: string = 17;
    name: string = 18;
    v1: string = 4; v2: string = 5; v3: string = 6; v4: string = 7; v5: string = 8;
    v6: string = 9; v7: string = 10; v8: string = 11; v9: string = 12; v10: string = 13;
    v11: string = 14; v12: string = 15; v13: string = 16; v14: string = 80; v15: string = 81;
    v16: string = 82; v17: string = 83; v18: string = 84; v19: string = 85; v20: string = 86;
    v21: string = 87; v22: string = 88; v23: string = 89; v24: string = 90; v25: string = 91;
    v26: string = 92; v27: string = 93;
    ctx: Ctx = 254;
  }
  message wc.Done {
    cid: int = 1;
    status: int = 2;
    ctx: Ctx = 254;
  }
  // A PATCH: the dotted path at 19, the value's parts (an integer renders
  // as decimal).
  message wc.Count {
    cid: int = 1;
    op: int = 2;
    key: string = 3;
    sep: string = 17;
    name: string = 18;
    path: string = 19;
    v1: int = 4;
    ctx: Ctx = 254;
  }
  message wc.Tpl {
    cid: int = 1;
    op: int = 2;
    key: string = 3;
    sep: string = 17;
    name: string = 18;
    path: string = 19;
    v1: string = 4; v2: string = 5; v3: string = 6; v4: string = 7; v5: string = 8;
    v6: string = 9; v7: string = 10; v8: string = 11; v9: string = 12; v10: string = 13;
    v11: string = 14; v12: string = 15; v13: string = 16;
    ctx: Ctx = 254;
  }

  // The namespace first (CREATE: 409 when it exists, which is fine).
  decision ns(d: wc.Demand) -> wc.Write {
    when d.hosts <= 0 || (d.profile != "pi5" && d.profile != "server") || d.image == "" ->
      wc.Write { cid: d.seq, op: NOOP, key: "", sep: "", name: "",
                 v1: "", v2: "", v3: "", v4: "", v5: "", v6: "", v7: "", v8: "", v9: "", v10: "",
                 v11: "", v12: "", v13: "", v14: "", v15: "", v16: "", v17: "", v18: "", v19: "", v20: "",
                 v21: "", v22: "", v23: "", v24: "", v25: "", v26: "", v27: "",
                 ctx: Ctx { cell: d.key, hosts: 0, profile: "", image: "", go: "0" } };
    default ->
      wc.Write { cid: d.seq, op: CREATE, key: "wormhole-system", sep: "", name: "",
                 v1: "{\"apiVersion\":\"v1\",\"kind\":\"Namespace\",\"metadata\":{\"name\":\"wormhole-system\",\"labels\":{\"kubernetes.io/metadata.name\":\"wormhole-system\",\"app.kubernetes.io/managed-by\":\"nanocloud-wh-cell\"}}}",
                 v2: "", v3: "", v4: "", v5: "", v6: "", v7: "", v8: "", v9: "", v10: "",
                 v11: "", v12: "", v13: "", v14: "", v15: "", v16: "", v17: "", v18: "", v19: "", v20: "",
                 v21: "", v22: "", v23: "", v24: "", v25: "", v26: "", v27: "",
                 ctx: Ctx { cell: d.key, hosts: d.hosts, profile: d.profile, image: d.image, go: "1" } };
  }

  // The Deployment, whole, once.
  decision create(r: wc.Done) -> wc.Write {
    when r.ctx.go != "1" ->
      wc.Write { cid: r.cid, op: NOOP, key: "", sep: "", name: "",
                 v1: "", v2: "", v3: "", v4: "", v5: "", v6: "", v7: "", v8: "", v9: "", v10: "",
                 v11: "", v12: "", v13: "", v14: "", v15: "", v16: "", v17: "", v18: "", v19: "", v20: "",
                 v21: "", v22: "", v23: "", v24: "", v25: "", v26: "", v27: "", ctx: r.ctx };
    when r.ctx.profile == "pi5" ->
      wc.Write { cid: r.cid, op: CREATE, key: "wormhole-system", sep: "/", name: r.ctx.cell,
                 v1: "{\"apiVersion\":\"apps/v1\",\"kind\":\"Deployment\",\"metadata\":{\"name\":\"", v2: r.ctx.cell,
                 v3: "\",\"namespace\":\"wormhole-system\",\"labels\":{\"app.kubernetes.io/managed-by\":\"nanocloud-wh-cell\",\"wormhole.nanocloud.io/cell\":\"", v4: r.ctx.cell,
                 v5: "\"}},\"spec\":{\"replicas\":1,\"selector\":{\"matchLabels\":{\"wormhole.nanocloud.io/cell\":\"", v6: r.ctx.cell,
                 v7: "\"}},\"template\":{\"metadata\":{\"labels\":{\"wormhole.nanocloud.io/cell\":\"", v8: r.ctx.cell,
                 v9: "\"}},\"spec\":{\"hostNetwork\":true,\"affinity\":{\"podAntiAffinity\":{\"requiredDuringSchedulingIgnoredDuringExecution\":[{\"labelSelector\":{\"matchLabels\":{\"wormhole.nanocloud.io/cell\":\"", v10: r.ctx.cell,
                 v11: "\"}},\"topologyKey\":\"kubernetes.io/hostname\"}]}},\"containers\":[{\"name\":\"ingress\",\"image\":\"", v12: r.ctx.image,
                 v13: "\",\"env\":[{\"name\":\"WORMHOLE_CELL\",\"value\":\"", v14: r.ctx.cell,
                 v15: "\"},{\"name\":\"WORMHOLE_PROFILE\",\"value\":\"pi5\"}],\"resources\":{\"requests\":{\"cpu\":\"1\",\"memory\":\"512Mi\"}}}]}}}}",
                 v16: "", v17: "", v18: "", v19: "", v20: "", v21: "", v22: "", v23: "", v24: "", v25: "", v26: "", v27: "",
                 ctx: r.ctx };
    default ->
      wc.Write { cid: r.cid, op: CREATE, key: "wormhole-system", sep: "/", name: r.ctx.cell,
                 v1: "{\"apiVersion\":\"apps/v1\",\"kind\":\"Deployment\",\"metadata\":{\"name\":\"", v2: r.ctx.cell,
                 v3: "\",\"namespace\":\"wormhole-system\",\"labels\":{\"app.kubernetes.io/managed-by\":\"nanocloud-wh-cell\",\"wormhole.nanocloud.io/cell\":\"", v4: r.ctx.cell,
                 v5: "\"}},\"spec\":{\"replicas\":1,\"selector\":{\"matchLabels\":{\"wormhole.nanocloud.io/cell\":\"", v6: r.ctx.cell,
                 v7: "\"}},\"template\":{\"metadata\":{\"labels\":{\"wormhole.nanocloud.io/cell\":\"", v8: r.ctx.cell,
                 v9: "\"}},\"spec\":{\"hostNetwork\":true,\"affinity\":{\"podAntiAffinity\":{\"requiredDuringSchedulingIgnoredDuringExecution\":[{\"labelSelector\":{\"matchLabels\":{\"wormhole.nanocloud.io/cell\":\"", v10: r.ctx.cell,
                 v11: "\"}},\"topologyKey\":\"kubernetes.io/hostname\"}]}},\"containers\":[{\"name\":\"ingress\",\"image\":\"", v12: r.ctx.image,
                 v13: "\",\"env\":[{\"name\":\"WORMHOLE_CELL\",\"value\":\"", v14: r.ctx.cell,
                 v15: "\"},{\"name\":\"WORMHOLE_PROFILE\",\"value\":\"server\"}],\"resources\":{\"requests\":{\"cpu\":\"4\",\"memory\":\"4Gi\"}}}]}}}}",
                 v16: "", v17: "", v18: "", v19: "", v20: "", v21: "", v22: "", v23: "", v24: "", v25: "", v26: "", v27: "",
                 ctx: r.ctx };
  }

  // Held to the demand: its size (put-if-changed: 204 when it already is).
  decision size(r: wc.Done) -> wc.Count {
    when r.ctx.go != "1" ->
      wc.Count { cid: r.cid, op: NOOP, key: "", sep: "", name: "", path: "", v1: 0, ctx: r.ctx };
    default ->
      wc.Count { cid: r.cid, op: PATCH, key: "wormhole-system", sep: "/", name: r.ctx.cell,
                 path: "spec.replicas", v1: r.ctx.hosts, ctx: r.ctx };
  }

  // And its template: the image and the profile (a change rolls it out).
  decision template(r: wc.Done) -> wc.Tpl {
    when r.ctx.go != "1" ->
      wc.Tpl { cid: r.cid, op: NOOP, key: "", sep: "", name: "", path: "",
               v1: "", v2: "", v3: "", v4: "", v5: "", v6: "", v7: "", v8: "", v9: "", v10: "",
               v11: "", v12: "", v13: "", ctx: r.ctx };
    when r.ctx.profile == "pi5" ->
      wc.Tpl { cid: r.cid, op: PATCH, key: "wormhole-system", sep: "/", name: r.ctx.cell, path: "spec.template",
               v1: "{\"metadata\":{\"labels\":{\"wormhole.nanocloud.io/cell\":\"", v2: r.ctx.cell,
               v3: "\"}},\"spec\":{\"hostNetwork\":true,\"affinity\":{\"podAntiAffinity\":{\"requiredDuringSchedulingIgnoredDuringExecution\":[{\"labelSelector\":{\"matchLabels\":{\"wormhole.nanocloud.io/cell\":\"", v4: r.ctx.cell,
               v5: "\"}},\"topologyKey\":\"kubernetes.io/hostname\"}]}},\"containers\":[{\"name\":\"ingress\",\"image\":\"", v6: r.ctx.image,
               v7: "\",\"env\":[{\"name\":\"WORMHOLE_CELL\",\"value\":\"", v8: r.ctx.cell,
               v9: "\"},{\"name\":\"WORMHOLE_PROFILE\",\"value\":\"pi5\"}],\"resources\":{\"requests\":{\"cpu\":\"1\",\"memory\":\"512Mi\"}}}]}}",
               v10: "", v11: "", v12: "", v13: "", ctx: r.ctx };
    default ->
      wc.Tpl { cid: r.cid, op: PATCH, key: "wormhole-system", sep: "/", name: r.ctx.cell, path: "spec.template",
               v1: "{\"metadata\":{\"labels\":{\"wormhole.nanocloud.io/cell\":\"", v2: r.ctx.cell,
               v3: "\"}},\"spec\":{\"hostNetwork\":true,\"affinity\":{\"podAntiAffinity\":{\"requiredDuringSchedulingIgnoredDuringExecution\":[{\"labelSelector\":{\"matchLabels\":{\"wormhole.nanocloud.io/cell\":\"", v4: r.ctx.cell,
               v5: "\"}},\"topologyKey\":\"kubernetes.io/hostname\"}]}},\"containers\":[{\"name\":\"ingress\",\"image\":\"", v6: r.ctx.image,
               v7: "\",\"env\":[{\"name\":\"WORMHOLE_CELL\",\"value\":\"", v8: r.ctx.cell,
               v9: "\"},{\"name\":\"WORMHOLE_PROFILE\",\"value\":\"server\"}],\"resources\":{\"requests\":{\"cpu\":\"4\",\"memory\":\"4Gi\"}}}]}}",
               v10: "", v11: "", v12: "", v13: "", ctx: r.ctx };
  }

  message wc.Dep {
    seq: int = 1;
    rev: int = 2;          // the Deployment's revision (source `rev = 1`)
    key: string = 3;       // <cell> (the prefix holds the namespace)
    managed: string = 4;   // metadata.labels."app.kubernetes.io/managed-by"
    hosts: int = 70;       // related /wh-demand/: hosts (0 when gone)
  }
  message wc.Del {
    cid: int = 1;
    op: int = 2;
    key: string = 3;
    rev: int = 28;
  }
  decision prune(p: wc.Dep) -> wc.Del {
    when p.managed == "nanocloud-wh-cell" && p.hosts <= 0 ->
      wc.Del { cid: p.seq, op: DELETE, key: p.key, rev: p.rev };
    default -> wc.Del { cid: p.seq, op: NOOP, key: "", rev: 0 };
  }

  transformation pd(d: wc.Demand) -> wc.Demand {
    wc.Demand { seq: d.seq, key: d.key, profile: d.profile, image: d.image, hosts: d.hosts }
  }
  transformation pr(r: wc.Done) -> wc.Done {
    wc.Done { cid: r.cid, status: r.status, ctx: r.ctx }
  }
  transformation pp(p: wc.Dep) -> wc.Dep {
    wc.Dep { seq: p.seq, rev: p.rev, key: p.key, managed: p.managed, hosts: p.hosts }
  }
  pipeline wc_ns(d: wc.Demand) -> wc.Write { call x = pd(d); call y = ns(x); return y; }
  pipeline wc_create(r: wc.Done) -> wc.Write { call x = pr(r); call y = create(x); return y; }
  pipeline wc_size(r: wc.Done) -> wc.Count { call x = pr(r); call y = size(x); return y; }
  pipeline wc_template(r: wc.Done) -> wc.Tpl { call x = pr(r); call y = template(x); return y; }
  pipeline wc_prune(p: wc.Dep) -> wc.Del { call x = pp(p); call y = prune(x); return y; }
  entry wc_ns = wc_ns;
  entry wc_create = wc_create;
  entry wc_size = wc_size;
  entry wc_template = wc_template;
  entry wc_prune = wc_prune;
  provenance revision "wormhole-ingress-cell" toolchain "chronicle-authoring";
}
