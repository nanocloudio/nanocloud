// A Pod deleted outright as its node's ask: its tomb -> the flat
// /pod-specs/<uid> records with desired=deleted. A scheduled Pod's own
// records — a container Pod's, one per container, and a graph-backed Pod's
// (runtimeClassName: fluxor), its subgraph's — are pod_resolve's
// (_shared/podres.rs): their environment, command, user and volumes are
// functions of other objects, which no decision can compute.
//
//   gone    /~tomb-at/pods/<ns>/<name> (a Pod deleted outright: its tomb's
//           index entry, its identity at the tomb's paths)
//           -> /pod-specs/<uid> desired=deleted, either kind, and the same
//           for every container record of it, <uid>~c<n> and <uid>~i<n>
//           (store_effect PUT_FAMILY: one listing of the uid's prefix), so
//           no sidecar or init container of a deleted Pod keeps running.
//           Its grace is the delete's (the tomb's
//           deletionGracePeriodSeconds: the request's DeleteOptions, 0 for
//           `--force --grace-period=0`), else the Pod's own
//           terminationGracePeriodSeconds, else 30 — what a controller's or
//           the garbage collector's delete gives it. The node signals
//           SIGTERM, waits out the grace, then SIGKILL (pod_lifecycle).
//
// Each record is written into its node's scope, /~node/<node>/pod-specs/
// <uid> (the effect's key_prefix is /~node/): a worker's store keeps
// /pod-specs/ as its own, so its chains read only what is asked of it, by
// the plain name. The record also names its node.
plan nanocloud.podspecs {

  enum NOOP = 0;
  enum PUT_FAMILY = 19;

  // Value parts are joined into the record (store_effect: 4..16); the node
  // reads it as flat `k=v;` fields, in any order.
  message ps.Spec {
    cid: int = 1;
    op: int = 2;
    key: string = 3;
    p1: string = 4;   p2: string = 5;   p3: string = 6;   p4: string = 7;
    p5: string = 8;
  }
  message ps.Tomb {
    seq: int = 1;
    rev: int = 2;
    key: string = 3;      // "<ns>/<name>"
    uid: string = 4;      // obj.metadata.uid
    node: string = 5;     // obj.spec.nodeName
    rtc: string = 6;      // obj.spec.runtimeClassName
    image: string = 7;    // obj.spec.containers.0.image
    dgrace: string = 8;   // obj.metadata.deletionGracePeriodSeconds (the delete's)
    tgrace: string = 9;   // obj.spec.terminationGracePeriodSeconds (the Pod's)
  }
  // A graph-backed Pod's tombstone keeps naming its graph: the node's
  // lifecycle chain tears a metal sandbox down only for a spec that says
  // which graph it was (its delete arms carry `graph` to the metal effect);
  // it has no SIGTERM window to grant (grace 0).
  decision gone(t: ps.Tomb) -> ps.Spec {
    when t.uid == "" || t.node == "" ->
      ps.Spec { cid: t.seq, op: NOOP, key: "" };
    when t.rtc == "fluxor" ->
      ps.Spec { cid: t.seq, op: PUT_FAMILY, key: t.node + "/pod-specs/" + t.uid,
                p1: "node=", p2: t.node, p3: ";graph=", p4: t.image,
                p5: ";grace=0;desired=deleted;cmd=" };
    when t.dgrace != "" ->
      ps.Spec { cid: t.seq, op: PUT_FAMILY, key: t.node + "/pod-specs/" + t.uid,
                p1: "node=", p2: t.node, p3: ";grace=", p4: t.dgrace,
                p5: ";desired=deleted;cmd=" };
    when t.tgrace != "" ->
      ps.Spec { cid: t.seq, op: PUT_FAMILY, key: t.node + "/pod-specs/" + t.uid,
                p1: "node=", p2: t.node, p3: ";grace=", p4: t.tgrace,
                p5: ";desired=deleted;cmd=" };
    default ->
      ps.Spec { cid: t.seq, op: PUT_FAMILY, key: t.node + "/pod-specs/" + t.uid,
                p1: "node=", p2: t.node, p3: ";grace=30;desired=deleted;cmd=" };
  }

  pipeline gone_p(t: ps.Tomb) -> ps.Spec {
    call x = gone(t);
    return x;
  }

  entry gone = gone_p;

  provenance revision "pod-specs" toolchain "chronicle-authoring";
}
