// The Wormhole declaration, as params (rfc_lb_vip §6.1): what a Service and
// its endpoints mean to Wormhole, written as flat intent rows that
// `wormhole_emit` encodes as Wormhole's v1 records. Four chains (wh_):
//   svc    /services/ -> /wh-intent/<ns>/<svc> =
//            kind=svc;type=…;cip=…;cips=…;fam=…;lbip=…;ports=…;protos=…;
//            tports=…;etp=…;itp=…;aff=…;afft=…;src=…
//          the Service's identity, addresses and ports (aligned lists, as
//          the proxy's), its IP families (`spec.ipFamilies`, raw), its
//          traffic policies (external/internal -> locality), its session
//          affinity (ClientIP and its timeout -> an affinity policy) and its
//          load-balancer source ranges (-> early admission), raw where they
//          are lists. Only a Service Wormhole load-balances has a row:
//          `spec.loadBalancerClass` unset (Wormhole is nanocloud's default
//          load balancer) or `wormhole.nanocloud.io/lb`; another class is
//          another controller's, and its row is deleted. A Service with no
//          ClusterIP (headless, `None`), an ExternalName one, or one with no
//          ports has none.
//   ep     /endpointslices/ (each slice, with its Service now, related ^1)
//          -> the backend's Pod read for its named ports ->
//          /wh-intent-ep/<ns>/<svc>/<pod> = kind=ep;<the slice>;pnames=…;
//          pnums=…  — the slice as endpoints.plan writes it (ready, serving
//          or terminating, zone, node, generation, family), so the emitter
//          maps its state; a slice in the old bare form, or of a Service
//          that is not Wormhole's, has none. Keyed by the slice's own tail,
//          so the prune finds the slice by the same key.
//   ep_prune   an endpoint row whose slice is gone is deleted, conditional
//          on the revision judged
//   svc_prune  a service row whose Service is gone is deleted, the same way
//   status a LoadBalancer Service's `status.loadBalancer` names its address
//          only while Wormhole's VIP binding of it (`/wh-vip/`, decoded by
//          wormhole_status) is ACTIVE or DRAINING, and none otherwise
plan nanocloud.wormhole {
  enum NOOP = 0;
  enum GET = 1;
  enum PUT = 3;
  enum DELETE = 4;

  message wh.Svc {
    seq: int = 1;
    key: string = 3;       // <ns>/<svc>
    type: string = 4;      // spec.type
    cip: string = 5;       // spec.clusterIP
    cips: string = 6;      // spec.clusterIPs (raw JSON list)
    fam: string = 7;       // spec.ipFamilies (raw JSON list)
    ports: string = 8;     // spec.ports[].port
    protos: string = 9;    // spec.ports[].protocol
    tports: string = 10;   // spec.ports[].targetPort
    class: string = 11;    // spec.loadBalancerClass
    etp: string = 12;      // spec.externalTrafficPolicy
    itp: string = 13;      // spec.internalTrafficPolicy
    aff: string = 14;      // spec.sessionAffinity
    afft: string = 15;     // spec.sessionAffinityConfig.clientIP.timeoutSeconds
    src: string = 16;      // spec.loadBalancerSourceRanges (raw JSON list)
    lbip: string = 70;     // the load-balancer address svc_alloc gave it
                           // (related /lb-addr/: ip) — not its status, which
                           // waits for the VIP this declares
  }
  // Value parts, joined by the connector in field order (4..16, 80..99):
  // a row is never concatenated in the VM, whose scratch is 512 bytes.
  message wh.Row {
    cid: int = 1;
    op: int = 2;
    key: string = 3;
    v1: string = 4; v2: string = 5; v3: string = 6; v4: string = 7; v5: string = 8;
    v6: string = 9; v7: string = 10; v8: string = 11; v9: string = 12; v10: string = 13;
    v11: string = 14; v12: string = 15; v13: string = 16; v14: string = 80; v15: string = 81;
    v16: string = 82; v17: string = 83; v18: string = 84; v19: string = 85; v20: string = 86;
    v21: string = 87; v22: string = 88; v23: string = 89; v24: string = 90; v25: string = 91;
    v26: string = 92;
  }

  // Wormhole's: no class, or its own. Only those are declared.
  decision svc(s: wh.Svc) -> wh.Row {
    when s.class != "" && s.class != "wormhole.nanocloud.io/lb" ->
      wh.Row { cid: s.seq, op: DELETE, key: s.key, v1: "", v2: "", v3: "", v4: "", v5: "", v6: "", v7: "", v8: "", v9: "", v10: "",
               v11: "", v12: "", v13: "", v14: "", v15: "", v16: "", v17: "", v18: "", v19: "", v20: "",
               v21: "", v22: "", v23: "", v24: "", v25: "", v26: "" };
    when s.type == "ExternalName" || s.cip == "" || s.cip == "None" || s.ports == "" ->
      wh.Row { cid: s.seq, op: DELETE, key: s.key, v1: "", v2: "", v3: "", v4: "", v5: "", v6: "", v7: "", v8: "", v9: "", v10: "",
               v11: "", v12: "", v13: "", v14: "", v15: "", v16: "", v17: "", v18: "", v19: "", v20: "",
               v21: "", v22: "", v23: "", v24: "", v25: "", v26: "" };
    default ->
      wh.Row { cid: s.seq, op: PUT, key: s.key,
               v1: "kind=svc;type=", v2: s.type, v3: ";cip=", v4: s.cip, v5: ";cips=", v6: s.cips,
               v7: ";fam=", v8: s.fam, v9: ";lbip=", v10: s.lbip, v11: ";ports=", v12: s.ports,
               v13: ";protos=", v14: s.protos, v15: ";tports=", v16: s.tports, v17: ";etp=", v18: s.etp,
               v19: ";itp=", v20: s.itp, v21: ";aff=", v22: s.aff, v23: ";afft=", v24: s.afft,
               v25: ";src=", v26: s.src };
  }

  // The endpoint's makings, carried across the Pod read.
  message Ctx {
    key: string = 30;      // <ns>/<svc>/<pod>
    slice: string = 31;    // the slice's value
    ours: string = 32;     // "1" when the Service is Wormhole's
  }
  message wh.Sl {
    seq: int = 1;
    key: string = 3;       // <ns>/<svc>/<pod>
    slice: string = 4;     // the slice, whole (`.`)
    ns: string = 28;
    pod: string = 29;
    svc: string = 70;      // its Service's metadata.name now (related ^1)
    class: string = 71;    // its spec.loadBalancerClass
    cip: string = 72;      // its spec.clusterIP
    type: string = 73;     // its spec.type
  }
  message wh.PodGet {
    cid: int = 1;
    op: int = 2;
    key: string = 3;
    sep: string = 17;
    name: string = 18;
    ctx: Ctx = 254;
  }
  message wh.PodPorts {
    cid: int = 1;
    status: int = 2;
    pnames: string = 40;   // spec.containers.0.ports[].name
    pnums: string = 41;    // spec.containers.0.ports[].containerPort
    ctx: Ctx = 254;
  }
  // The Pod read only for a slice the emitter will encode.
  decision ep_ask(s: wh.Sl) -> wh.PodGet {
    when s.svc == "" || (s.class != "" && s.class != "wormhole.nanocloud.io/lb")
         || s.type == "ExternalName" || s.cip == "" || s.cip == "None"
         || !s.slice.startsWith("ip=") || !s.slice.contains(";state=") ->
      wh.PodGet { cid: s.seq, op: NOOP, key: "", sep: "", name: "",
                  ctx: Ctx { key: s.key, slice: "", ours: "0" } };
    default ->
      wh.PodGet { cid: s.seq, op: GET, key: s.ns, sep: "/", name: s.pod,
                  ctx: Ctx { key: s.key, slice: s.slice, ours: "1" } };
  }
  // The Pod gone (404): no named port of it resolves; the slice still
  // stands, and the emitter excludes it from a route whose targetPort is a
  // name it cannot resolve.
  decision ep(g: wh.PodPorts) -> wh.Row {
    when g.ctx.ours != "1" ->
      wh.Row { cid: g.cid, op: DELETE, key: g.ctx.key, v1: "", v2: "", v3: "", v4: "", v5: "", v6: "", v7: "", v8: "", v9: "", v10: "",
               v11: "", v12: "", v13: "", v14: "", v15: "", v16: "", v17: "", v18: "", v19: "", v20: "",
               v21: "", v22: "", v23: "", v24: "", v25: "", v26: "" };
    default ->
      wh.Row { cid: g.cid, op: PUT, key: g.ctx.key,
               v1: "kind=ep;", v2: g.ctx.slice, v3: ";pnames=", v4: g.pnames, v5: ";pnums=", v6: g.pnums,
               v7: "", v8: "", v9: "", v10: "", v11: "", v12: "", v13: "", v14: "", v15: "", v16: "",
               v17: "", v18: "", v19: "", v20: "", v21: "", v22: "", v23: "", v24: "", v25: "", v26: "" };
  }

  message wh.Kept {
    seq: int = 1;
    rev: int = 2;          // the row's revision (source `rev = 1`)
    key: string = 3;
    live: string = 70;     // the slice (or the Service's name) now, related
  }
  message wh.Del {
    cid: int = 1;
    op: int = 2;
    key: string = 3;
    rev: int = 28;
  }
  decision prune(k: wh.Kept) -> wh.Del {
    when k.live == "" -> wh.Del { cid: k.seq, op: DELETE, key: k.key, rev: k.rev };
    default -> wh.Del { cid: k.seq, op: NOOP, key: "", rev: 0 };
  }

  // ---- the load-balancer status, gated on the VIP (§6.1) ----

  message wh.Lb {
    seq: int = 1;
    key: string = 3;       // <ns>/<svc>
    type: string = 4;      // spec.type
    class: string = 5;     // spec.loadBalancerClass
    p4: int = 70;          // related /wh-vip/ (wormhole_status): the IPv4
    a4: string = 71;       //   binding's §11.6 phase and its address
    p6: int = 72;          // and the IPv6 one's
    a6: string = 73;
  }
  message wh.Patch {
    cid: int = 1;
    op: int = 2;
    key: string = 3;
    path: string = 19;     // the dotted path PATCH sets
    v1: string = 4; v2: string = 5; v3: string = 6; v4: string = 7; v5: string = 8;
  }
  enum PATCH = 5;

  // A LoadBalancer Service of Wormhole's names an address in its status
  // only while Wormhole's binding of it is ACTIVE (6) or DRAINING (7) — its
  // admitted readiness; before that, and once WITHDRAWN, EMISSION_DISABLED
  // or RELEASED, it names none (`{}`). Both families when both are. PATCH
  // writes put-if-changed (204 when it already says so). Another class's
  // Service, and any other type, are not touched.
  decision lb_status(l: wh.Lb) -> wh.Patch {
    when l.type != "LoadBalancer" || (l.class != "" && l.class != "wormhole.nanocloud.io/lb") ->
      wh.Patch { cid: l.seq, op: NOOP, key: "", path: "", v1: "", v2: "", v3: "", v4: "", v5: "" };
    when (l.p4 == 6 || l.p4 == 7) && l.a4 != "" && (l.p6 == 6 || l.p6 == 7) && l.a6 != "" ->
      wh.Patch { cid: l.seq, op: PATCH, key: l.key, path: "status.loadBalancer",
                 v1: "{\"ingress\":[{\"ip\":\"", v2: l.a4, v3: "\"},{\"ip\":\"", v4: l.a6, v5: "\"}]}" };
    when (l.p4 == 6 || l.p4 == 7) && l.a4 != "" ->
      wh.Patch { cid: l.seq, op: PATCH, key: l.key, path: "status.loadBalancer",
                 v1: "{\"ingress\":[{\"ip\":\"", v2: l.a4, v3: "\"}]}", v4: "", v5: "" };
    when (l.p6 == 6 || l.p6 == 7) && l.a6 != "" ->
      wh.Patch { cid: l.seq, op: PATCH, key: l.key, path: "status.loadBalancer",
                 v1: "{\"ingress\":[{\"ip\":\"", v2: l.a6, v3: "\"}]}", v4: "", v5: "" };
    default ->
      wh.Patch { cid: l.seq, op: PATCH, key: l.key, path: "status.loadBalancer",
                 v1: "{}", v2: "", v3: "", v4: "", v5: "" };
  }
  transformation plb(l: wh.Lb) -> wh.Lb {
    wh.Lb { seq: l.seq, key: l.key, type: l.type, class: l.class, p4: l.p4, a4: l.a4, p6: l.p6, a6: l.a6 }
  }
  pipeline wh_status(l: wh.Lb) -> wh.Patch { call x = plb(l); call y = lb_status(x); return y; }
  entry wh_status = wh_status;

  transformation ps(s: wh.Svc) -> wh.Svc {
    wh.Svc { seq: s.seq, key: s.key, type: s.type, cip: s.cip, cips: s.cips, fam: s.fam, ports: s.ports,
             protos: s.protos, tports: s.tports, class: s.class, etp: s.etp, itp: s.itp, aff: s.aff,
             afft: s.afft, src: s.src, lbip: s.lbip }
  }
  transformation psl(s: wh.Sl) -> wh.Sl {
    wh.Sl { seq: s.seq, key: s.key, slice: s.slice, ns: s.ns, pod: s.pod, svc: s.svc, class: s.class,
            cip: s.cip, type: s.type }
  }
  transformation ppp(g: wh.PodPorts) -> wh.PodPorts {
    wh.PodPorts { cid: g.cid, status: g.status, pnames: g.pnames, pnums: g.pnums, ctx: g.ctx }
  }
  transformation pk(k: wh.Kept) -> wh.Kept {
    wh.Kept { seq: k.seq, rev: k.rev, key: k.key, live: k.live }
  }
  pipeline wh_svc(s: wh.Svc) -> wh.Row { call x = ps(s); call y = svc(x); return y; }
  pipeline wh_ep_ask(s: wh.Sl) -> wh.PodGet { call x = psl(s); call y = ep_ask(x); return y; }
  pipeline wh_ep(g: wh.PodPorts) -> wh.Row { call x = ppp(g); call y = ep(x); return y; }
  pipeline wh_prune(k: wh.Kept) -> wh.Del { call x = pk(k); call y = prune(x); return y; }
  entry wh_svc = wh_svc;
  entry wh_ep_ask = wh_ep_ask;
  entry wh_ep = wh_ep;
  entry wh_prune = wh_prune;
  provenance revision "wormhole-intent" toolchain "chronicle-authoring";
}
