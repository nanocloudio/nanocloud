// ReplicaSet convergence as params.
//
// The reconcile is N INDEPENDENT decisions, not one set operation: deterministic
// naming makes `web-0` unrelated to `web-1`, so N guarded single-key writes
// converge over passes. The cardinality therefore lives in the SOURCE
// (store_source's `expand`), and every ordinal is an ordinary 1:1 decision.
//
// No set-shaped connector op, and none needed: an `ensure_range` would decide
// the whole set inside the connector and leave this decision deciding nothing,
// which moves the loop from one Rust module to another rather than into params.
module nanocloud.replicaset {

  // The context each chain here carries across its effects: ONE nested
  // message in the reserved carry field (254), echoed unchanged by every
  // connector. Names, digests and verdicts only — never the template: a
  // real one is kilobytes, and carried here it overflowed the decisions'
  // 512 B scratch (no Pods, or Pods without their labels). The writer
  // SPLICES the template from the stored ReplicaSet (`src`).
  // carried by: rs.PrevQ, rs.PrevA, rs.Probe, rs.Answer
  message Ctx {
    key: string = 30;
    src: string = 31;     // the ReplicaSet's key tail, the splice source
    in: string = 32;
    name: string = 33;
    ns: string = 34;
    ord: string = 35;
    hash: string = 36;
    prev: string = 37;
    gate: string = 38;
    pod: string = 39;
    ouid: string = 41;    // the ReplicaSet's metadata.uid: its Pods' controller reference
  }
  // carried by: rs.Act, rs.Applied
  message Ctx2 {
    key: string = 30;
    evt: string = 33;
    ns: string = 34;
    pod: string = 39;
  }

  message rs.Ord {
    seq: int = 1;
    rev: int = 2;
    key: string = 3;     // "<ns>/<name>" — the tail below /replicasets.apps/
    hash: string = 4;    // metadata.labels.pod-template-hash on the ReplicaSet
    uid: string = 5;     // metadata.uid, the Pods' controller reference
    ns: string = 28;     // the key's namespace segment — the document may carry
    name: string = 29;   // neither metadata.namespace nor metadata.name
    ord: int = 20;       // this index
    ordstr: string = 21; // the same index as digits — the VM cannot render one
    want: int = 22;      // spec.replicas
    prevstr: string = 23;// the predecessor index as digits; empty at 0
    selfkey: string = 24;// "<ns>/<name>-<i>", built by the source
    prevkey: string = 25;// "<ns>/<name>-<i-1>"; empty at 0
    pod: string = 26;    // "<name>-<i>" — the same join without the namespace,
                         // because a document that NAMES the object wants the
                         // bare name where a store key wants "<ns>/".
  }

  // Stage 1 asks about the PREDECESSOR, so the verdict can roll strictly in
  // ordinal order — one pod at a time, which is what maxUnavailable = 1 means.
  // The module it mirrors gets the same effect with a per-pass budget of one,
  // spending it on the first stale ordinal it meets; a per-record decision has
  // no budget to spend, but "my predecessor is already fresh" identifies the
  // same pod.
  message rs.PrevQ {
    cid: int = 1;
    op: int = 2;
    key: string = 3;
    ctx: Ctx = 254;
  }

  message rs.PrevA {
    cid: int = 1;
    status: int = 2;
    value: string = 3;
    phash: string = 40;  // the predecessor's pod-template-hash, projected
    ctx: Ctx = 254;
  }

  // EXISTS probe for this ordinal's pod. Key parts: "<ns>/" + name + "-" + ord,
  // after the connector's key_prefix.
  message rs.Probe {
    cid: int = 1;
    op: int = 2;
    key: string = 3;
    // Carry-through, echoed untouched: the verdict needs the REQUEST as well as
    // the answer, and without Chronicle's effect call/join the reply is all it
    // would otherwise see.
// the ReplicaSet's template hash
// "1" when the predecessor is fresh (or absent)
    ctx: Ctx = 254;
  }

  message rs.Answer {
    cid: int = 1;
    status: int = 2;
    value: string = 3;
    myhash: string = 40;   // this pod's pod-template-hash, projected
    ctx: Ctx = 254;
  }

  // The pod document, as VALUE PARTS joined in field order by the connector.
  // Thirteen parts because literals and projected fields alternate and the VM
  // cannot concatenate; joining bytes is the connector's job.
  message rs.Act {
    cid: int = 1;
    op: int = 2;
    key: string = 3;
    p1: string = 4;   p2: string = 5;   p3: string = 6;
    p4: string = 7;   p5: string = 8;   p6: string = 9;
    p7: string = 10;  p8: string = 11;  p9: string = 12;
    p10: string = 13; p11: string = 14; p12: string = 15;
    p13: string = 16;
    p14: string = 80; p15: string = 81; p16: string = 82;
    src: string = 70;    // splice source: the ReplicaSet's key tail
    splice: string = 71; // what is spliced from it, and where
    // Carry for the EVENT stage. The connector echoes 30..39 untouched, so the
    // record that reports what happened rides along with the write that did it
    // — the only way a decision downstream of the effect can know which branch
    // fired, since the reply carries a status and nothing else.
// "<ns>/<pod>" — the event's key, minus its suffix
// "create" | "roll" | "delete" | "" (nothing happened)
// the namespace, for the event's own metadata
// "<name>-<i>", for the event's involvedObject
    ctx: Ctx2 = 254;
  }

  // What the event stage writes. `key` is the acted-on object's "<ns>/<pod>"
  // and `xk` the ".<Reason>.0" suffix, joined after key_prefix "/events/" —
  // core/v1's `/events/<ns>/<obj>.<reason>.<seq>`. A PIC module has no clock,
  // so there is no timestamp and `seq` is 0: a recurring reason overwrites its
  // own event, which is the same coarse behaviour `_shared/event.rs` documents.
  message rs.Evt {
    cid: int = 1;
    op: int = 2;
    key: string = 3;
    xk: string = 17;
    v1: string = 4;   v2: string = 5;   v3: string = 6;
    v4: string = 7;   v5: string = 8;   v6: string = 9;
    v7: string = 10;  v8: string = 11;  v9: string = 12;
    v10: string = 13; v11: string = 14;
  }

  // The reply the event stage reads: `apply`'s answer, carrying the tag.
  message rs.Applied {
    cid: int = 1;
    status: int = 2;
    value: string = 3;
    ctx: Ctx2 = 254;
  }

  enum NOOP = 0;
  enum GET = 1;
  enum EXISTS = 2;
  enum PUT = 3;
  enum DELETE = 4;

  // Probe every ordinal the source emitted. `c_in` records whether this ordinal
  // is inside the desired count, as "1" or "" — the verdict needs it and the
  // answer alone cannot say.
  // Stage 1: ask about the predecessor. Index 0 has none, so ask about nothing
  // and let the answer's 204 stand for "ungated".
  decision ask_prev(o: rs.Ord) -> rs.PrevQ {
    when o.prevstr == "" && o.ord < o.want ->
      rs.PrevQ { cid: o.seq, op: NOOP, key: "", ctx: Ctx { key: o.selfkey, src: o.key, in: "1", name: o.name, ns: o.ns, ord: o.ordstr, hash: o.hash, prev: o.prevstr, pod: o.pod, ouid: o.uid } };
    when o.prevstr == "" ->
      rs.PrevQ { cid: o.seq, op: NOOP, key: "", ctx: Ctx { key: o.selfkey, src: o.key, in: "", name: o.name, ns: o.ns, ord: o.ordstr, hash: o.hash, prev: o.prevstr, pod: o.pod, ouid: o.uid } };
    when o.ord < o.want ->
      rs.PrevQ { cid: o.seq, op: GET, key: o.prevkey, ctx: Ctx { key: o.selfkey, src: o.key, in: "1", name: o.name, ns: o.ns, ord: o.ordstr, hash: o.hash, prev: o.prevstr, pod: o.pod, ouid: o.uid } };
    default ->
      rs.PrevQ { cid: o.seq, op: GET, key: o.prevkey, ctx: Ctx { key: o.selfkey, src: o.key, in: "", name: o.name, ns: o.ns, ord: o.ordstr, hash: o.hash, prev: o.prevstr, pod: o.pod, ouid: o.uid } };
  }

  // Stage 2: ask about THIS ordinal, carrying the predecessor verdict. The gate
  // is "1" when the predecessor is fresh (its hash matches) or when there is no
  // predecessor at all (status 204 from the NOOP above).
  decision probe(a: rs.PrevA) -> rs.Probe {
    when a.status == 204 ->
      rs.Probe { cid: a.cid, op: GET, key: a.ctx.key, ctx: Ctx { key: a.ctx.key, src: a.ctx.src, in: a.ctx.in, name: a.ctx.name, ns: a.ctx.ns, ord: a.ctx.ord, hash: a.ctx.hash, gate: "1", pod: a.ctx.pod, ouid: a.ctx.ouid } };
    when a.phash == a.ctx.hash ->
      rs.Probe { cid: a.cid, op: GET, key: a.ctx.key, ctx: Ctx { key: a.ctx.key, src: a.ctx.src, in: a.ctx.in, name: a.ctx.name, ns: a.ctx.ns, ord: a.ctx.ord, hash: a.ctx.hash, gate: "1", pod: a.ctx.pod, ouid: a.ctx.ouid } };
    default ->
      rs.Probe { cid: a.cid, op: GET, key: a.ctx.key, ctx: Ctx { key: a.ctx.key, src: a.ctx.src, in: a.ctx.in, name: a.ctx.name, ns: a.ctx.ns, ord: a.ctx.ord, hash: a.ctx.hash, gate: "", pod: a.ctx.pod, ouid: a.ctx.ouid } };
  }

  // Four cases, and only two act:
  //   in range + absent  -> create (create-if-absent preserves kubelet fields)
  //   out of range + present -> delete
  //   otherwise -> nothing
  decision converge(a: rs.Answer) -> rs.Act {
    // Roll a stale pod: in range, present, its hash differs from the
    // ReplicaSet's, and the predecessor is already fresh. Deleted, not
    // overwritten -- it is recreated from the new template next pass, and
    // create-if-absent is what preserves the fields a kubelet adds.
    when a.ctx.in == "1" && a.status == 200 && a.ctx.gate == "1" && a.myhash != a.ctx.hash ->
      rs.Act { cid: a.cid, op: DELETE, key: a.ctx.key, ctx: Ctx2 { key: a.ctx.key, evt: "roll", ns: a.ctx.ns, pod: a.ctx.pod } };
    // A Pod names its kind, and is labelled as its template says, beside
    // the ReplicaSet's pod-template-hash so the Deployment's selector and a
    // rollout find it; it carries the template's annotations. Labels,
    // annotations and spec are SPLICED from the stored ReplicaSet.
    when a.ctx.in == "1" && a.status == 404 && a.ctx.hash != "" ->
      rs.Act { cid: a.cid, op: PUT, key: a.ctx.key,
               p1: "{\"apiVersion\":\"v1\",\"kind\":\"Pod\",\"metadata\":{\"name\":\"",
               p2: a.ctx.name,
               p3: "-",
               p4: a.ctx.ord,
               p5: "\",\"namespace\":\"",
               p6: a.ctx.ns,
               p7: "\",\"ownerReferences\":[{\"apiVersion\":\"apps/v1\",\"kind\":\"ReplicaSet\",\"name\":\"",
               p8: a.ctx.name,
               p9: "\",\"uid\":\"",
               p10: a.ctx.ouid,
               p11: "\",\"controller\":true,\"blockOwnerDeletion\":true}],\"labels\":{\"pod-template-hash\":\"",
               p12: a.ctx.hash,
               p13: "\"",
               p14: "},\"annotations\":{",
               p15: "}},\"spec\":",
               p16: ",\"status\":{\"phase\":\"Pending\"}}",
               src: a.ctx.src,
               splice: "/replicasets.apps/|80=,spec.template.metadata.labels.*;81=spec.template.metadata.annotations.*;82=spec.template.spec",
               ctx: Ctx2 { key: a.ctx.key, evt: "create", ns: a.ctx.ns, pod: a.ctx.pod } };
    when a.ctx.in == "1" && a.status == 404 ->
      rs.Act { cid: a.cid, op: PUT, key: a.ctx.key,
               p1: "{\"apiVersion\":\"v1\",\"kind\":\"Pod\",\"metadata\":{\"name\":\"",
               p2: a.ctx.name,
               p3: "-",
               p4: a.ctx.ord,
               p5: "\",\"namespace\":\"",
               p6: a.ctx.ns,
               p7: "\",\"ownerReferences\":[{\"apiVersion\":\"apps/v1\",\"kind\":\"ReplicaSet\",\"name\":\"",
               p8: a.ctx.name,
               p9: "\",\"uid\":\"",
               p10: a.ctx.ouid,
               p11: "\",\"controller\":true,\"blockOwnerDeletion\":true}],\"labels\":{",
               p14: "},\"annotations\":{",
               p15: "}},\"spec\":",
               p16: ",\"status\":{\"phase\":\"Pending\"}}",
               src: a.ctx.src,
               splice: "/replicasets.apps/|80=spec.template.metadata.labels.*;81=spec.template.metadata.annotations.*;82=spec.template.spec",
               ctx: Ctx2 { key: a.ctx.key, evt: "create", ns: a.ctx.ns, pod: a.ctx.pod } };
    when a.ctx.in == "" && a.status == 200 ->
      rs.Act { cid: a.cid, op: DELETE, key: a.ctx.key, ctx: Ctx2 { key: a.ctx.key, evt: "delete", ns: a.ctx.ns, pod: a.ctx.pod } };
    default ->
      rs.Act { cid: a.cid, op: NOOP, key: "", ctx: Ctx2 { key: "", evt: "", ns: "", pod: "" } };
  }

  // Stage 4: RECORD what stage 3 did. Gated on status 200 as well as the tag —
  // the tag says which branch fired, the status says the store accepted it, and
  // an event for a write that failed would be a lie. A NOOP answers 204 and its
  // empty tag falls to the default, so nothing is written for a quiet pass.
  decision record(a: rs.Applied) -> rs.Evt {
    when a.ctx.evt == "create" && a.status == 200 ->
      rs.Evt { cid: a.cid, op: PUT, key: a.ctx.key, xk: ".SuccessfulCreate.0",
               v1: "{\"metadata\":{\"name\":\"",
               v2: a.ctx.pod,
               v3: ".SuccessfulCreate.0\",\"namespace\":\"",
               v4: a.ctx.ns,
               v5: "\"},\"involvedObject\":{\"kind\":\"Pod\",\"namespace\":\"",
               v6: a.ctx.ns,
               v7: "\",\"name\":\"",
               v8: a.ctx.pod,
               v9: "\"},\"reason\":\"SuccessfulCreate\",\"message\":\"Created pod ",
               v10: a.ctx.pod,
               v11: "\",\"type\":\"Normal\",\"count\":1}" };
    when a.ctx.evt == "roll" && a.status == 200 ->
      rs.Evt { cid: a.cid, op: PUT, key: a.ctx.key, xk: ".SuccessfulDelete.0",
               v1: "{\"metadata\":{\"name\":\"",
               v2: a.ctx.pod,
               v3: ".SuccessfulDelete.0\",\"namespace\":\"",
               v4: a.ctx.ns,
               v5: "\"},\"involvedObject\":{\"kind\":\"Pod\",\"namespace\":\"",
               v6: a.ctx.ns,
               v7: "\",\"name\":\"",
               v8: a.ctx.pod,
               v9: "\"},\"reason\":\"SuccessfulDelete\",\"message\":\"Rolled pod ",
               v10: a.ctx.pod,
               v11: "\",\"type\":\"Normal\",\"count\":1}" };
    when a.ctx.evt == "delete" && a.status == 200 ->
      rs.Evt { cid: a.cid, op: PUT, key: a.ctx.key, xk: ".SuccessfulDelete.0",
               v1: "{\"metadata\":{\"name\":\"",
               v2: a.ctx.pod,
               v3: ".SuccessfulDelete.0\",\"namespace\":\"",
               v4: a.ctx.ns,
               v5: "\"},\"involvedObject\":{\"kind\":\"Pod\",\"namespace\":\"",
               v6: a.ctx.ns,
               v7: "\",\"name\":\"",
               v8: a.ctx.pod,
               v9: "\"},\"reason\":\"SuccessfulDelete\",\"message\":\"Deleted pod ",
               v10: a.ctx.pod,
               v11: "\",\"type\":\"Normal\",\"count\":1}" };
    default ->
      rs.Evt { cid: a.cid, op: NOOP, key: "", xk: "" };
  }

  transformation pass_ord(o: rs.Ord) -> rs.Ord {
    rs.Ord { seq: o.seq, rev: o.rev, key: o.key, ns: o.ns, name: o.name,
             ord: o.ord, ordstr: o.ordstr, want: o.want,
             prevstr: o.prevstr, hash: o.hash, uid: o.uid, pod: o.pod,
             selfkey: o.selfkey, prevkey: o.prevkey }
  }
  transformation pass_prev(a: rs.PrevA) -> rs.PrevA {
    rs.PrevA { cid: a.cid, status: a.status, value: a.value, phash: a.phash, ctx: a.ctx }
  }
  transformation pass_ans(a: rs.Answer) -> rs.Answer {
    rs.Answer { cid: a.cid, status: a.status, value: a.value,
                myhash: a.myhash, ctx: a.ctx }
  }

  transformation pass_applied(a: rs.Applied) -> rs.Applied {
    rs.Applied { cid: a.cid, status: a.status, value: a.value, ctx: Ctx2 { key: a.ctx.key, evt: a.ctx.evt, ns: a.ctx.ns, pod: a.ctx.pod } }
  }

  pipeline prev(o: rs.Ord) -> rs.PrevQ {
    call x = pass_ord(o);
    call y = ask_prev(x);
    return y;
  }
  pipeline ask(a: rs.PrevA) -> rs.Probe {
    call x = pass_prev(a);
    call y = probe(x);
    return y;
  }
  pipeline act(a: rs.Answer) -> rs.Act {
    call x = pass_ans(a);
    call y = converge(x);
    return y;
  }

  pipeline rec(a: rs.Applied) -> rs.Evt {
    call x = pass_applied(a);
    call y = record(x);
    return y;
  }

  entry prev = prev;
  entry ask = ask;
  entry act = act;
  entry rec = rec;

  provenance revision "replicaset-expand" toolchain "chronicle-authoring";
}
