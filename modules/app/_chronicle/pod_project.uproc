// The pod's ARTIFACT half: what to run, as opposed to when. Two chains beside
// the lifecycle state machine.
//
//   project  /pod-specs/ -> MERGE the artifact fields into /sandboxes/<uid>
//            (or /metal-sandboxes/ for a graph-backed pod), and create the
//            /pod-runtime/ record the lifecycle chain is driven by. The
//            artifact fields are the spec's; the `phase=` field is the
//            lifecycle chain's, and MERGE is why the two can own one record
//            without either restating the other's half.
//   prune    a /pod-runtime/ whose /pod-specs/ is gone — or a
//            /pod-lifecycle-status/ whose spec is gone, the status a
//            lifecycle record still in flight wrote back after the rest went
module nanocloud.podproject {

  // The context each chain here carries across its effects: ONE nested
  // message in the reserved carry field (254), echoed unchanged by every
  // connector. Inner numbers are the old carry-through numbers, so every
  // module that hands a context on agrees on it.
  // carried by: pp.Art, pp.Made, pp.Ask, pp.Known
  message Ctx {
    key: string = 30;
    st: string = 31;      // prune: the sandbox's state (absent: none)
    metal: string = 32;   // prune: its graph, when it is a metal sandbox
  }

  // /pod-specs/<uid>: the spec's fields (pj_source/pj_msource `paths`, in
  // order) and what pod_image resolved its image to (`related`).
  message pp.Spec {
    seq: int = 1;
    rev: int = 2;
    key: string = 3;      // uid
    cmd: string = 4;      // the container's command (argv)
    rootfs: string = 5;
    iso: string = 6;
    net: string = 7;
    tasks: string = 8;
    graph: string = 9;
    image: string = 10;       // a workload image's reference (pulled)
    args: string = 11;        // the container's args (argv)
    env: string = 12;         // the container's env (NAME=VALUE,… escaped)
    workdir: string = 13;     // the container's workingDir (escaped)
    cpu: string = 14;         // limits: millicores
    mem: string = 15;         //         bytes
    eph: string = 16;         //         ephemeral-storage bytes
    pod: string = 17;         // "<ns>/<name>"
    res_rootfs: string = 70;  // related /pod-resolved/
    res_cmd: string = 71;     //   the argv, command/args against the image's
    res_env: string = 72;     //   the image's Env
    res_wd: string = 73;      //   its WorkingDir
    res_user: string = 74;    //   its User
    res_uid: string = 75;     //   its User's uid (!uidnum: "" for a name)
    // The container's securityContext and config (/pod-specs/ itself,
    // pod_resolve's fields), its init order, and its sandbox's state.
    ruid: string = 80;        // runAsUser
    rgid: string = 81;        // runAsGroup
    nonroot: string = 82;     // runAsNonRoot: "1"
    cfgerr: string = 83;      // why Kubernetes would not create it
    gate: int = 84;           // the init containers that must have completed
    dns: string = 85;         // its resolver context (`<server> <search>…`)
    done: int = 90;           // /pod-init/<pod uid> done: those that have
    st: string = 100;         // /sandbox-status/ state
  }
  message pp.Art {
    cid: int = 1;
    op: int = 2;
    key: string = 3;
    p1: string = 4; p2: string = 5; p3: string = 6; p4: string = 7;
    p5: string = 8; p6: string = 9; p7: string = 10; p8: string = 11;
    p9: string = 12; p10: string = 13; p11: string = 14; p12: string = 15;
    p13: string = 16;
    p14: string = 80; p15: string = 81; p16: string = 82; p17: string = 83;
    p18: string = 84; p19: string = 85; p20: string = 86; p21: string = 87;
    p22: string = 88; p23: string = 89; p24: string = 90; p25: string = 91;
    p26: string = 92; p27: string = 93; p28: string = 94;
    p29: string = 95; p30: string = 96; p31: string = 97; p32: string = 98;
    ctx: Ctx = 254;
  }
  message pp.Made {
    cid: int = 1;
    status: int = 2;
    value: string = 3;
    ctx: Ctx = 254;
  }
  message pp.Rt {
    seq: int = 1;
    rev: int = 2;
    key: string = 3;
    st: string = 70;      // /sandbox-status/<uid> state
    metal: string = 80;   // /metal-sandboxes/<uid> graph
  }
  message pp.Ask {
    cid: int = 1;
    op: int = 2;
    key: string = 3;
    ctx: Ctx = 254;
  }
  message pp.Known {
    cid: int = 1;
    status: int = 2;
    value: string = 3;
    ctx: Ctx = 254;
  }
  message pp.Act {
    cid: int = 1;
    op: int = 2;
    key: string = 3;
    v1: string = 4;
    k2: string = 17;
  }

  enum NOOP = 0;
  enum EXISTS = 2;
  enum DROP_EACH = 18;
  enum PUT = 3;
  enum DELETE = 4;
  enum MERGE = 6;

  // A container Pod's sandbox. Of an IMAGE (`image=`, no explicit rootfs): nothing
  // until pod_image resolved it — the Pod is Pending meanwhile, and nothing
  // of it runs on the node's own root — then the image's rootfs, the argv
  // composed by the Kubernetes rules (pod_image), isolated (`iso=1`: the
  // image's root is the process's root only in a mount namespace of its
  // own). Its network (`net=own`: an address of its own, pod_resolve's) and
  // its resolver context (`dns=`) go with it. Its environment is the image's
  // Env then the container's, a later
  // entry overriding an earlier of its name (`env=`, joined; workload_effect
  // composes it); `host=` the Pod's name (HOSTNAME); `wd=` the container's
  // workingDir and `iwd=` the image's, the first that is set winning; `user=`
  // `<the image's User>/<runAsUser>/<runAsGroup>` (workload_effect composes
  // them: the securityContext's over the image's, a runAsGroup alone keeping
  // the image's uid); `cpu=`/`mem=`/`eph=` the container's limits, `tasks=`
  // its pids envelope (pod_resolve's: what gives it a cgroup).
  // A Pod with no image (a host process, or an explicit rootfs): its command
  // and args as one argv, its own env, its runAsUser/runAsGroup (none: the
  // node's own identity).
  //
  // Not created, as upstream's kubelet would not create it — the sandbox's
  // status says `refused` with why (CreateContainerConfigError), which a live
  // sandbox is never overwritten with: a config error pod_resolve found (a
  // missing ConfigMap, a setting the node cannot give), and runAsNonRoot
  // with a user that is root or a name no number says is not. A container
  // after init containers waits until they have completed (/pod-init/).
  decision artifact(s: pp.Spec) -> pp.Art {
    when s.graph != "" ->
      pp.Art { cid: s.seq, op: NOOP, key: "", ctx: Ctx { key: s.key } };
    when has(s.cfgerr) && s.cfgerr != "" && (!has(s.st) || s.st == "" || s.st == "refused") ->
      pp.Art { cid: s.seq, op: PUT, key: "sandbox-status/" + s.key,
               p1: "state=refused;code=", p2: s.cfgerr, ctx: Ctx { key: s.key } };
    when has(s.cfgerr) && s.cfgerr != "" ->
      pp.Art { cid: s.seq, op: NOOP, key: "", ctx: Ctx { key: s.key } };
    when has(s.gate) && s.gate > 0 && (!has(s.done) || s.done < s.gate) ->
      pp.Art { cid: s.seq, op: NOOP, key: "", ctx: Ctx { key: s.key } };
    when s.image != "" && s.rootfs == "" && has(s.res_cmd) && s.res_cmd != "" && has(s.res_rootfs)
         && s.res_rootfs != "" && !s.res_rootfs.startsWith("pack:") && has(s.nonroot) && s.nonroot == "1"
         && (!has(s.ruid) || s.ruid == "") && (!has(s.res_uid) || s.res_uid == "") && (!has(s.st) || s.st == "" || s.st == "refused") ->
      pp.Art { cid: s.seq, op: PUT, key: "sandbox-status/" + s.key,
               p1: "state=refused;code=container has runAsNonRoot and image has non-numeric user (", p2: s.res_user,
               p3: "), cannot verify user is non-root", ctx: Ctx { key: s.key } };
    when s.image != "" && s.rootfs == "" && has(s.res_cmd) && s.res_cmd != "" && has(s.res_rootfs)
         && s.res_rootfs != "" && !s.res_rootfs.startsWith("pack:") && has(s.nonroot) && s.nonroot == "1"
         && (!has(s.ruid) || s.ruid == "") && has(s.res_uid) && s.res_uid == "0" && (!has(s.st) || s.st == "" || s.st == "refused") ->
      pp.Art { cid: s.seq, op: PUT, key: "sandbox-status/" + s.key,
               p1: "state=refused;code=container has runAsNonRoot and image will run as root", ctx: Ctx { key: s.key } };
    when s.image != "" && s.rootfs == "" && has(s.res_cmd) && s.res_cmd != "" && has(s.res_rootfs)
         && s.res_rootfs != "" && !s.res_rootfs.startsWith("pack:") && has(s.nonroot) && s.nonroot == "1"
         && (!has(s.ruid) || s.ruid == "") && (!has(s.res_uid) || s.res_uid == "" || s.res_uid == "0") ->
      pp.Art { cid: s.seq, op: NOOP, key: "", ctx: Ctx { key: s.key } };
    when s.image != "" && s.rootfs == "" && has(s.res_cmd) && s.res_cmd != "" && has(s.res_rootfs)
         && s.res_rootfs != "" && !s.res_rootfs.startsWith("pack:") ->
      pp.Art { cid: s.seq, op: MERGE, key: "sandboxes/" + s.key,
               p1: "cmd=", p2: s.res_cmd, p3: ";rootfs=", p4: s.res_rootfs,
               p5: ";iso=1;env=", p6: s.res_env, p7: ",", p8: s.env,
               p9: ";host=", p10: s.pod.substring(s.pod.indexOf("/") + 1),
               p11: ";wd=", p12: s.workdir, p13: ";iwd=", p14: s.res_wd,
               p15: ";user=", p16: s.res_user, p17: "/", p18: s.ruid, p19: "/", p20: s.rgid,
               p21: ";cpu=", p22: s.cpu, p23: ";mem=", p24: s.mem, p25: ";eph=", p26: s.eph,
               p27: ";tasks=", p28: s.tasks, p29: ";net=", p30: s.net, p31: ";dns=", p32: s.dns,
               ctx: Ctx { key: s.key } };
    when s.image != "" && s.rootfs == "" ->
      pp.Art { cid: s.seq, op: NOOP, key: "", ctx: Ctx { key: s.key } };
    when s.cmd != "" && has(s.nonroot) && s.nonroot == "1" && (!has(s.ruid) || s.ruid == "" || s.ruid == "0")
         && (!has(s.st) || s.st == "" || s.st == "refused") ->
      pp.Art { cid: s.seq, op: PUT, key: "sandbox-status/" + s.key,
               p1: "state=refused;code=container has runAsNonRoot and image will run as root", ctx: Ctx { key: s.key } };
    when s.cmd != "" && has(s.nonroot) && s.nonroot == "1" && (!has(s.ruid) || s.ruid == "" || s.ruid == "0") ->
      pp.Art { cid: s.seq, op: NOOP, key: "", ctx: Ctx { key: s.key } };
    when s.cmd != "" && s.args != "" ->
      pp.Art { cid: s.seq, op: MERGE, key: "sandboxes/" + s.key,
               p1: "cmd=", p2: s.cmd, p3: " ", p4: s.args, p5: ";rootfs=", p6: s.rootfs,
               p7: ";iso=", p8: s.iso, p9: ";env=", p10: s.env,
               p11: ";host=", p12: s.pod.substring(s.pod.indexOf("/") + 1),
               p13: ";wd=", p14: s.workdir, p15: ";iwd=;user=/", p16: s.ruid, p17: "/", p18: s.rgid,
               p19: ";cpu=", p20: s.cpu, p21: ";mem=", p22: s.mem, p23: ";eph=", p24: s.eph,
               p25: ";tasks=", p26: s.tasks, p27: ";net=", p28: s.net, p29: ";dns=", p30: s.dns,
               ctx: Ctx { key: s.key } };
    when s.cmd != "" ->
      pp.Art { cid: s.seq, op: MERGE, key: "sandboxes/" + s.key,
               p1: "cmd=", p2: s.cmd, p3: ";rootfs=", p4: s.rootfs,
               p5: ";iso=", p6: s.iso, p7: ";env=", p8: s.env,
               p9: ";host=", p10: s.pod.substring(s.pod.indexOf("/") + 1),
               p11: ";wd=", p12: s.workdir, p13: ";iwd=;user=/", p14: s.ruid, p15: "/", p16: s.rgid,
               p17: ";cpu=", p18: s.cpu, p19: ";mem=", p20: s.mem, p21: ";eph=", p22: s.eph,
               p23: ";tasks=", p24: s.tasks, p25: ";net=", p26: s.net, p27: ";dns=", p28: s.dns,
               ctx: Ctx { key: s.key } };
    default ->
      pp.Art { cid: s.seq, op: NOOP, key: "", ctx: Ctx { key: s.key } };
  }
  // A graph-backed Pod's sandbox, with the same limits (the CREATE header is
  // one for every kind of workload).
  decision metal(s: pp.Spec) -> pp.Art {
    // A workload image: no sandbox until its pull resolved to a pack — the
    // Pod is Pending meanwhile — then the sandbox names it.
    when s.graph != "" && has(s.image) && s.image != "" && has(s.res_rootfs)
         && s.res_rootfs.startsWith("pack:") ->
      pp.Art { cid: s.seq, op: MERGE, key: s.key,
               p1: "graph=", p2: s.graph, p3: ";pack=", p4: s.res_rootfs.substring(5),
               p5: ";cpu=", p6: s.cpu, p7: ";mem=", p8: s.mem, p9: ";eph=", p10: s.eph,
               ctx: Ctx { key: s.key } };
    when s.graph != "" && has(s.image) && s.image != "" ->
      pp.Art { cid: s.seq, op: NOOP, key: "", ctx: Ctx { key: s.key } };
    when s.graph != "" ->
      pp.Art { cid: s.seq, op: MERGE, key: s.key,
               p1: "graph=", p2: s.graph, p3: ";cpu=", p4: s.cpu, p5: ";mem=", p6: s.mem,
               p7: ";eph=", p8: s.eph, ctx: Ctx { key: s.key } };
    default ->
      pp.Art { cid: s.seq, op: NOOP, key: "", ctx: Ctx { key: s.key } };
  }
  // The runtime record the lifecycle chain runs on. Create-if-absent: it is
  // the pod's memory, and recreating it would forget a kill in flight.
  decision runtime(m: pp.Made) -> pp.Act {
    default ->
      pp.Act { cid: m.cid, op: MERGE, key: m.ctx.key, v1: "seen=1" };
  }

  decision ask(r: pp.Rt) -> pp.Ask {
    default -> pp.Ask { cid: r.seq, op: EXISTS, key: r.key, ctx: Ctx { key: r.key, st: r.st, metal: r.metal } };
  }
  // A Pod whose spec is gone (its tomb expired at the plane): every record
  // the node keeps for it, by uid, goes — in one step, so none is left for a
  // chain to read as a Pod that still exists. But not while its sandbox may
  // still run: a node that was away for the Pod's whole deletion catches up
  // to a spec that is simply gone, never one that said `deleted`, and its
  // workload would be orphaned. So a live sandbox is asked to delete first;
  // the records go once it is destroyed (the source watches its status).
  decision prune(k: pp.Known) -> pp.Act {
    when k.status == 404 && has(k.ctx.st) && k.ctx.st != "" && k.ctx.st != "exited" && k.ctx.st != "failed"
         && k.ctx.st != "killed" && k.ctx.st != "destroyed" && has(k.ctx.metal) && k.ctx.metal != "" ->
      pp.Act { cid: k.cid, op: MERGE, key: "metal-sandboxes/", k2: k.ctx.key, v1: "phase=delete" };
    when k.status == 404 && has(k.ctx.st) && k.ctx.st != "" && k.ctx.st != "exited" && k.ctx.st != "failed"
         && k.ctx.st != "killed" && k.ctx.st != "destroyed" ->
      pp.Act { cid: k.cid, op: MERGE, key: "sandboxes/", k2: k.ctx.key, v1: "phase=delete" };
    when k.status == 404 ->
      pp.Act { cid: k.cid, op: DROP_EACH, key: k.ctx.key, k2: "",
               v1: "pod-runtime,pod-init,sandboxes,metal-sandboxes,sandbox-status,sandbox-boot-of,sandbox-logs,sandbox-log-n,sandbox-kill,sandbox-pause,pod-lifecycle-status,probe-status,probe-rt-l,probe-rt-r,pod-resolved,pod-cond,pod-wait,pod-probes,image-requests,image-digests,image-index,image-pull-failed,image-pull-auth" };
    default ->
      pp.Act { cid: k.cid, op: NOOP, key: "", k2: "", v1: "" };
  }

  transformation pass_spec(s: pp.Spec) -> pp.Spec {
    pp.Spec { seq: s.seq, rev: s.rev, key: s.key, cmd: s.cmd, rootfs: s.rootfs,
              iso: s.iso, net: s.net, tasks: s.tasks, graph: s.graph, image: s.image,
              args: s.args, env: s.env, workdir: s.workdir, cpu: s.cpu, mem: s.mem,
              eph: s.eph, pod: s.pod, res_rootfs: s.res_rootfs, res_cmd: s.res_cmd,
              res_env: s.res_env, res_wd: s.res_wd, res_user: s.res_user, res_uid: s.res_uid,
              ruid: s.ruid, rgid: s.rgid, nonroot: s.nonroot, cfgerr: s.cfgerr, gate: s.gate,
              dns: s.dns, done: s.done, st: s.st }
  }
  transformation pass_made(m: pp.Made) -> pp.Made {
    pp.Made { cid: m.cid, status: m.status, value: m.value, ctx: m.ctx }
  }
  transformation pass_rt(r: pp.Rt) -> pp.Rt { pp.Rt { seq: r.seq, rev: r.rev, key: r.key, st: r.st, metal: r.metal } }
  transformation pass_known(k: pp.Known) -> pp.Known {
    pp.Known { cid: k.cid, status: k.status, value: k.value, ctx: k.ctx }
  }
  pipeline art(s: pp.Spec) -> pp.Art { call x = pass_spec(s); call y = artifact(x); return y; }
  pipeline mtl(s: pp.Spec) -> pp.Art { call x = pass_spec(s); call y = metal(x); return y; }
  pipeline rt(m: pp.Made) -> pp.Act { call x = pass_made(m); call y = runtime(x); return y; }
  pipeline ak(r: pp.Rt) -> pp.Ask { call x = pass_rt(r); call y = ask(x); return y; }
  pipeline pr(k: pp.Known) -> pp.Act { call x = pass_known(k); call y = prune(x); return y; }
  entry art = art;
  entry mtl = mtl;
  entry rt = rt;
  entry ak = ak;
  entry pr = pr;
  provenance revision "podproject-artifact" toolchain "chronicle-authoring";
}
