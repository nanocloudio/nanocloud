// Service proxying as params — kube-proxy's decision half.
//
//   row    /services/ JOIN its /endpointslices/<ns>/<svc>/ (scoped): one row
//          per (Service, ready backend) at /np-rows/proxy/<ns>/<svc>/<pod> =
//          "kind=dnat;vip=…;vports=…;tports=…;protos=…;backend=<ip>;
//          pnames=…;pnums=…", the ports as the aligned lists the source
//          collects from spec.ports[]. A Service with no ClusterIP (headless,
//          `None`) or no ports gets none. Each backend's Pod is read first
//          (`ask`, a GET of /pods/<ns>/<pod>) for its container's named ports
//          (`spec.containers.0.ports[].name` and `.containerPort`, aligned):
//          a targetPort that NAMES a port resolves against the Pod it leads
//          to, as Kubernetes resolves it per endpoint — net_apply looks the
//          name up in that row's pnames/pnums, and a backend whose Pod has no
//          such port gets no rule for it. A NodePort or LoadBalancer
//          Service's node ports (`spec.ports[].nodePort`, aligned) and its
//          load-balancer address (`status.loadBalancer.ingress[0].ip`) ride
//          along as nports=…;lbip=…: each node DNATs its own address at each
//          node port, and the load-balancer address at each port, to the
//          same backends (svc_alloc allocates both).
//   prune  a row whose Service's ClusterIP is no longer its vip, or whose
//          slice no longer holds its backend, is deleted.
// `net_apply` turns the rows into the `proxy` net.policy table; the platform
// merges one VIP's rows into one balanced service.
module nanocloud.proxy {
  enum NOOP = 0;
  enum GET = 1;
  enum PUT = 3;
  enum DELETE = 4;

  // The row's makings, carried across the Pod read (the reserved carry
  // field, echoed unchanged by the connector).
  message Ctx {
    key: string = 30;
    pod: string = 31;
    vip: string = 32;
    ports: string = 33;
    tports: string = 34;
    protos: string = 35;
    ip: string = 36;
    nports: string = 37;
    lbip: string = 38;
  }
  message Pair {
    seq: int = 1;
    key: string = 3;       // <ns>/<svc>
    vip: string = 4;       // spec.clusterIP
    ports: string = 5;     // spec.ports[].port
    tports: string = 6;    // spec.ports[].targetPort
    protos: string = 7;    // spec.ports[].protocol
    nports: string = 8;    // spec.ports[].nodePort
    lbip: string = 9;      // status.loadBalancer.ingress.0.ip
    pod: string = 21;      // the slice's pod
    ns: string = 28;       // the Service's namespace
    ip: string = 60;       // the slice: the backend address
  }
  message PodGet {
    cid: int = 1;
    op: int = 2;
    key: string = 3;
    sep: string = 17;
    name: string = 18;
    ctx: Ctx = 254;
  }
  message PodPorts {
    cid: int = 1;
    status: int = 2;
    pnames: string = 40;   // store_effect `paths`: spec.containers.0.ports[].name
    pnums: string = 41;    //                       spec.containers.0.ports[].containerPort
    ctx: Ctx = 254;
  }
  message RowPut {
    cid: int = 1;
    op: int = 2;
    key: string = 3;
    sep: string = 17;
    pod: string = 18;
    v1: string = 4; v2: string = 5; v3: string = 6; v4: string = 7; v5: string = 8;
    v6: string = 9; v7: string = 10; v8: string = 11; v9: string = 12; v10: string = 13;
    v11: string = 14; v12: string = 15; v13: string = 16; v14: string = 80;
    v15: string = 81; v16: string = 82; v17: string = 83; v18: string = 84;
  }
  message Row {
    seq: int = 1;
    rev: int = 2;          // the row's revision (source `rev = 1`)
    key: string = 3;       // <ns>/<svc>/<pod>
    vip: string = 4;
    backend: string = 5;
    svip: string = 70;     // the Service's ClusterIP now (related ^1)
    sip: string = 80;      // the slice's address now (related)
  }
  // Conditional on the revision judged (28): a row rewritten meanwhile stays.
  message RowDel {
    cid: int = 1;
    op: int = 2;
    key: string = 3;
    rev: int = 28;
  }

  // No row to make: read no Pod (a NOOP carries the empty context on, and
  // `row` makes nothing of it).
  decision ask(p: Pair) -> PodGet {
    when p.vip == "" || p.vip == "None" || p.ip == "" || p.ports == "" ->
      PodGet { cid: p.seq, op: NOOP, key: "", sep: "", name: "",
               ctx: Ctx { key: "", pod: "", vip: "", ports: "", tports: "", protos: "", ip: "",
                          nports: "", lbip: "" } };
    default ->
      PodGet { cid: p.seq, op: GET, key: p.ns, sep: "/", name: p.pod,
               ctx: Ctx { key: p.key, pod: p.pod, vip: p.vip, ports: p.ports, tports: p.tports,
                          protos: p.protos, ip: p.ip, nports: p.nports, lbip: p.lbip } };
  }
  // The Pod gone (404): no named port of it resolves, and the numbered ones
  // still lead to its address until its slice is pruned.
  decision row(g: PodPorts) -> RowPut {
    when g.ctx.vip == "" ->
      RowPut { cid: g.cid, op: NOOP, key: "", sep: "", pod: "",
               v1: "", v2: "", v3: "", v4: "", v5: "", v6: "", v7: "", v8: "", v9: "", v10: "",
               v11: "", v12: "", v13: "", v14: "", v15: "", v16: "", v17: "", v18: "" };
    default ->
      RowPut { cid: g.cid, op: PUT, key: g.ctx.key, sep: "/", pod: g.ctx.pod,
               v1: "kind=dnat;vip=", v2: g.ctx.vip, v3: ";vports=", v4: g.ctx.ports,
               v5: ";tports=", v6: g.ctx.tports, v7: ";protos=", v8: g.ctx.protos,
               v9: ";backend=", v10: g.ctx.ip,
               v11: ";pnames=", v12: g.pnames, v13: ";pnums=", v14: g.pnums,
               v15: ";nports=", v16: g.ctx.nports, v17: ";lbip=", v18: g.ctx.lbip };
  }
  decision prune(r: Row) -> RowDel {
    when r.svip != r.vip || r.sip != r.backend ->
      RowDel { cid: r.seq, op: DELETE, key: r.key, rev: r.rev };
    default -> RowDel { cid: r.seq, op: NOOP, key: "", rev: 0 };
  }
  transformation pp(p: Pair) -> Pair {
    Pair { seq: p.seq, key: p.key, vip: p.vip, ports: p.ports, tports: p.tports,
           protos: p.protos, nports: p.nports, lbip: p.lbip, pod: p.pod, ns: p.ns, ip: p.ip }
  }
  transformation pg(g: PodPorts) -> PodPorts {
    PodPorts { cid: g.cid, status: g.status, pnames: g.pnames, pnums: g.pnums,
               ctx: Ctx { key: g.ctx.key, pod: g.ctx.pod, vip: g.ctx.vip, ports: g.ctx.ports,
                          tports: g.ctx.tports, protos: g.ctx.protos, ip: g.ctx.ip,
                          nports: g.ctx.nports, lbip: g.ctx.lbip } }
  }
  transformation pr(r: Row) -> Row {
    Row { seq: r.seq, rev: r.rev, key: r.key, vip: r.vip, backend: r.backend, svip: r.svip, sip: r.sip }
  }
  pipeline px_ask(p: Pair) -> PodGet { call x = pp(p); call y = ask(x); return y; }
  pipeline px_row(g: PodPorts) -> RowPut { call x = pg(g); call y = row(x); return y; }
  pipeline px_prune(r: Row) -> RowDel { call x = pr(r); call y = prune(x); return y; }
  entry px_ask = px_ask;
  entry px_row = px_row;
  entry px_prune = px_prune;
  provenance revision "proxy-rows" toolchain "chronicle-authoring";
}
