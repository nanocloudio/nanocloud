// Service proxying as params — kube-proxy's decision half.
//
//   row    /services/ JOIN its /endpointslices/<ns>/<svc>/ (scoped): one row
//          per (Service, ready backend) at /np-rows/proxy/<ns>/<svc>/<pod> =
//          "kind=dnat;vip=…;vports=…;tports=…;protos=…;backend=<ip>", the
//          ports as the aligned lists the source collects from spec.ports[].
//          A Service with no ClusterIP (headless, `None`) or no ports gets
//          none.
//   prune  a row whose Service's ClusterIP is no longer its vip, or whose
//          slice no longer holds its backend, is deleted.
// `net_apply` turns the rows into the `proxy` net.policy table; the platform
// merges one VIP's rows into one balanced service.
module nanocloud.proxy {
  enum NOOP = 0;
  enum PUT = 3;
  enum DELETE = 4;

  message Pair {
    seq: int = 1;
    key: string = 3;       // <ns>/<svc>
    vip: string = 4;       // spec.clusterIP
    ports: string = 5;     // spec.ports[].port
    tports: string = 6;    // spec.ports[].targetPort
    protos: string = 7;    // spec.ports[].protocol
    pod: string = 21;      // the slice's pod
    ip: string = 60;       // the slice: the backend address
  }
  message RowPut {
    cid: int = 1;
    op: int = 2;
    key: string = 3;
    sep: string = 17;
    pod: string = 18;
    v1: string = 4; v2: string = 5; v3: string = 6; v4: string = 7; v5: string = 8;
    v6: string = 9; v7: string = 10; v8: string = 11; v9: string = 12; v10: string = 13;
  }
  message Row {
    seq: int = 1;
    rev: int = 2;          // the row's revision (source `rev = 1`)
    key: string = 3;       // <ns>/<svc>/<pod>
    vip: string = 4;
    backend: string = 5;
    svip: string = 70;     // the Service's ClusterIP now (related ^1)
    sip: string = 80;      // the slice's address now (related)
  }
  // Conditional on the revision judged (28): a row rewritten meanwhile stays.
  message RowDel {
    cid: int = 1;
    op: int = 2;
    key: string = 3;
    rev: int = 28;
  }

  decision row(p: Pair) -> RowPut {
    when p.vip == "" || p.vip == "None" || p.ip == "" || p.ports == "" ->
      RowPut { cid: p.seq, op: NOOP, key: "", sep: "", pod: "",
               v1: "", v2: "", v3: "", v4: "", v5: "", v6: "", v7: "", v8: "", v9: "", v10: "" };
    default ->
      RowPut { cid: p.seq, op: PUT, key: p.key, sep: "/", pod: p.pod,
               v1: "kind=dnat;vip=", v2: p.vip, v3: ";vports=", v4: p.ports,
               v5: ";tports=", v6: p.tports, v7: ";protos=", v8: p.protos,
               v9: ";backend=", v10: p.ip };
  }
  decision prune(r: Row) -> RowDel {
    when r.svip != r.vip || r.sip != r.backend ->
      RowDel { cid: r.seq, op: DELETE, key: r.key, rev: r.rev };
    default -> RowDel { cid: r.seq, op: NOOP, key: "", rev: 0 };
  }
  transformation pp(p: Pair) -> Pair {
    Pair { seq: p.seq, key: p.key, vip: p.vip, ports: p.ports, tports: p.tports,
           protos: p.protos, pod: p.pod, ip: p.ip }
  }
  transformation pr(r: Row) -> Row {
    Row { seq: r.seq, rev: r.rev, key: r.key, vip: r.vip, backend: r.backend, svip: r.svip, sip: r.sip }
  }
  pipeline px_row(p: Pair) -> RowPut { call x = pp(p); call y = row(x); return y; }
  pipeline px_prune(r: Row) -> RowDel { call x = pr(r); call y = prune(x); return y; }
  entry px_row = px_row;
  entry px_prune = px_prune;
  provenance revision "proxy-rows" toolchain "chronicle-authoring";
}
