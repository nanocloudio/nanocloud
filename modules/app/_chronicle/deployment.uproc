// Deployment -> ReplicaSet as params. The projection half of the workload
// chain: a Deployment's spec, owned by the Deployment, labelled with a digest
// of its pod template, written as the same-named ReplicaSet.
//
// Four stages, because a PUT-if-changed with rollout history is three store
// operations that depend on one read:
//   read     GET the current ReplicaSet (hashes projected)
//   archive  on a template change, PUT the old spec to controllerrevisions
//   write    PUT the ReplicaSet, unless nothing changed
//   record   the ScalingReplicaSet event, from the write's own reply
//
// The SPEC never rides the chain. A real Deployment's template (env,
// volumes, probes, resources) is kilobytes: carried in the context it
// overflowed the decision's 512 B scratch (no ReplicaSet past ~430 B of
// spec), and past a record it cannot cross at all. The chain carries the
// spec's DIGEST to decide with, and the writers SPLICE the bytes from the
// stored object (store_effect fields 70/71) — the archive from the current
// ReplicaSet, the write from the Deployment — whatever their size.
module nanocloud.deployment {

  // The context each chain here carries across its effects: ONE nested
  // message in the reserved carry field (254), echoed unchanged by every
  // connector. Small and bounded: names and digests, never the spec.
  // carried by: dp.Read, dp.Cur, dp.Arch, dp.Arched, dp.Write, dp.Written
  message Ctx {
    key: string = 30;
    shash: string = 31;   // FNV-1a of the Deployment's spec
    hash: string = 32;    // FNV-1a of spec.template: the pod-template-hash
    evt: string = 33;
    ns: string = 34;
    name: string = 35;
    ouid: string = 37;    // the Deployment's metadata.uid: its ReplicaSet's controller reference
  }

  message dp.Dep {
    seq: int = 1;
    rev: int = 2;
    key: string = 3;      // "<ns>/<name>" — the ReplicaSet has the SAME tail
    shash: string = 4;    // spec!hash — the spec's digest, never its bytes
    replicas: string = 5; // spec.replicas; empty = not a projectable Deployment
    uid: string = 6;      // metadata.uid, the ReplicaSet's controller reference
    ns: string = 28;      // the key's namespace segment — NOT metadata.namespace,
    name: string = 29;    // which a CLI-written document does not carry
    hash: string = 27;    // FNV-1a of spec.template, from the source
  }

  // Stage 1: read the current ReplicaSet, carrying everything the later
  // stages need — a reply is a status and projections, nothing else.
  message dp.Read {
    cid: int = 1;
    op: int = 2;
    key: string = 3;
    ctx: Ctx = 254;
  }
  message dp.Cur {
    cid: int = 1;
    status: int = 2;
    value: string = 3;
    cur_hash: string = 40;  // metadata.labels.pod-template-hash on the current RS
    cur_shash: string = 41; // spec!hash: its spec's digest (a spliced copy of
                            // the Deployment's, so equal digests = equal specs)
    ctx: Ctx = 254;
  }

  // Stage 2: archive the previous spec on a template change. The verdict for
  // the WRITE is decided here too, from the same read, and rides as `evt`:
  //   create  no ReplicaSet yet
  //   roll    template changed (hash differs) — archive first
  //   scale   same template, spec differs (a replicas edit)
  //   ""      nothing changed — the write stage does nothing
  // The archive's value is SPLICED from the current ReplicaSet: its spec.
  message dp.Arch {
    cid: int = 1;
    op: int = 2;
    key: string = 3;    // "<ns>/<name>" under /controllerrevisions.apps/
    xk: string = 17;    // "/previous"
    src: string = 70;   // splice source: "<ns>/<name>"
    splice: string = 71;
    ctx: Ctx = 254;
  }
  message dp.Arched {
    cid: int = 1;
    status: int = 2;
    value: string = 3;
    ctx: Ctx = 254;
  }

  // Stage 3: the ReplicaSet document, as value parts the connector joins,
  // with the template's labels (members) and the Deployment's spec SPLICED
  // in before p12 and p13 (fields 15 and 16).
  message dp.Write {
    cid: int = 1;
    op: int = 2;
    key: string = 3;
    p1: string = 4;   p2: string = 5;   p3: string = 6;
    p4: string = 7;   p5: string = 8;   p6: string = 9;
    p7: string = 10;  p8: string = 11;  p9: string = 12;
    p10: string = 13; p11: string = 14; p12: string = 15;
    p13: string = 16;
    src: string = 70;
    splice: string = 71;
    ctx: Ctx = 254;
  }
  message dp.Written {
    cid: int = 1;
    status: int = 2;
    value: string = 3;
    ctx: Ctx = 254;
  }

  // Stage 4: the event.
  message dp.Evt {
    cid: int = 1;
    op: int = 2;
    key: string = 3;
    xk: string = 17;
    v1: string = 4;   v2: string = 5;   v3: string = 6;
    v4: string = 7;   v5: string = 8;   v6: string = 9;
    v7: string = 10;  v8: string = 11;  v9: string = 12;
    v10: string = 13; v11: string = 14;
  }

  enum NOOP = 0;
  enum GET = 1;
  enum PUT = 3;

  decision read(d: dp.Dep) -> dp.Read {
    // A Deployment must declare spec.replicas to project a ReplicaSet.
    when d.replicas == "" ->
      dp.Read { cid: d.seq, op: NOOP, key: "", ctx: Ctx { key: d.key, shash: d.shash, hash: d.hash, ns: d.ns, name: d.name, ouid: d.uid } };
    default ->
      dp.Read { cid: d.seq, op: GET, key: d.key, ctx: Ctx { key: d.key, shash: d.shash, hash: d.hash, ns: d.ns, name: d.name, ouid: d.uid } };
  }

  decision archive(c: dp.Cur) -> dp.Arch {
    when c.status == 404 ->
      dp.Arch { cid: c.cid, op: NOOP, key: "", xk: "", ctx: Ctx { key: c.ctx.key, shash: c.ctx.shash, hash: c.ctx.hash, evt: "create", ns: c.ctx.ns, name: c.ctx.name, ouid: c.ctx.ouid } };
    when c.status == 200 && c.cur_hash != c.ctx.hash ->
      dp.Arch { cid: c.cid, op: PUT, key: c.ctx.key, xk: "/previous",
                src: c.ctx.key, splice: "/replicasets.apps/|0=spec",
                ctx: Ctx { key: c.ctx.key, shash: c.ctx.shash, hash: c.ctx.hash, evt: "roll", ns: c.ctx.ns, name: c.ctx.name, ouid: c.ctx.ouid } };
    when c.status == 200 && c.cur_shash != c.ctx.shash ->
      dp.Arch { cid: c.cid, op: NOOP, key: "", xk: "", ctx: Ctx { key: c.ctx.key, shash: c.ctx.shash, hash: c.ctx.hash, evt: "scale", ns: c.ctx.ns, name: c.ctx.name, ouid: c.ctx.ouid } };
    default ->
      dp.Arch { cid: c.cid, op: NOOP, key: "", xk: "", ctx: Ctx { key: c.ctx.key, shash: c.ctx.shash, hash: c.ctx.hash, evt: "", ns: c.ctx.ns, name: c.ctx.name, ouid: c.ctx.ouid } };
  }

  decision write(a: dp.Arched) -> dp.Write {
    when a.ctx.evt == "" ->
      dp.Write { cid: a.cid, op: NOOP, key: "", ctx: Ctx { key: a.ctx.key, evt: "", ns: a.ctx.ns, name: a.ctx.name } };
    // The ReplicaSet names its kind (a client decodes nothing without
    // apiVersion and kind) and carries the template's labels beside the
    // hash, as the ReplicaSet controller labels it. A template without
    // labels splices no members, and no comma before them.
    default ->
      dp.Write { cid: a.cid, op: PUT, key: a.ctx.key,
                 p1: "{\"apiVersion\":\"apps/v1\",\"kind\":\"ReplicaSet\",\"metadata\":{\"name\":\"",
                 p2: a.ctx.name,
                 p3: "\",\"namespace\":\"",
                 p4: a.ctx.ns,
                 p5: "\",\"ownerReferences\":[{\"apiVersion\":\"apps/v1\",\"kind\":\"Deployment\",\"name\":\"",
                 p6: a.ctx.name,
                 p7: "\",\"uid\":\"",
                 p8: a.ctx.ouid,
                 p9: "\",\"controller\":true,\"blockOwnerDeletion\":true}],\"labels\":{\"pod-template-hash\":\"",
                 p10: a.ctx.hash,
                 p11: "\"",
                 p12: "}},\"spec\":",
                 p13: "}",
                 src: a.ctx.key,
                 splice: "/deployments.apps/|15=,spec.template.metadata.labels.*;16=spec",
                 ctx: Ctx { key: a.ctx.key, evt: a.ctx.evt, ns: a.ctx.ns, name: a.ctx.name } };
  }

  // One event for every change, as the module records it: k8s says
  // ScalingReplicaSet for a create and a scale alike.
  decision record(w: dp.Written) -> dp.Evt {
    when w.ctx.evt != "" && w.status == 200 ->
      dp.Evt { cid: w.cid, op: PUT, key: w.ctx.key, xk: ".ScalingReplicaSet.0",
               v1: "{\"metadata\":{\"name\":\"",
               v2: w.ctx.name,
               v3: ".ScalingReplicaSet.0\",\"namespace\":\"",
               v4: w.ctx.ns,
               v5: "\"},\"involvedObject\":{\"kind\":\"Deployment\",\"namespace\":\"",
               v6: w.ctx.ns,
               v7: "\",\"name\":\"",
               v8: w.ctx.name,
               v9: "\"},\"reason\":\"ScalingReplicaSet\",\"message\":\"Scaled up replica set ",
               v10: w.ctx.name,
               v11: "\",\"type\":\"Normal\",\"count\":1}" };
    default ->
      dp.Evt { cid: w.cid, op: NOOP, key: "", xk: "" };
  }

  transformation pass_dep(d: dp.Dep) -> dp.Dep {
    dp.Dep { seq: d.seq, rev: d.rev, key: d.key, ns: d.ns, name: d.name,
             shash: d.shash, replicas: d.replicas, uid: d.uid, hash: d.hash }
  }
  transformation pass_cur(c: dp.Cur) -> dp.Cur {
    dp.Cur { cid: c.cid, status: c.status, value: c.value,
             cur_hash: c.cur_hash, cur_shash: c.cur_shash, ctx: c.ctx }
  }
  transformation pass_arched(a: dp.Arched) -> dp.Arched {
    dp.Arched { cid: a.cid, status: a.status, value: a.value, ctx: a.ctx }
  }
  transformation pass_written(w: dp.Written) -> dp.Written {
    dp.Written { cid: w.cid, status: w.status, value: w.value, ctx: w.ctx }
  }

  pipeline rd(d: dp.Dep) -> dp.Read {
    call x = pass_dep(d);
    call y = read(x);
    return y;
  }
  pipeline arch(c: dp.Cur) -> dp.Arch {
    call x = pass_cur(c);
    call y = archive(x);
    return y;
  }
  pipeline wr(a: dp.Arched) -> dp.Write {
    call x = pass_arched(a);
    call y = write(x);
    return y;
  }
  pipeline rec(w: dp.Written) -> dp.Evt {
    call x = pass_written(w);
    call y = record(x);
    return y;
  }

  entry rd = rd;
  entry arch = arch;
  entry wr = wr;
  entry rec = rec;

  provenance revision "deployment-project" toolchain "chronicle-authoring";
}
