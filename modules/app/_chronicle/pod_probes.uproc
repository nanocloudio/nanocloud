// A scheduled Pod's probes as its node's ask: /pods/ bound to a node ->
// /~node/<node>/pod-probes/<uid>, the flat record the node's probe chain
// (probe.uproc, probe_collect.uproc) runs:
//
//   rp_cmd rp_period rp_timeout rp_fail rp_succ rp_delay     (readiness)
//   lp_cmd lp_period lp_timeout lp_fail lp_succ lp_delay     (liveness)
//
// from the container's readinessProbe and livenessProbe: an exec probe's
// command as argv (`!jargv`), periodSeconds, timeoutSeconds,
// failureThreshold, successThreshold, initialDelaySeconds — each as stated,
// empty when unstated, which the probe chain reads as upstream's default
// (10 s, 1 s, 3, 1, 0). Only an exec probe has a command; an httpGet,
// tcpSocket or grpc probe reads as none (not run). A graph-backed Pod has no
// exec seam and gets no record. Its own record beside /pod-specs/ (which
// keeps `rp_cmd`, the readiness gate the status reads): the spec's record
// has no room left for twelve more fields, and a record's write is
// put-if-changed, so the two never fight. A Pod with no probe has none
// (delete-if-present); a deleted Pod's goes with the rest of its records
// (pod_project.uproc prune).
module nanocloud.podprobes {

  enum NOOP = 0;
  enum PUT = 3;
  enum DELETE = 4;

  message pp.Pod {
    seq: int = 1;
    key: string = 3;      // "<ns>/<name>"
    uid: string = 4;      // metadata.uid
    node: string = 5;     // spec.nodeName
    deleting: string = 6; // metadata.deletionTimestamp
    rtc: string = 7;      // spec.runtimeClassName
    rcmd: string = 70;    // readinessProbe (the Pod itself, `related`)
    rper: string = 71;
    rto: string = 72;
    rfail: string = 73;
    rsucc: string = 74;
    rdel: string = 75;
    lcmd: string = 80;    // livenessProbe
    lper: string = 81;
    lto: string = 82;
    lfail: string = 83;
    lsucc: string = 84;
    ldel: string = 85;
  }
  message pp.Put {
    cid: int = 1;
    op: int = 2;
    key: string = 3;
    p1: string = 4;   p2: string = 5;   p3: string = 6;   p4: string = 7;
    p5: string = 8;   p6: string = 9;   p7: string = 10;  p8: string = 11;
    p9: string = 12;  p10: string = 13; p11: string = 14; p12: string = 15;
    p13: string = 16; p14: string = 80; p15: string = 81; p16: string = 82;
    p17: string = 83; p18: string = 84; p19: string = 85; p20: string = 86;
    p21: string = 87; p22: string = 88; p23: string = 89; p24: string = 90;
  }

  decision probes(p: pp.Pod) -> pp.Put {
    when p.node == "" || p.uid == "" || p.deleting != "" ->
      pp.Put { cid: p.seq, op: NOOP, key: "" };
    when p.rtc == "fluxor" || (p.rcmd == "" && p.lcmd == "") ->
      pp.Put { cid: p.seq, op: DELETE, key: p.node + "/pod-probes/" + p.uid };
    default ->
      pp.Put { cid: p.seq, op: PUT, key: p.node + "/pod-probes/" + p.uid,
               p1: "rp_cmd=", p2: p.rcmd, p3: ";rp_period=", p4: p.rper, p5: ";rp_timeout=", p6: p.rto,
               p7: ";rp_fail=", p8: p.rfail, p9: ";rp_succ=", p10: p.rsucc, p11: ";rp_delay=", p12: p.rdel,
               p13: ";lp_cmd=", p14: p.lcmd, p15: ";lp_period=", p16: p.lper, p17: ";lp_timeout=", p18: p.lto,
               p19: ";lp_fail=", p20: p.lfail, p21: ";lp_succ=", p22: p.lsucc, p23: ";lp_delay=", p24: p.ldel };
  }

  pipeline probes_p(p: pp.Pod) -> pp.Put { call x = probes(p); return x; }
  entry probes = probes_p;
  provenance revision "pod-probes" toolchain "chronicle-authoring";
}
