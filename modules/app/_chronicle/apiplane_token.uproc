// The TokenRequest surface (`POST …/serviceaccounts/<name>/token`, what
// `kubectl create token` calls), compiled to params.
//
// The request chain (apiplane.uproc `probe`) reads the ServiceAccount and
// hands the request on as `@mint<key> <body>` in the answer; a missing
// ServiceAccount was answered NotFound already (apiplane_reply `act`). This
// stage, between the step after the write and the reply, builds the mint
// call kagi's `token_mint` signs, and hands `reply` the TokenRequest's
// name, namespace, audience and lifetime to answer with beside the token and
// its expiry. The issuer is the ONE the store-driven
// tokens use (sa_token.uproc: `tk_mint` over `token_mint`, vault key
// `nanocloud.ca`) — a vault label is one module's, so a second mint could not
// open that key, and a second key would be a second root every verifier must
// learn. Its answers fan to both readers; each keeps its own.
//
//   se_ans  -> tk_api (here) -> tk_mint (kagi_mint) -> reply   (and tk_resp)
//
// Every other record passes with no subject, which `kagi_mint` refuses
// without calling the mint and echoes with its carry — the reply reads only
// the carry for those.
//
// The request's `spec.expirationSeconds` is honoured from upstream's floor,
// 600 s (shorter is 422 Invalid, as upstream), and is an hour when absent;
// its first `spec.audiences` entry is the token's audience, and `nanocloud`
// (the audience this plane verifies) when it names none.
module nanocloud.apiplane_token {

  // The step after the write (se_ans), as `reply` reads it.
  message ActReply {
    cid: int = 1;
    status: int = 2;
    value: string = 3;
    c_cid: int = 30;
    c_status: int = 31;
    c_answer: string = 32;
    c_stream: int = 33;
    c_wstatus: int = 36;
  }

  // kagi_mint's request record (sa_token.uproc MintCall), with the reply's
  // carry beside it.
  message MintCall {
    cid: int = 1;
    s1: string = 40;
    s2: string = 41;
    s3: string = 42;
    s4: string = 43;
    aud: string = 44;
    ttl: int = 46;
    ck: string = 47;
    j1: string = 48;
    j2: string = 49;
    j3: string = 50;
    j4: string = 51;
    j5: string = 52;
    c_cid: int = 30;
    // The TokenRequest's name, namespace, audience and lifetime, for `reply`
    // (apiplane_reply), on carry numbers the step after the write leaves free.
    tk_name: string = 34;
    tk_ns: string = 35;
    tk_aud: string = 37;
    tk_ttl: string = 38;
    c_status: int = 31;
    c_answer: string = 32;
    c_stream: int = 33;
    c_wstatus: int = 36;
  }

