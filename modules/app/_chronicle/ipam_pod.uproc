// Address allocation as params: pod IPs.
// (The two pools share this design; ipam_svc.uproc and ipam_pod.uproc are
// split only because one module holds at most 16 decisions and 8 entries.)
//
// One shape for both pools. An address is CLAIMED by creating the key
// `/ipam/<pool>/<address as u32>` under the store's ABSENT precondition, so two
// allocators that pick the same candidate cannot both win: the store answers
// the loser 409 at one linearization point. A per-pool cursor
// (`/ipam-cursor/<pool>` = `n=…[;net=…;span=…]`) makes the pick next-fit —
// candidate = net + 1 + (n mod span) — and every attempt, won or lost,
// advances it. There is no "lowest free" search and nothing seeded per
// address: a taken candidate costs one 409 and one bump.
//
//   allocate  the FIRST owner still waiting (count index 0) -> GET cursor ->
//             CREATE claim -> bump cursor -> commit the address to the owner
//             (or, when the claim was lost, touch /ipam-retry/<pool>)
//   backfill  every address already in use is claimed, and the LAST record of
//             that scan (or the one record `empty` sends for an empty set)
//             creates the cursor. Allocation reads the cursor first, so it
//             cannot start until every existing address holds its claim.
//   release   a claim whose owner is gone, or whose owner now holds a
//             different address, is deleted.
//
// Services commit by PATCHing spec.clusterIP (the Service is its own lease).
// Pods commit by CREATING /ipam-lease/<id> — create-only, so a lease is never
// reassigned, and a request is "waiting" while it has none (`unless`).
//
// A Pod's address comes from its NODE's Pod CIDR: the request names it
// (`/ipam-request/<uid>` = `node=…;cidr=<the node's podCIDR>;pod=…`,
// pod_resolve's), and the candidate is taken from that CIDR. A request
// naming none (a sandbox's own, the runner's) takes the pool's, /ipam-pool.
// Either way the CIDR's first host address is never leased: it is the
// gateway the node holds on that segment (node_net), so candidates start at
// the second — net + 2 + (n mod span), span the hosts less the gateway.
// The cursor's `n` is the cluster's one next-fit counter; claims are
// cluster-wide (/ipam/pod/<u32>), so two nodes' CIDRs never share one.
module nanocloud.ipam_pod {

  // The context each chain here carries across its effects: ONE nested
  // message in the reserved carry field (254), echoed unchanged by every
  // connector. Inner numbers are the old carry-through numbers, so every
  // module that hands a context on agrees on it.
  // carried by: CurGet, Cur, ClaimCall, Claimed, BumpCall, Bumped
  message Ctx {
    key: string = 30;
    n: int = 31;
    ip: int = 32;
    st: int = 34;
    rnet: int = 35;        // the request's CIDR (its node's), as a number
    rspan: int = 36;       //   its hosts less the gateway (0: none named)
  }
  // carried by: BackfillCall, BackfillReply, ReadyCall, PoolReply
  message Ctx2 {
    last: int = 30;
    pool: string = 31;
  }
  enum NOOP = 0;
  enum GET = 1;
  enum PUT = 3;
  enum MERGE = 6;
  enum CREATE = 8;
  // The pod pool's default when /ipam-pool is absent: 10.244.0.0/24.
  enum POD_NET = 183762944;
  enum POD_SPAN = 254;

  // ---- records ----

  message Waiting {        // an owner with no address yet (count mode)
    seq: int = 1;
    key: string = 3;
    idx: int = 20;
    net: int = 50;         // its request's cidr, as a number (flat ints cidr!ip4)
    pfx: int = 51;         //   and its prefix length (cidr!prefix; 0: none)
  }
  message CurGet {
    cid: int = 1;
    op: int = 2;
    key: string = 3;
    ctx: Ctx = 254;
  }
  message Cur {            // the cursor, read back (flat ints n,net,span)
    cid: int = 1;
    status: int = 2;
    n: int = 50;
    net: int = 51;
    span: int = 52;
    ctx: Ctx = 254;
  }
  message ClaimCall {
    cid: int = 1;
    op: int = 2;
    key: int = 3;          // the candidate address, as a number
    v1: string = 4;        // owner=<key>;ip=<address>
    v2: string = 5;
    v3: string = 6;
    v4: int = 7;
    ctx: Ctx = 254;
  }
  message Claimed {
    cid: int = 1;
    status: int = 2;
    ctx: Ctx = 254;
  }
  message BumpCall {       // advance the cursor, carrying the claim's outcome
    cid: int = 1;
    op: int = 2;
    key: string = 3;
    v1: string = 4;
    v2: int = 5;
    ctx: Ctx = 254;
  }
  message Bumped {
    cid: int = 1;
    status: int = 2;
    ctx: Ctx = 254;
  }
  message CommitCall {     // the address to its owner, or a retry wake
    cid: int = 1;
    op: int = 2;
    key: string = 3;
    key2: string = 17;
    path: string = 19;
    v1: string = 4;
    v2: int = 5;
    v3: string = 6;
    v4: int = 7;
    v5: string = 8;
    v6: int = 9;
    v7: string = 10;
    v8: int = 11;
    v9: string = 12;
  }

  message InUse {          // backfill: every owner, its address as a number
    seq: int = 1;
    key: string = 3;
    idx: int = 20;
    count: int = 22;
    ip: int = 50;
  }
  message BackfillCall {
    cid: int = 1;
    op: int = 2;
    key: int = 3;
    v1: string = 4;
    v2: string = 5;
    v3: string = 6;
    v4: int = 7;
    ctx: Ctx2 = 254;
  }
  message BackfillReply {
    cid: int = 1;
    status: int = 2;
    ctx: Ctx2 = 254;
  }
  message ReadyCall {
    cid: int = 1;
    op: int = 2;
    key: string = 3;
    v1: string = 4;
    v2: int = 5;
    v3: string = 6;
    v4: int = 7;
    ctx: Ctx2 = 254;
  }
  message PoolReply {      // /ipam-pool, read back (flat ints cidr!ip4, cidr!prefix)
    cid: int = 1;
    status: int = 2;
    net: int = 50;
    prefix: int = 51;
    ctx: Ctx2 = 254;
  }
  decision pod_cur(w: Waiting) -> CurGet {
    // A request naming its node's CIDR: its hosts less the gateway, 2^(32-p)
    // - 3 (network, gateway, broadcast) — worked out once, here, so the
    // claim's arithmetic is the pool's.
    when w.idx == 0 && w.pfx > 0 && w.pfx <= 30 ->
      CurGet { cid: w.seq, op: GET, key: "pod",
               ctx: Ctx { key: w.key, rnet: w.net, rspan: math.bitShiftLeft(1, 32 - w.pfx) - 3 } };
    when w.idx == 0 -> CurGet { cid: w.seq, op: GET, key: "pod", ctx: Ctx { key: w.key, rnet: 0, rspan: 0 } };
    default -> CurGet { cid: w.seq, op: NOOP, key: "", ctx: Ctx { key: w.key, rnet: 0, rspan: 0 } };
  }
  // A request naming its node's CIDR takes the candidate from it, from its
  // second host on (pod_cur worked out its span). One naming none takes the
  // pool's, whose span (hosts less network and broadcast) comes from its
  // cursor, written by the backfill — less the gateway too. A span that
  // would be zero would divide by zero; refuse it.
  decision pod_claim(c: Cur) -> ClaimCall {
    when c.status == 200 && c.ctx.rspan > 0 ->
      ClaimCall { cid: c.cid, op: CREATE,
                  key: c.ctx.rnet + 2 + (c.n - (c.n / c.ctx.rspan) * c.ctx.rspan),
                  v1: "owner=", v2: c.ctx.key, v3: ";ip=",
                  v4: c.ctx.rnet + 2 + (c.n - (c.n / c.ctx.rspan) * c.ctx.rspan),
                  ctx: Ctx { key: c.ctx.key, n: c.n, ip: c.ctx.rnet + 2 + (c.n - (c.n / c.ctx.rspan) * c.ctx.rspan) } };
    when c.status == 200 && c.span > 1 ->
      ClaimCall { cid: c.cid, op: CREATE,
                  key: c.net + 2 + (c.n - (c.n / (c.span - 1)) * (c.span - 1)),
                  v1: "owner=", v2: c.ctx.key, v3: ";ip=",
                  v4: c.net + 2 + (c.n - (c.n / (c.span - 1)) * (c.span - 1)), ctx: Ctx { key: c.ctx.key, n: c.n, ip: c.net + 2 + (c.n - (c.n / (c.span - 1)) * (c.span - 1)) } };
    default ->
      ClaimCall { cid: c.cid, op: NOOP, key: 0, v1: "", v2: "", v3: "", v4: 0, ctx: Ctx { key: c.ctx.key, n: c.n, ip: 0 } };
  }
  // The cursor moves BEFORE the commit, whether the claim was won or lost, so
  // the rescan the commit causes already sees the next candidate. Nothing this
  // chain writes before the commit is watched by its source: a rescan in the
  // middle of an allocation would pick the same owner again and race it.
  decision pod_bump(c: Claimed) -> BumpCall {
    when c.status == 200 || c.status == 409 ->
      BumpCall { cid: c.cid, op: MERGE, key: "pod", v1: "n=", v2: c.ctx.n + 1, ctx: Ctx { key: c.ctx.key, n: c.ctx.n, ip: c.ctx.ip, st: c.status } };
    default ->
      BumpCall { cid: c.cid, op: NOOP, key: "", v1: "", v2: 0, ctx: Ctx { key: c.ctx.key, n: c.ctx.n, ip: c.ctx.ip, st: c.status } };
  }
  // A won claim commits as a CREATE-only lease: a lease is never reassigned.
  // If one appeared meanwhile the claim is left owning an address its owner
  // does not hold, and the release chain frees it. The lease is also the
  // change that starts the next pass. A lost claim (409) writes the pool's
  // retry key instead, so the next pass takes the next candidate.
  decision pod_lease(b: Bumped) -> CommitCall {
    when b.ctx.st == 200 ->
      CommitCall { cid: b.cid, op: CREATE, key: "/ipam-lease/", key2: b.ctx.key, path: "",
                   v1: "", v2: math.bitAnd(math.bitShiftRight(b.ctx.ip, 24), 255),
                   v3: ".", v4: math.bitAnd(math.bitShiftRight(b.ctx.ip, 16), 255),
                   v5: ".", v6: math.bitAnd(math.bitShiftRight(b.ctx.ip, 8), 255),
                   v7: ".", v8: math.bitAnd(b.ctx.ip, 255), v9: "" };
    when b.ctx.st == 409 ->
      CommitCall { cid: b.cid, op: PUT, key: "/ipam-retry/", key2: "pod", path: "",
                   v1: "n=", v2: b.ctx.n + 1 };
    default -> CommitCall { cid: b.cid, op: NOOP, key: "", key2: "", path: "" };
  }

  // ---- backfill (both pools) ----

  // Claim every address in use. `idx + 1 >= count` is the LAST record of the
  // scan — and also the single record `empty` sends when there is nothing in
  // use (idx 0, count 0) — which is where the cursor gets created.
  decision backfill(r: InUse) -> BackfillCall {
    when r.ip != 0 && r.idx + 1 >= r.count ->
      BackfillCall { cid: r.seq, op: CREATE, key: r.ip,
                     v1: "owner=", v2: r.key, v3: ";ip=", v4: r.ip, ctx: Ctx2 { last: 1 } };
    when r.ip != 0 ->
      BackfillCall { cid: r.seq, op: CREATE, key: r.ip,
                     v1: "owner=", v2: r.key, v3: ";ip=", v4: r.ip, ctx: Ctx2 { last: 0 } };
    when r.idx + 1 >= r.count ->
      BackfillCall { cid: r.seq, op: NOOP, key: 0, v1: "", v2: "", v3: "", v4: 0, ctx: Ctx2 { last: 1 } };
    default ->
      BackfillCall { cid: r.seq, op: NOOP, key: 0, v1: "", v2: "", v3: "", v4: 0, ctx: Ctx2 { last: 0 } };
  }
  // The pod cursor also carries the pool: read /ipam-pool first.
  decision pod_pool(r: BackfillReply) -> ReadyCall {
    when r.ctx.last == 1 -> ReadyCall { cid: r.cid, op: GET, key: "/ipam-pool", v1: "", ctx: Ctx2 { last: 1, pool: "pod" } };
    default -> ReadyCall { cid: r.cid, op: NOOP, key: "", v1: "", ctx: Ctx2 { last: 0, pool: "pod" } };
  }
  // span = hosts in the CIDR less network and broadcast. No pool = the default.
  decision pod_ready(p: PoolReply) -> ReadyCall {
    when p.ctx.last == 1 && p.status == 200 && p.prefix > 0 && p.prefix < 31 ->
      ReadyCall { cid: p.cid, op: CREATE, key: "pod", v1: "n=0;net=", v2: p.net,
                  v3: ";span=", v4: math.bitShiftLeft(1, 32 - p.prefix) - 2, ctx: Ctx2 { last: 1, pool: "pod" } };
    when p.ctx.last == 1 && p.status == 404 ->
      ReadyCall { cid: p.cid, op: CREATE, key: "pod", v1: "n=0;net=", v2: POD_NET,
                  v3: ";span=", v4: POD_SPAN, ctx: Ctx2 { last: 1, pool: "pod" } };
    default -> ReadyCall { cid: p.cid, op: NOOP, key: "", v1: "", ctx: Ctx2 { last: 0, pool: "pod" } };
  }

  // ---- stage wrappers ----
  transformation pw(w: Waiting) -> Waiting { Waiting { seq: w.seq, key: w.key, idx: w.idx, net: w.net, pfx: w.pfx } }
  transformation pc(c: Cur) -> Cur {
    Cur { cid: c.cid, status: c.status, n: c.n, net: c.net, span: c.span, ctx: Ctx { key: c.ctx.key, rnet: c.ctx.rnet, rspan: c.ctx.rspan } }
  }
  transformation pcl(c: Claimed) -> Claimed {
    Claimed { cid: c.cid, status: c.status, ctx: Ctx { key: c.ctx.key, n: c.ctx.n, ip: c.ctx.ip } }
  }
  transformation pbm(b: Bumped) -> Bumped {
    Bumped { cid: b.cid, status: b.status, ctx: b.ctx }
  }
  transformation pu(r: InUse) -> InUse {
    InUse { seq: r.seq, key: r.key, idx: r.idx, count: r.count, ip: r.ip }
  }
  transformation pb(r: BackfillReply) -> BackfillReply {
    BackfillReply { cid: r.cid, status: r.status, ctx: Ctx2 { last: r.ctx.last } }
  }
  transformation pp(p: PoolReply) -> PoolReply {
    PoolReply { cid: p.cid, status: p.status, net: p.net, prefix: p.prefix, ctx: p.ctx }
  }

  pipeline pa_cur(w: Waiting) -> CurGet { call x = pw(w); call y = pod_cur(x); return y; }
  pipeline pa_claim(c: Cur) -> ClaimCall { call x = pc(c); call y = pod_claim(x); return y; }
  pipeline pa_lease(b: Bumped) -> CommitCall { call x = pbm(b); call y = pod_lease(x); return y; }
  pipeline pa_bump(c: Claimed) -> BumpCall { call x = pcl(c); call y = pod_bump(x); return y; }
  pipeline pb_claim(r: InUse) -> BackfillCall { call x = pu(r); call y = backfill(x); return y; }
  pipeline pb_pool(r: BackfillReply) -> ReadyCall { call x = pb(r); call y = pod_pool(x); return y; }
  pipeline pb_ready(p: PoolReply) -> ReadyCall { call x = pp(p); call y = pod_ready(x); return y; }
  entry pa_cur = pa_cur;
  entry pa_claim = pa_claim;
  entry pa_lease = pa_lease;
  entry pa_bump = pa_bump;
  entry pb_claim = pb_claim;
  entry pb_pool = pb_pool;
  entry pb_ready = pb_ready;
  provenance revision "ipam-claims" toolchain "chronicle-authoring";
}
