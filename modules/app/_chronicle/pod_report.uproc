// A Pod's status as its node reports it: the kubelet's status manager as
// params. The lifecycle chain (pod_lifecycle.uproc) decides what the
// sandbox does; this decides what the Pod's status SAYS — Kubernetes'
// phase, its container's state and last state, its readiness, and the
// moments each of them changed — and reports it under /podstatus/<uid>, a
// prefix the node does not scope, where the plane's status chain
// (pod_status.uproc) writes it onto the Pod object.
//
//   /pod-lifecycle-status/<uid>  phase restarts    (the lifecycle's verdict)
//   /pod-specs/<uid>             pod rp_cmd graph  (its name, whether it
//                                                   declares a readiness probe,
//                                                   whether it is graph-backed)
//   /sandbox-status/<uid>        state code        (what the runtime says;
//                                started           `started`: the moment it
//                                                  started this run's process,
//                                                  on every status of the run —
//                                                  a new value is a new run)
//   /probe-status/<uid>          ready             (the readiness probe)
//   /pod-resolved/<uid>          digest            (the image it runs: imageID)
//   /pod-wait/<uid>              why msg           (its pull is failing:
//                                                   pod_image.uproc)
//   /pod-cond/<uid>              this chain's own memory, below
//
// ONE decision over the record (pl_ssrc -> pl_srep, a store_effect at `/`),
// in two halves — a pass writes one or the other, never both:
//
//   memory  the moments, recorded ONCE each, on the edge that makes them,
//           into /pod-cond/<uid> by MERGE: t0 (the node first saw the Pod:
//           its startTime, and when it was scheduled and initialized),
//           tr/rs (the container's start: the runtime's `started` of the
//           run, rs as the run it names, tr as its moment), tf/code/why (its
//           termination), trdy/rdy (the
//           Ready condition's last transition and the verdict it went to),
//           and ltr/ltf/lcode/lwhy (the PREVIOUS run's termination:
//           lastState). One edge per pass, and an edge's write is what wakes
//           the next pass, so a Pod settles in a few steps. A run's start is
//           the runtime's, never inferred from a pass having seen it running:
//           a container that ends before any pass sees it run still reports
//           when it started, as a terminated state always does.
//   report  once no edge is left: PUT /podstatus/<uid> — put-if-changed, so
//           a Pod whose status did not move spends no revision, on the node
//           or on the plane. A Pod deleted (its spec names no Pod) has its
//           report removed.
//
// A moment is the connector's (store_effect `wall = 2`, _shared/moment.rs):
// Unix ms when the node's clock is trusted, else `m<monotonic ms>@<boot>` —
// never a 1970 stamp from a board whose clock SNTP has not set yet. The
// source reads each back as wall-clock time (`!wall`: empty until the clock
// is trusted, and for another boot's), the report says that, and the plane
// renders an empty moment as JSON null — absent, never wrong. Once trusted,
// the memory is rewritten as wall-clock time, so it outlives the boot.
//
// What the report says, by the lifecycle's phase:
//
//   Running/Paused   phase Running, the container running since tr; ready
//                    when the readiness probe passes (or none is declared:
//                    then running is ready)
//   Succeeded/Failed the container terminated (code, why, tr..tf)
//   Restarting       waiting — CrashLoopBackOff (the restart backoff; its
//                    last state the termination that caused it),
//                    CreateContainerError (the runtime refused the CREATE: a
//                    negative code, e.g. -22 for an over-long field),
//                    CorruptImageLayer (a graph-backed Pod whose cached layer
//                    is missing, short or not its digest: -2, -5, -74, -13),
//                    or the pull's reason while its image is fetched again;
//                    phase Running once it has run, Pending before
//   Pending          waiting — ErrImagePull / ImagePullBackOff while its pull
//                    fails (/pod-wait/), CreateContainerConfigError when the
//                    node refused it (/sandbox-status/ `refused`, why),
//                    ContainerCreating otherwise
//   Terminating      the container as it is; never ready (a Pod being
//                    deleted leaves its Service's endpoints)
//
// A graph-backed Pod has no exec seam, so its spec carries no readiness
// probe (pod_specs.uproc) and its readiness follows running.
module nanocloud.podreport {

  enum NOOP = 0;
  enum PUT = 3;
  enum DELETE = 4;
  enum MERGE = 6;

  // pl_ssrc: /pod-lifecycle-status/<uid>, flat, with every other plane of
  // the same uid `related` (blocks of ten from 70; the memory three times:
  // its fields, its last state, its moments as wall-clock time).
  message pr.Rec {
    seq: int = 1;
    key: string = 3;        // the uid
    phase: string = 4;      // the lifecycle's phase
    rst: string = 5;        // restarts ("" while none)
    now: string = 62;       // the moment now (store_effect `wall = 2`)
    pod: string = 70;       // /pod-specs/: "<ns>/<name>" ("" once deleted)
    rp: string = 71;        //   rp_cmd: a readiness probe is declared
    graph: string = 72;     //   graph: a graph-backed Pod
    state: string = 80;     // /sandbox-status/
    scode: string = 81;
    sst: string = 82;       //   started: the run's start, as the runtime stamped it
    t0: string = 90;        // /pod-cond/ (this chain's memory), as recorded
    tr: string = 91;
    rs: string = 92;
    tf: string = 93;
    code: string = 94;
    why: string = 95;
    trdy: string = 96;
    rdy: string = 97;
    ltr: string = 98;
    ltf: string = 99;
    lcode: string = 100;    // /pod-cond/ again
    lwhy: string = 101;
    pready: string = 110;   // /probe-status/ ready
    digest: string = 120;   // /pod-resolved/
    wwhy: string = 130;     // /pod-wait/
    wmsg: string = 131;
    t0w: string = 140;      // /pod-cond/ moments `!wall`: Unix ms, or empty
    trw: string = 141;
    tfw: string = 142;
    trdyw: string = 143;
    ltrw: string = 144;
    ltfw: string = 145;
  }
  // A memory MERGE or the report's PUT, under the effect's `/`.
  message pr.St {
    cid: int = 1;
    op: int = 2;
    key: string = 3;
    k2: string = 17;
    v1: string = 4;  v2: string = 5;  v3: string = 6;  v4: string = 7;
    v5: string = 8;  v6: int = 9;  v7: string = 10;  v8: string = 11;
    v9: string = 12;  v10: string = 13;  v11: string = 14;  v12: string = 15;
    v13: string = 16;  v14: string = 80;  v15: string = 81;  v16: string = 82;
    v17: string = 83;  v18: string = 84;  v19: string = 85;  v20: string = 86;
    v21: string = 87;  v22: string = 88;  v23: string = 89;  v24: string = 90;
    v25: string = 91;  v26: string = 92;  v27: string = 93;  v28: string = 94;
  }

  // Every report arm writes the same fields, in the same order:
  //   phase pod rst ready started cr crr st why msg code tr tf
  //   lcode lwhy ltr ltf t0 trdy digest
  // (`cr`/`crr`: the Ready and ContainersReady conditions' status and,
  // when False, their reason; `tr`/`tf`/`code`/`why` the container's state,
  // `l*` its last state.) Values ride as their own parts, joined by the
  // connector — not concatenated here, where every `+` copies into the
  // decision's 512-byte scratch.
  decision status(r: pr.Rec) -> pr.St {
    // A Pod gone from the plane (its spec names no Pod: the tomb's) has no
    // report left to write — once its container's end is recorded below,
    // which the node's teardown waits on.
    when r.phase == "Terminating" && r.pod == ""
         && !((r.state == "exited" || r.state == "failed" || r.state == "killed") && r.tf == "") ->
      pr.St { cid: r.seq, op: DELETE, key: "podstatus/", k2: r.key };
    // First sight: when the node took the Pod on; not ready.
    when r.t0 == "" && r.pod != "" ->
      pr.St { cid: r.seq, op: MERGE, key: "pod-cond/", k2: r.key,
               v14: "t0=", v15: r.now, v16: ";rdy=0;trdy=", v17: r.now };
    // Moments stamped before the clock was trusted (`m<mono>@<boot>`), now
    // readable as wall-clock time (`!wall`): written back as it, so they
    // outlive this boot. One of another boot reads empty and stays as it is.
    when (r.t0.startsWith("m") || r.tr.startsWith("m") || r.tf.startsWith("m") || r.trdy.startsWith("m") || r.ltr.startsWith("m") || r.ltf.startsWith("m")) && (!r.t0.startsWith("m") || r.t0w != "") && (!r.tr.startsWith("m") || r.trw != "") && (!r.tf.startsWith("m") || r.tfw != "") && (!r.trdy.startsWith("m") || r.trdyw != "") && (!r.ltr.startsWith("m") || r.ltrw != "") && (!r.ltf.startsWith("m") || r.ltfw != "") ->
      pr.St { cid: r.seq, op: MERGE, key: "pod-cond/", k2: r.key,
               v14: "t0=", v15: r.t0w, v16: ";tr=", v17: r.trw,
               v18: ";tf=", v19: r.tfw, v20: ";trdy=", v21: r.trdyw,
               v22: ";ltr=", v23: r.ltrw, v24: ";ltf=", v25: r.ltfw };
    // A new run (the runtime started the process again: the start every
    // status of a run carries is not the run recorded), recorded before
    // anything else of it — whichever of its states a pass saw, its exit
    // included, so its termination is its own and has its start. The run
    // before becomes the last state — unless it was a refusal, which ran
    // nothing.
    when r.sst != "" && r.sst != r.rs && r.tf != "" && !r.code.startsWith("-") ->
      pr.St { cid: r.seq, op: MERGE, key: "pod-cond/", k2: r.key,
               v14: "ltr=", v15: r.tr, v16: ";ltf=", v17: r.tf,
               v18: ";lcode=", v19: r.code, v20: ";lwhy=", v21: r.why,
               v22: ";tf=;code=;why=;rs=", v23: r.sst, v24: ";tr=", v25: r.sst };
    when r.sst != "" && r.sst != r.rs ->
      pr.St { cid: r.seq, op: MERGE, key: "pod-cond/", k2: r.key,
               v14: "tf=;code=;why=;rs=", v15: r.sst, v16: ";tr=", v17: r.sst };
    // A termination, once per run: its moment, its exit code and reason. A
    // signal is 128 + its number, as a container runtime reports it.
    when (r.state == "exited" || r.state == "failed" || r.state == "killed") && r.tf == "" && r.phase != "Running" && r.phase != "Paused" && r.state == "exited" ->
      pr.St { cid: r.seq, op: MERGE, key: "pod-cond/", k2: r.key,
               v14: "why=Completed;code=" + r.scode + ";tf=", v15: r.now };
    when (r.state == "exited" || r.state == "failed" || r.state == "killed") && r.tf == "" && r.phase != "Running" && r.phase != "Paused" && r.state == "killed" ->
      pr.St { cid: r.seq, op: MERGE, key: "pod-cond/", k2: r.key,
               v1: "why=Error;code=", v6: 128 + int(r.scode), v7: ";tf=", v8: r.now };
    // A refusal (a negative errno) ran nothing; its start is its end, so a
    // terminated state always has both.
    when (r.state == "exited" || r.state == "failed" || r.state == "killed") && r.tf == "" && r.phase != "Running" && r.phase != "Paused" && r.state == "failed" && r.scode.startsWith("-") && r.tr == "" ->
      pr.St { cid: r.seq, op: MERGE, key: "pod-cond/", k2: r.key,
               v14: "why=StartError;code=" + r.scode + ";tr=", v15: r.now, v16: ";tf=", v17: r.now };
    when (r.state == "exited" || r.state == "failed" || r.state == "killed") && r.tf == "" && r.phase != "Running" && r.phase != "Paused" && r.state == "failed" && r.scode.startsWith("-") ->
      pr.St { cid: r.seq, op: MERGE, key: "pod-cond/", k2: r.key,
               v14: "why=StartError;code=" + r.scode + ";tf=", v15: r.now };
    when (r.state == "exited" || r.state == "failed" || r.state == "killed") && r.tf == "" && r.phase != "Running" && r.phase != "Paused" && r.state == "failed" ->
      pr.St { cid: r.seq, op: MERGE, key: "pod-cond/", k2: r.key,
               v14: "why=Error;code=" + r.scode + ";tf=", v15: r.now };
    // The Ready condition's transitions.
    when (r.phase == "Running" || r.phase == "Paused") && (r.rp == "" || r.pready == "1") && r.rdy != "1" ->
      pr.St { cid: r.seq, op: MERGE, key: "pod-cond/", k2: r.key,
               v14: "rdy=1;trdy=", v15: r.now };
    when !((r.phase == "Running" || r.phase == "Paused") && (r.rp == "" || r.pready == "1")) && r.rdy != "0" && r.pod != "" ->
      pr.St { cid: r.seq, op: MERGE, key: "pod-cond/", k2: r.key,
               v14: "rdy=0;trdy=", v15: r.now };
    // Settled from here on: the report.
    when r.pod == "" || r.t0 == "" ->
      pr.St { cid: r.seq, op: NOOP, key: "" };
    // Running.
    when (r.phase == "Running" || r.phase == "Paused") && r.rdy == "1" ->
      pr.St { cid: r.seq, op: PUT, key: "podstatus/", k2: r.key,
               v1: "phase=", v2: "Running", v3: ";pod=", v4: r.pod,
               v5: ";rst=", v6: int("0" + r.rst), v7: ";ready=true;started=true;cr=True;crr=;st=running;why=;msg=;code=;tr=", v8: r.trw,
               v9: ";tf=;lcode=", v10: r.lcode, v11: ";lwhy=", v12: r.lwhy,
               v13: ";ltr=", v14: r.ltrw, v15: ";ltf=", v16: r.ltfw,
               v17: ";t0=", v18: r.t0w, v19: ";trdy=", v20: r.trdyw,
               v21: ";digest=", v22: r.digest };
    when (r.phase == "Running" || r.phase == "Paused") ->
      pr.St { cid: r.seq, op: PUT, key: "podstatus/", k2: r.key,
               v1: "phase=", v2: "Running", v3: ";pod=", v4: r.pod,
               v5: ";rst=", v6: int("0" + r.rst), v7: ";ready=false;started=true;cr=False;crr=ContainersNotReady;st=running;why=;msg=;code=;tr=", v8: r.trw,
               v9: ";tf=;lcode=", v10: r.lcode, v11: ";lwhy=", v12: r.lwhy,
               v13: ";ltr=", v14: r.ltrw, v15: ";ltf=", v16: r.ltfw,
               v17: ";t0=", v18: r.t0w, v19: ";trdy=", v20: r.trdyw,
               v21: ";digest=", v22: r.digest };
    // Being deleted, still running: never ready.
    when r.phase == "Terminating" && r.state == "running" ->
      pr.St { cid: r.seq, op: PUT, key: "podstatus/", k2: r.key,
               v1: "phase=", v2: "Running", v3: ";pod=", v4: r.pod,
               v5: ";rst=", v6: int("0" + r.rst), v7: ";ready=false;started=true;cr=False;crr=ContainersNotReady;st=running;why=;msg=;code=;tr=", v8: r.trw,
               v9: ";tf=;lcode=", v10: r.lcode, v11: ";lwhy=", v12: r.lwhy,
               v13: ";ltr=", v14: r.ltrw, v15: ";ltf=", v16: r.ltfw,
               v17: ";t0=", v18: r.t0w, v19: ";trdy=", v20: r.trdyw,
               v21: ";digest=", v22: r.digest };
    // Terminal: the container's termination is its state.
    when (r.phase == "Succeeded" || r.phase == "Failed") && r.tf != "" ->
      pr.St { cid: r.seq, op: PUT, key: "podstatus/", k2: r.key,
               v1: "phase=", v2: r.phase, v3: ";pod=", v4: r.pod,
               v5: ";rst=", v6: int("0" + r.rst), v7: ";ready=false;started=false;cr=False;crr=PodCompleted;st=terminated;why=", v8: r.why,
               v9: ";msg=;code=", v10: r.code, v11: ";tr=", v12: r.trw,
               v13: ";tf=", v14: r.tfw, v15: ";lcode=", v16: r.lcode,
               v17: ";lwhy=", v18: r.lwhy, v19: ";ltr=", v20: r.ltrw,
               v21: ";ltf=", v22: r.ltfw, v23: ";t0=", v24: r.t0w,
               v25: ";trdy=", v26: r.trdyw, v27: ";digest=", v28: r.digest };
    // Waiting on its image (the pull failing, a graph-backed Pod's image
    // fetched again after a bad layer): phase Running once it has run.
    when r.wwhy != "" && (r.phase == "Restarting" || r.phase == "Pending") && (r.ltr != "" || r.rs != "") ->
      pr.St { cid: r.seq, op: PUT, key: "podstatus/", k2: r.key,
               v1: "phase=", v2: "Running", v3: ";pod=", v4: r.pod,
               v5: ";rst=", v6: int("0" + r.rst), v7: ";ready=false;started=false;cr=False;crr=ContainersNotReady;st=waiting;why=", v8: r.wwhy,
               v9: ";msg=", v10: r.wmsg, v11: ";code=;tr=;tf=;lcode=", v12: r.lcode,
               v13: ";lwhy=", v14: r.lwhy, v15: ";ltr=", v16: r.ltrw,
               v17: ";ltf=", v18: r.ltfw, v19: ";t0=", v20: r.t0w,
               v21: ";trdy=", v22: r.trdyw, v23: ";digest=", v24: r.digest };
    when r.wwhy != "" && (r.phase == "Restarting" || r.phase == "Pending") ->
      pr.St { cid: r.seq, op: PUT, key: "podstatus/", k2: r.key,
               v1: "phase=", v2: "Pending", v3: ";pod=", v4: r.pod,
               v5: ";rst=", v6: int("0" + r.rst), v7: ";ready=false;started=false;cr=False;crr=ContainersNotReady;st=waiting;why=", v8: r.wwhy,
               v9: ";msg=", v10: r.wmsg, v11: ";code=;tr=;tf=;lcode=", v12: r.lcode,
               v13: ";lwhy=", v14: r.lwhy, v15: ";ltr=", v16: r.ltrw,
               v17: ";ltf=", v18: r.ltfw, v19: ";t0=", v20: r.t0w,
               v21: ";trdy=", v22: r.trdyw, v23: ";digest=", v24: r.digest };
    // A graph-backed Pod's cached layer is missing (-2), short (-5), not its
    // digest (-74) or not the one its pin names (-13).
    when r.phase == "Restarting" && r.graph != "" && (r.code == "-2" || r.code == "-5" || r.code == "-74" || r.code == "-13") && (r.ltr != "" || r.rs != "") ->
      pr.St { cid: r.seq, op: PUT, key: "podstatus/", k2: r.key,
               v1: "phase=", v2: "Running", v3: ";pod=", v4: r.pod,
               v5: ";rst=", v6: int("0" + r.rst), v7: ";ready=false;started=false;cr=False;crr=ContainersNotReady;st=waiting;why=CorruptImageLayer;msg=a cached image layer is missing, short or not its digest and is fetched again;code=;tr=;tf=;lcode=", v8: r.lcode,
               v9: ";lwhy=", v10: r.lwhy, v11: ";ltr=", v12: r.ltrw,
               v13: ";ltf=", v14: r.ltfw, v15: ";t0=", v16: r.t0w,
               v17: ";trdy=", v18: r.trdyw, v19: ";digest=", v20: r.digest };
    when r.phase == "Restarting" && r.graph != "" && (r.code == "-2" || r.code == "-5" || r.code == "-74" || r.code == "-13") ->
      pr.St { cid: r.seq, op: PUT, key: "podstatus/", k2: r.key,
               v1: "phase=", v2: "Pending", v3: ";pod=", v4: r.pod,
               v5: ";rst=", v6: int("0" + r.rst), v7: ";ready=false;started=false;cr=False;crr=ContainersNotReady;st=waiting;why=CorruptImageLayer;msg=a cached image layer is missing, short or not its digest and is fetched again;code=;tr=;tf=;lcode=", v8: r.lcode,
               v9: ";lwhy=", v10: r.lwhy, v11: ";ltr=", v12: r.ltrw,
               v13: ";ltf=", v14: r.ltfw, v15: ";t0=", v16: r.t0w,
               v17: ";trdy=", v18: r.trdyw, v19: ";digest=", v20: r.digest };
    // The runtime refused the CREATE (a negative errno: -22 for a field past
    // its record, the `%00` overflow).
    when r.phase == "Restarting" && r.code.startsWith("-") && (r.ltr != "" || r.rs != "") ->
      pr.St { cid: r.seq, op: PUT, key: "podstatus/", k2: r.key,
               v1: "phase=", v2: "Running", v3: ";pod=", v4: r.pod,
               v5: ";rst=", v6: int("0" + r.rst), v7: ";ready=false;started=false;cr=False;crr=ContainersNotReady;st=waiting;why=CreateContainerError;msg=the runtime refused to create the container (error ", v8: r.code,
               v9: ");code=;tr=;tf=;lcode=", v10: r.lcode, v11: ";lwhy=", v12: r.lwhy,
               v13: ";ltr=", v14: r.ltrw, v15: ";ltf=", v16: r.ltfw,
               v17: ";t0=", v18: r.t0w, v19: ";trdy=", v20: r.trdyw,
               v21: ";digest=", v22: r.digest };
    when r.phase == "Restarting" && r.code.startsWith("-") ->
      pr.St { cid: r.seq, op: PUT, key: "podstatus/", k2: r.key,
               v1: "phase=", v2: "Pending", v3: ";pod=", v4: r.pod,
               v5: ";rst=", v6: int("0" + r.rst), v7: ";ready=false;started=false;cr=False;crr=ContainersNotReady;st=waiting;why=CreateContainerError;msg=the runtime refused to create the container (error ", v8: r.code,
               v9: ");code=;tr=;tf=;lcode=", v10: r.lcode, v11: ";lwhy=", v12: r.lwhy,
               v13: ";ltr=", v14: r.ltrw, v15: ";ltf=", v16: r.ltfw,
               v17: ";t0=", v18: r.t0w, v19: ";trdy=", v20: r.trdyw,
               v21: ";digest=", v22: r.digest };
    // The restart backoff: its last state is the termination that caused it.
    when r.phase == "Restarting" && r.tf != "" ->
      pr.St { cid: r.seq, op: PUT, key: "podstatus/", k2: r.key,
               v1: "phase=", v2: "Running", v3: ";pod=", v4: r.pod,
               v5: ";rst=", v6: int("0" + r.rst), v7: ";ready=false;started=false;cr=False;crr=ContainersNotReady;st=waiting;why=CrashLoopBackOff;msg=back-off restarting failed container;code=;tr=;tf=;lcode=", v8: r.code,
               v9: ";lwhy=", v10: r.why, v11: ";ltr=", v12: r.trw,
               v13: ";ltf=", v14: r.tfw, v15: ";t0=", v16: r.t0w,
               v17: ";trdy=", v18: r.trdyw, v19: ";digest=", v20: r.digest };
    // Being deleted, its container already ended.
    when r.phase == "Terminating" && r.tf != "" ->
      pr.St { cid: r.seq, op: PUT, key: "podstatus/", k2: r.key,
               v1: "phase=", v2: "Running", v3: ";pod=", v4: r.pod,
               v5: ";rst=", v6: int("0" + r.rst), v7: ";ready=false;started=false;cr=False;crr=ContainersNotReady;st=terminated;why=", v8: r.why,
               v9: ";msg=;code=", v10: r.code, v11: ";tr=", v12: r.trw,
               v13: ";tf=", v14: r.tfw, v15: ";lcode=", v16: r.lcode,
               v17: ";lwhy=", v18: r.lwhy, v19: ";ltr=", v20: r.ltrw,
               v21: ";ltf=", v22: r.ltfw, v23: ";t0=", v24: r.t0w,
               v25: ";trdy=", v26: r.trdyw, v27: ";digest=", v28: r.digest };
    // Not created, as upstream's kubelet would not create it
    // (CreateContainerConfigError: a missing ConfigMap or Secret, a
    // securityContext the node cannot give, runAsNonRoot and a root user):
    // the reason is the sandbox's refusal (pod_project.uproc).
    when r.state == "refused" && (r.phase == "Pending" || r.phase == "Restarting") ->
      pr.St { cid: r.seq, op: PUT, key: "podstatus/", k2: r.key,
               v1: "phase=", v2: "Pending", v3: ";pod=", v4: r.pod,
               v5: ";rst=", v6: int("0" + r.rst), v7: ";ready=false;started=false;cr=False;crr=ContainersNotReady;st=waiting;why=CreateContainerConfigError;msg=", v8: r.scode,
               v9: ";code=;tr=;tf=;lcode=", v10: r.lcode, v11: ";lwhy=", v12: r.lwhy,
               v13: ";ltr=", v14: r.ltrw, v15: ";ltf=", v16: r.ltfw,
               v17: ";t0=", v18: r.t0w, v19: ";trdy=", v20: r.trdyw,
               v21: ";digest=", v22: r.digest };
    // Failed before it ran: an init container failed for good
    // (pod_lifecycle.uproc), and this container never starts.
    when r.phase == "Failed" && r.tf == "" ->
      pr.St { cid: r.seq, op: PUT, key: "podstatus/", k2: r.key,
               v1: "phase=", v2: "Failed", v3: ";pod=", v4: r.pod,
               v5: ";rst=", v6: int("0" + r.rst), v7: ";ready=false;started=false;cr=False;crr=PodCompleted;st=waiting;why=PodInitializing;msg=;code=;tr=;tf=;lcode=", v8: r.lcode,
               v9: ";lwhy=", v10: r.lwhy, v11: ";ltr=", v12: r.ltrw,
               v13: ";ltf=", v14: r.ltfw, v15: ";t0=", v16: r.t0w,
               v17: ";trdy=", v18: r.trdyw, v19: ";digest=", v20: r.digest };
    // Pending: its container is being created.
    default ->
      pr.St { cid: r.seq, op: PUT, key: "podstatus/", k2: r.key,
               v1: "phase=", v2: "Pending", v3: ";pod=", v4: r.pod,
               v5: ";rst=", v6: int("0" + r.rst), v7: ";ready=false;started=false;cr=False;crr=ContainersNotReady;st=waiting;why=ContainerCreating;msg=;code=;tr=;tf=;lcode=", v8: r.lcode,
               v9: ";lwhy=", v10: r.lwhy, v11: ";ltr=", v12: r.ltrw,
               v13: ";ltf=", v14: r.ltfw, v15: ";t0=", v16: r.t0w,
               v17: ";trdy=", v18: r.trdyw, v19: ";digest=", v20: r.digest };
  }

  pipeline st(r: pr.Rec) -> pr.St { call x = status(r); return x; }
  entry st = st;
  provenance revision "podreport-status" toolchain "chronicle-authoring";
}
