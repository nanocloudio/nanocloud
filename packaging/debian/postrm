#!/bin/sh

set -e

if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload || true
fi

case "$1" in
    purge)
        rm -f /etc/default/nanocloud
        # Generated at postinst (bundle emit) / runtime (store, state).
        rm -rf /usr/lib/nanocloud/fluxor/target/fluxor \
               /var/lib/nanocloud.io/fluxor
    ;;
esac

exit 0
