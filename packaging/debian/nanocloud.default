# Overrides for the Nanocloud systemd service.
#
# The control plane is a fluxor graph (see nanocloud.service). There is no host
# server process and no `--*-mode` flags — the graph IS the control plane.

# FLUXOR_STORE_DIR is deliberately NOT set (nanocloud.service): with it,
# fluxor brings up a host store of its own beside the graph's lattice store,
# and a lattice store that could not start would be replaced by it silently.
# The graph's store lives in the unit's WorkingDirectory.

# The packaged fluxor project root — where `fluxor run` resolves the runtime and
# the .fmod modules the control-plane graph references.
FLUXOR_PROJECT_ROOT=/usr/lib/nanocloud/fluxor

# The OCI store dataplane bundles (dns/edge/sandbox/…) are published into for the
# node to run them as fluxor workloads.
NANOCLOUD_FLUXOR_STORE=/var/lib/nanocloud.io/fluxor/ocistore
