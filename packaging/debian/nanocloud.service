[Unit]
Description=Nanocloud node: the control plane or a worker (fluxor graph)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/default/nanocloud
# FLUXOR_SEAL_KEY, generated once by postinst: the key the vault seals its keys
# (the `nanocloud.ca` signing root among them) under, so they survive a restart.
EnvironmentFile=-/etc/nanocloud.io/seal.env
# The node is a fluxor graph: the API (http + tls in front of the API plane's
# Chronicle pipelines — authentication, RBAC, admission, the object store —
# packaging/debian/fluxor-controlplane.yaml), every controller as params, the
# replicated store, and, where the node runs Pods, the kubelet's chains, its
# image pull and its sandbox runtime. There is no host binary. `fluxor run`
# resolves the graph's modules from the project root (FLUXOR_PROJECT_ROOT).
#
# The graph is this node's, rendered at each start from its template by role
# (/etc/nanocloud.io/cluster.env: the control plane, a voter of the
# replicated store, or a worker, a learner of it) with this node's values and
# peer PKI (/etc/nanocloud.io/pki). See nanocloud-graph.sh.
#
# The store is lattice's (the graph's `kv_state_worker_store`), and it lives in
# the state directory the graph runs in: `lattice/` holds it, and `store.log` —
# the host store's log, which a node upgraded from it still has — is imported
# into it once, through the group's log, then kept as the record of what was
# imported. FLUXOR_STORE_DIR
# is NOT set: with it, fluxor would bring up its own host store beside the
# graph's, and a lattice store that could not start would be replaced by it
# silently. The vault keeps its sealed keys where they always were.
WorkingDirectory=/var/lib/nanocloud.io/control-plane/store
Environment=FLUXOR_PROJECT_ROOT=/usr/lib/nanocloud/fluxor
Environment=FLUXOR_VAULT_DIR=/var/lib/nanocloud.io/control-plane/store/vault
# Each Pod's own storage (its files and its store), rooted by its identity:
# kept across restarts, removed only when its workload is destroyed.
Environment=FLUXOR_OWNER_ROOT=/var/lib/nanocloud.io/owners
# Each Pod's volumes (emptyDir, Secret, ConfigMap, projected, downward API),
# one directory per Pod under the platform's mount root, bound into its
# containers by the runtime and removed once the Pod is gone. Under the
# node's own state, not the platform's default. Its modes are set by
# `host_mount` (an emptyDir without fsGroup is 0777 exactly); no tool is
# spawned, so the node grants no process allow-list.
Environment=FLUXOR_MOUNT_ROOT=/var/lib/nanocloud.io/mounts
# The store holds Secrets, minted tokens and (under vault/) the sealed keys,
# and the store writes its files 0644: the DIRECTORY is what keeps them from
# every other local user, so it is 0700 on every start — an upgrade from a
# 0755 store is closed too. Not a service-wide UMask: pod processes inherit
# the service's umask, and a container's files are not ours to restrict.
ExecStartPre=/usr/bin/install -d -m 0700 /var/lib/nanocloud.io/control-plane/store
ExecStartPre=/bin/chmod 0700 /var/lib/nanocloud.io/control-plane/store
ExecStartPre=/usr/bin/install -d -m 0700 /var/lib/nanocloud.io/control-plane/store/lattice
ExecStartPre=/usr/bin/install -d -m 0700 /var/lib/nanocloud.io/owners
ExecStartPre=/usr/bin/install -d -m 0700 /var/lib/nanocloud.io/mounts
RuntimeDirectory=nanocloud
RuntimeDirectoryMode=0700
# The runtime's instance state (FLUXOR_STATE_DIR): it holds the instance lock
# for the runtime's life, and the instance tag every host object the node
# makes (links, routes, packet-policy tables, held addresses, tunables) is
# named by is a digest of this path, so it is stable across restarts and a
# restart's boot reclaim finds its previous life's objects. Distinct from the
# store directory above.
StateDirectory=nanocloud.io/instance
StateDirectoryMode=0700
Environment=FLUXOR_STATE_DIR=/var/lib/nanocloud.io/instance
ExecStartPre=/usr/lib/nanocloud/nanocloud-graph.sh /etc/nanocloud.io/fluxor /run/nanocloud/graph.yaml
ExecStart=/usr/bin/fluxor run /run/nanocloud/graph.yaml
# Once the runtime is gone, collect what its instance left on the host. `+`
# runs it with full privileges: without root a packet-policy table cannot be
# removed and the reclaim stays pending. It exits 0 when the instance was
# reclaimed (or held nothing), 2 when the instance is still live in another
# runtime, and 1 on an error or a reclaim left pending (the log says which);
# `-` keeps any of them from failing the unit, which has already stopped.
ExecStopPost=-+/usr/bin/fluxor-linux reclaim
StandardOutput=append:/var/log/nanocloud.log
StandardError=append:/var/log/nanocloud.log
Restart=on-failure
RestartSec=5
LimitNOFILE=1048576
KillMode=control-group
Delegate=yes

[Install]
WantedBy=multi-user.target
